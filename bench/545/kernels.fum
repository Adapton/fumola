func count(n) { if (n == 0) { 0 } else { count(n - 1) } };
func fib(n) { if (n < 2) { n } else { fib(n - 1) + fib(n - 2) } };
func build(n, acc) { if (n == 0) { acc } else { build(n - 1, ?(n, acc)) } };
func sum(l) { switch (l) { case null { 0 }; case (?(x, t)) { x + sum(t) } } };
func map(f, l) { switch (l) { case null { null }; case (?(x, t)) { ?(f(x), map(f, t)) } } };
func len(l) { switch (l) { case null { 0 }; case (?(_, t)) { 1 + len(t) } } };
func sumbuild(n) { sum(build(n, null)) };
func mapinc(n) { len(map(func (x) { x + 1 }, build(n, null))) };
func skip(l) { 0 };
func k_id(k) { k };
