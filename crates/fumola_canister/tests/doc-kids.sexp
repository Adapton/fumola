(CodePersist((editor(((editor((root Exp)(zipper((zipper"")(backup_text"# Emotion (Kids' Choice) #\n\n# Emotion's face, with more to it: drag the MOUTH to smile or frown #\n# and the BROW, a unibrow, to worry or glower, both on the face #\n# itself -- or move the face's own smile and brow sliders, which the #\n# drag moves too. The face's third slider, sickness, makes it sick: #\n# green and yellow drips out of the mouth, then a pile below the face; #\n# at 100 the pile is a giant heap with an unhappy face of its own, and #\n# the drawing grows to make room only while sickness is above 0. #\n# More controls live OUTSIDE the face, as sliders and toggles: #\n\n#   head color   a color picker, with four presets: angry (red), sick #\n#                (green), alien (silver) and yellow (an ordinary face, #\n#                dark enough for star eyes to show). The face reads #\n#                as the preset its color is nearest #\n#   explode      how far the top of the head has blown off #\n#   candy        how much candy comes out -- but only as far as the #\n#                head is exploded, like a pinata #\n#   star eyes,   two toggles, for stars or hearts in the eyes, or #\n#   heart eyes   both: hearts with a star on #\n#   x eyes       a toggle for X eyes, like someone sick; it wins over #\n#                stars and hearts #\n#   unibrow      a toggle: on, one brow across both eyes; off, a brow #\n#                over each eye #\n#   eye size     how big the eyes are #\n#   side lines   lines out of both sides of the face, longer, #\n#                thicker and darker as the slider goes up #\n#   head rays    rays out of the open head, as long as the head is #\n#                open lets them be #\n#   teeth        up to five pointed teeth along the mouth, #\n#                alternately up and down #\n#   mouth open   closed is a line; open, a flat mouth is an oval, #\n#                and a smile or a frown a half-oval, flat on top #\n#                for a smile and on the bottom for a frown #\n\n# The sliders are one parameterized livelit, ^slider, given a label, #\n# a range and a track, and abbreviated once per slider (Parameters); #\n# the toggles are another, ^toggle, given a label. The #\n# face takes each slider's value in a splice of its own, a cell whose #\n# code is the client's (Editable Parameters): here, the name of the #\n# slider's variable. Move a slider, and the face follows. #\n\n# The face's state -- smile, brow, and a drag in progress -- is its #\n# model. Held is a drag: which feature, where it started, and the #\n# pointer's y when it did. #\ntype Feature = + Mouth + Brow in\ntype Drag = + Idle + Held(Feature, Int, Int) in\n\n# SLIDERS #\n\nlet ^slider = fun (label, lo, hi, track) : (String, Int, Int, String) -> {\ntype Model = Int;\ntype Action = Int;\ntype Expansion = Int;\n\nlet init = Pure((lo + hi) / 2);\n\nlet update = fun _m : Model -> fun a : Action -> Pure(a);\n\nlet view = fun m : Model -> Pure(\nHtml.div(\n[Attr.style([(\"display\", \"flex\"), (\"gap\", \"0.5em\"),\n(\"align-items\", \"center\"),\n(\"font-family\", \"var(--code-font)\"),\n(\"font-size\", \"0.8em\")])],\n[Html.span([Attr.style([(\"white-space\", \"nowrap\")])], [Html.text(label)]),\nHtml.input([\nAttr.type_(\"range\"),\nAttr.min(string_of_int(lo)), Attr.max(string_of_int(hi)),\nAttr.value(string_of_int(m)),\nAttr.style([(\"background\", track), (\"border-radius\", \"4px\"), (\"flex\", \"1\"), (\"min-width\", \"0\")]),\nAttr.on_input(fun s -> int_of_string(s))\n]),\nHtml.span([Attr.style([(\"white-space\", \"nowrap\"), (\"min-width\", \"3ch\")])], [Html.text(string_of_int(m))])]));\n\nlet expand = Functional(fun m : Model -> m);\n\nlet shape = Inline(34)\n} in\n\n# HEAD COLOR #\n\n# A color picker: the browser's own, and four presets to click. A #\n# color is one Int, 0xRRGGBB -- red times 65536, plus green times 256, #\n# plus blue -- so the face's cell for it is an Int like the others. #\n# The picker speaks hex text, rrggbb, so the view converts both ways. #\n# The face repeats the presets' colors to tell which one a color is #\n# nearest: a definition is closed, so the two cannot share them. #\nlet ^head_picker = {\ntype Model = Int;\ntype Action = Int;\ntype Expansion = Int;\n\nlet rgb = fun (r, g, b) : (Int, Int, Int) -> r * 65536 + g * 256 + b;\nlet yellow = 13606912;\n\nlet init = Pure(yellow);\n\nlet update = fun _m : Model -> fun a : Action -> Pure(a);\n\nlet digits = \"0123456789abcdef\";\nlet hex2 = fun n : Int ->\nstring_sub((digits, n / 16, 1)) ++ string_sub((digits, int_mod(n, 16), 1));\nlet to_hex = fun c : Int ->\n\"#\" ++ hex2(c / 65536) ++ hex2(int_mod(c / 256, 256)) ++ hex2(int_mod(c, 256));\nlet digit = fun ch : String ->\nlet i = string_search((string_lowercase(ch), digits, 0)) in\nif i < 0 then 0 else i;\nlet byte = fun (s, i) : (String, Int) ->\ndigit(string_sub((s, i, 1))) * 16 + digit(string_sub((s, i + 1, 1)));\nlet of_hex = fun s : String ->\nif string_length(s) == 7\nthen byte((s, 1)) * 65536 + byte((s, 3)) * 256 + byte((s, 5))\nelse yellow;\nlet css = fun c : Int ->\n\"rgb(\" ++ string_of_int(c / 65536) ++ \" \" ++ string_of_int(int_mod(c / 256, 256))\n++ \" \" ++ string_of_int(int_mod(c, 256)) ++ \")\";\n\n# A preset is a button in its own color; the one in use is outlined. #\nlet preset = fun (name, c, ink, m) : (String, Int, String, Int) ->\nHtml.button(\n[Attr.on_click(c),\nAttr.style([(\"background\", css(c)), (\"color\", ink),\n(\"font-family\", \"var(--code-font)\"), (\"font-size\", \"0.8em\"),\n(\"border-radius\", \"4px\"),\n(\"border\", if c == m then \"2px solid black\" else \"1px solid #888\")])],\n[Html.text(name)]);\n\nlet view = fun m : Model -> Pure(\nHtml.div(\n[Attr.style([(\"display\", \"flex\"), (\"gap\", \"0.5em\"),\n(\"align-items\", \"center\"),\n(\"font-family\", \"var(--code-font)\"),\n(\"font-size\", \"0.8em\")])],\n[Html.span([Attr.style([(\"white-space\", \"nowrap\")])], [Html.text(\"head color\")]),\nHtml.input([\nAttr.type_(\"color\"), Attr.value(to_hex(m)),\nAttr.on_input(fun s -> of_hex(s)),\nAttr.style([(\"width\", \"2.5em\"), (\"height\", \"1.6em\"), (\"padding\", \"0\")])]),\npreset((\"angry\", rgb((220, 20, 60)), \"white\", m)),\npreset((\"sick\", rgb((140, 190, 50)), \"black\", m)),\npreset((\"alien\", rgb((170, 178, 186)), \"black\", m)),\npreset((\"yellow\", yellow, \"black\", m))]));\n\nlet expand = Functional(fun m : Model -> m);\n\nlet shape = Inline(52)\n} in\n\nlet ^boom_dial = ^slider(\"explode\", 0, 100, \"none\") in\nlet ^candy_dial = ^slider(\"candy\", 0, 100, \"none\") in\nlet ^eye_dial = ^slider(\"eye size\", 0, 100, \"none\") in\nlet ^side_dial = ^slider(\"side lines\", 0, 100, \"none\") in\nlet ^ray_dial = ^slider(\"head rays\", 0, 100, \"none\") in\nlet ^teeth_dial = ^slider(\"teeth\", 0, 5, \"none\") in\nlet ^open_dial = ^slider(\"mouth open\", 0, 100, \"none\") in\n\n# TOGGLES #\n\n# A button that flips a Bool, showing whether it is on. #\nlet ^toggle = fun label : String -> {\ntype Model = Bool;\ntype Action = Bool;\ntype Expansion = Bool;\n\nlet init = Pure(false);\n\nlet update = fun _m : Model -> fun a : Action -> Pure(a);\n\nlet view = fun m : Model -> Pure(\nHtml.button(\n[Attr.on_click(if m then false else true),\nAttr.style([(\"font-family\", \"var(--code-font)\"),\n(\"font-size\", \"0.8em\")])],\n[Html.text(label ++ (if m then \": on\" else \": off\"))]));\n\nlet expand = Functional(fun m : Model -> m);\n\nlet shape = Inline(20)\n} in\n\nlet ^star_toggle = ^toggle(\"star eyes\") in\nlet ^heart_toggle = ^toggle(\"heart eyes\") in\nlet ^x_toggle = ^toggle(\"x eyes\") in\nlet ^unibrow_toggle = ^toggle(\"unibrow\") in\n\n# THE FACE #\n\nlet ^kid_face = {\ntype Model =\n(smile = Int, brow = Int, drag = Drag,\ncolor = SpliceRef, burst = SpliceRef, candy = SpliceRef,\nstars = SpliceRef, hearts = SpliceRef, eyes = SpliceRef,\nsides = SpliceRef, rays = SpliceRef, teeth = SpliceRef,\nopening = SpliceRef, x_eyes = SpliceRef, sickness = Int,\nunibrow = SpliceRef);\n\n# As in Emotion: Down grabs, MoveTo moves only while held, Up lets #\n# go and commits. Where the grab lands picks the feature: above the #\n# eyes is the brow, below them the mouth. SetSmile and SetBrow come #\n# from the face's own sliders, as does SetSick. Both ways write the same two fields #\n# of the model, so a drag moves the slider and a slide moves the #\n# face. (A slider OUTSIDE the face could not do this: a livelit #\n# writes only its own model.) #\ntype Action =\n+ Down(Int) + MoveTo(Int) + Up + SetSmile(Int) + SetBrow(Int)\n+ SetSick(Int);\n\n# What a use means: how the face reads, as data. #\ntype Expansion =\n(feeling = String, smile = Int, brow = Int, exploded = Int,\ncandy = Int, eyes = String, eye_size = Int, side_lines = Int,\nrays = Int, teeth = Int, mouth_open = Int, sickness = Int,\nunibrow = Bool);\n\nlet init =\ndo c <- new_splice((IntT, Some(IntLit(13606912)))) in\ndo b <- new_splice((IntT, Some(IntLit(0)))) in\ndo k <- new_splice((IntT, Some(IntLit(50)))) in\ndo st <- new_splice((BoolT, Some(BoolLit(false)))) in\ndo ht <- new_splice((BoolT, Some(BoolLit(false)))) in\ndo e <- new_splice((IntT, Some(IntLit(50)))) in\ndo sd <- new_splice((IntT, Some(IntLit(0)))) in\ndo r <- new_splice((IntT, Some(IntLit(0)))) in\ndo t <- new_splice((IntT, Some(IntLit(0)))) in\ndo o <- new_splice((IntT, Some(IntLit(0)))) in\ndo xe <- new_splice((BoolT, Some(BoolLit(false)))) in\ndo ub <- new_splice((BoolT, Some(BoolLit(true)))) in\nPure((smile = 50, brow = 40, drag = Idle, color = c, burst = b,\ncandy = k, stars = st, hearts = ht, eyes = e, sides = sd,\nrays = r, teeth = t, opening = o, x_eyes = xe, sickness = 0,\nunibrow = ub));\n\nlet clamp = fun n : Int -> if n < 0 then 0 else if n > 100 then 100 else n;\n\n# EXPERIMENTAL, not in the paper: the params panel. Open the eye at #\n# the face's left and the pane shows its params above its model. The #\n# params are what the face itself holds -- smile, brow, sickness -- #\n# and not the drag in progress, which is passing state, nor the cells, #\n# which are the client's code. Editing the params re-runs #\n# init_from_params, handed the old model too: it keeps every cell as #\n# it was and starts the drag over, Idle. Making no cells, it is a #\n# plain function, not a command. #\ntype Params = (smile = Int, brow = Int, sickness = Int);\nlet params_from_model = fun m : Model ->\n(smile = m.smile, brow = m.brow, sickness = m.sickness);\nlet init_from_params = fun (p, old) : (Params, Model) ->\n((smile = clamp(p.smile), brow = clamp(p.brow), drag = Idle,\ncolor = old.color, burst = old.burst, candy = old.candy,\nstars = old.stars, hearts = old.hearts, eyes = old.eyes,\nsides = old.sides, rays = old.rays, teeth = old.teeth,\nopening = old.opening, x_eyes = old.x_eyes,\nsickness = clamp(p.sickness), unibrow = old.unibrow));\n\n# The face is drawn 220 pixels wide, in drawing units running 0 to #\n# 200 across, so 11 pixels for every 10 units, and from -80 down: to #\n# 220 while it is well (the room above is for the lid and the candy, #\n# below for the mood's name), to 350 while it is sick, for the pile. #\n# A pointer's y arrives in pixels from the top, so a grab is placed #\n# by converting it, the same at either height. #\nlet width_px = 220;\nlet drawing_h = fun sick : Int -> if sick > 0 then 430 else 300;\nlet drawing_y = fun py : Int -> py * 10 / 11 - 80;\n\nlet update = fun m : Model -> fun a : Action ->\nlet with_drag = fun (smile, brow, drag, sick) : (Int, Int, Drag, Int) ->\n(smile = smile, brow = brow, drag = drag, color = m.color,\nburst = m.burst, candy = m.candy, stars = m.stars,\nhearts = m.hearts, eyes = m.eyes, sides = m.sides,\nrays = m.rays, teeth = m.teeth, opening = m.opening,\nx_eyes = m.x_eyes, sickness = sick, unibrow = m.unibrow) in\nPure(\ncase a\n| Down(y) =>\nif drawing_y(y) < 88 then with_drag((m.smile, m.brow, Held(Brow, m.brow, y), m.sickness))\nelse with_drag((m.smile, m.brow, Held(Mouth, m.smile, y), m.sickness))\n| MoveTo(y) =>\ncase m.drag\n| Idle => m\n| Held(Mouth, v0, y0) =>\nwith_drag((clamp(v0 + 2 * (y - y0)), m.brow, m.drag, m.sickness))\n| Held(Brow, v0, y0) =>\nwith_drag((m.smile, clamp(v0 + 2 * (y - y0)), m.drag, m.sickness))\nend\n| Up => with_drag((m.smile, m.brow, Idle, m.sickness))\n| SetSmile(v) => with_drag((clamp(v), m.brow, Idle, m.sickness))\n| SetBrow(v) => with_drag((m.smile, clamp(v), Idle, m.sickness))\n| SetSick(v) => with_drag((m.smile, m.brow, Idle, clamp(v)))\nend);\n\n# Which preset a head color (0xRRGGBB) is nearest, by the squares of #\n# the channel differences: 0 angry, 1 sick, 2 alien, 3 yellow. The #\n# presets are ^head_picker's, and expand below repeats this, since #\n# its quoted code cannot call it. #\nlet family = fun c : Int ->\nlet r = c / 65536 in\nlet g = int_mod(c / 256, 256) in\nlet b = int_mod(c, 256) in\nlet d = fun (pr, pg, pb) : (Int, Int, Int) ->\n(r - pr) * (r - pr) + (g - pg) * (g - pg) + (b - pb) * (b - pb) in\nlet d0 = d((220, 20, 60)) in\nlet d1 = d((140, 190, 50)) in\nlet d2 = d((170, 178, 186)) in\nlet d3 = d((207, 160, 0)) in\nif d0 <= d1 && d0 <= d2 && d0 <= d3 then 0\nelse if d1 <= d2 && d1 <= d3 then 1\nelse if d2 <= d3 then 2\nelse 3;\n\n# The mood a face reads as: its color's family, whether the brow is #\n# UP (its middle raised, below 50) and whether the mouth is UP (a #\n# smile, 50 or more). #\n#              brow up,     brow up,     brow down,   brow down, #\n#              mouth up     mouth down   mouth up     mouth down #\n#   angry      disgusted    shocked      mischievous  angry #\n#   sick       sick         relieved     queasy       grumpy #\n#   alien      curious      puzzled      scheming     homesick #\n#   yellow     happy        worried      determined   sulky #\nlet mood = fun (f, brow, smile) : (Int, Int, Int) ->\nlet up = brow < 50 in\nlet smiling = smile >= 50 in\nif f == 0 then\n(if up then (if smiling then \"disgusted\" else \"shocked\")\nelse (if smiling then \"mischievous\" else \"angry\"))\nelse if f == 1 then\n(if up then (if smiling then \"sick\" else \"relieved\")\nelse (if smiling then \"queasy\" else \"grumpy\"))\nelse if f == 2 then\n(if up then (if smiling then \"curious\" else \"puzzled\")\nelse (if smiling then \"scheming\" else \"homesick\"))\nelse\n(if up then (if smiling then \"happy\" else \"worried\")\nelse (if smiling then \"determined\" else \"sulky\"));\n\n# The head's fill: the color itself. #\nlet fill = fun c : Int ->\n\"rgb(\" ++ string_of_int(c / 65536) ++ \" \" ++ string_of_int(int_mod(c / 256, 256))\n++ \" \" ++ string_of_int(int_mod(c, 256)) ++ \")\";\n\n# The mouth and the brow are the same kind of curve, a quadratic #\n# whose ends stay put while its middle follows the value, as in #\n# Emotion. Dragging the brow DOWN lowers its middle: a glower. #\nlet mouth = fun v : Int ->\n\"M60 150 Q100 \" ++ string_of_int(110 + 4 * v / 5) ++ \" 140 150\";\n\n# An open mouth is the space between two curves through the mouth's #\n# ends. Closed, both are the mouth's own curve, drawn as a line. #\n# Opening a flat mouth parts them evenly, into an oval. The more the #\n# mouth smiles or frowns, the more the curve on its far side stays #\n# the mouth's own, and the one on its near side flattens to the #\n# straight line between the ends: a half-oval. o runs 0 to 100. #\n# The lips are the two curves, as their middle control points: the #\n# upper one first. #\nlet lips = fun (v, o) : (Int, Int) ->\nlet q = 110 + 4 * v / 5 in\nlet bend = q - 150 in\nlet dir = if bend < 0 then 0 - 1 else 1 in\nlet extreme = if bend < 0 then 0 - bend else bend in\nlet even = 36 * o * (40 - extreme) / 4000 in\nlet far = q + dir * even in\nlet near = q + (150 - q) * o / 100 - dir * even in\nif far < near then (far, near) else (near, far);\nlet open_mouth = fun (v, o) : (Int, Int) ->\nif o == 0 then mouth(v)\nelse\nlet (upper, lower) = lips((v, o)) in\n\"M60 150 Q100 \" ++ string_of_int(lower) ++ \" 140 150 Q100 \"\n++ string_of_int(upper) ++ \" 60 150 Z\";\nlet brow = fun v : Int ->\n\"M55 78 Q100 \" ++ string_of_int(50 + 2 * v / 5) ++ \" 145 78\";\n# Without the unibrow, a brow over each eye. Its outer end stays put #\n# and its inner end follows the value as the unibrow's middle does: #\n# down for a glower, up for a worry. Each arches a little above its #\n# higher end. #\nlet brow_pair = fun v : Int ->\nlet inner = 66 + v * 24 / 100 in\nlet top = (if inner < 80 then inner else 80) - 8 in\n\"M48 80 Q68 \" ++ string_of_int(top) ++ \" 88 \" ++ string_of_int(inner)\n++ \" M152 80 Q132 \" ++ string_of_int(top) ++ \" 112 \" ++ string_of_int(inner);\n\n# The head, split along a jagged crack at y = 60 into a lid and the #\n# rest. Unexploded it is drawn as one round head, with no line #\n# where the two will part. #\nlet whole_head = \"M38 60 A80 80 0 1 0 162 60 A80 80 0 0 0 38 60 Z\";\nlet lower_head = \"M38 60 A80 80 0 1 0 162 60 Z\";\nlet lid = \"M38 60 A80 80 0 0 1 162 60 Z\";\nlet crack = \"M38 60 L52 52 L66 63 L80 51 L94 63 L108 51 L122 63 L136 51 L150 62 L162 60\";\n\n# Candy and confetti: forty PIECES bursting out of the crack, each #\n# an emoji stamp (one short text node instead of a drawing) or a #\n# colored scrap of confetti. Piece i has its own direction, height #\n# and spin, and flies out as far as the head has opened. How many #\n# show grows with candy times explode and is full by the time both #\n# are halfway; the rest are there but invisible, so the list is the #\n# same length whatever the sliders say. #\nlet pieces_n = 40;\nlet modulo = fun (a, n) : (Int, Int) -> a - (a / n) * n;\nlet confetti =\n[\"deeppink\", \"orange\", \"dodgerblue\", \"limegreen\", \"gold\",\n\"mediumpurple\", \"red\"];\nlet piece = fun (i, shown, burst) : (Int, Int, Int) ->\nlet x = 100 + (modulo((i * 53, 190)) - 95) * burst / 100 in\nlet y = 60 - (15 + modulo((i * 29, 125))) * burst / 100 in\nlet spin = modulo((i * 67, 360)) * burst / 100 in\nlet kind = modulo((i, 5)) in\nHtml.node(\"g\",\n[Attr.create(\"transform\",\n\"translate(\" ++ string_of_int(x) ++ \" \" ++ string_of_int(y)\n++ \") rotate(\" ++ string_of_int(spin) ++ \")\"),\nAttr.create(\"opacity\", if i < shown then \"1\" else \"0\")],\n[if kind < 3 then\nHtml.node(\"text\",\n[Attr.create(\"font-size\", string_of_int(16 + modulo((i * 7, 11)))),\nAttr.create(\"text-anchor\", \"middle\"),\nAttr.create(\"dominant-baseline\", \"middle\")],\n[Html.text(nth(([\"\240\159\141\172\", \"\240\159\141\173\", \"\240\159\141\171\"], kind)))])\nelse\nHtml.node(\"rect\",\n[Attr.create(\"x\", \"-6\"), Attr.create(\"y\", \"-3\"),\nAttr.create(\"width\", \"12\"), Attr.create(\"height\", \"6\"),\nAttr.create(\"fill\", nth((confetti, modulo((i, 7)))))], [])]);\nlet pieces = fun (i, shown, burst) : (Int, Int, Int) ->\nif i >= pieces_n then []\nelse piece((i, shown, burst)) :: pieces((i + 1, shown, burst));\n\n# Eyes, at (x, 100): a dot sized by the eye slider, or a star, a #\n# heart, a heart with a star on it, or an X. #\nlet eye = fun (x, size, stars, hearts, xs) : (Int, Int, Bool, Bool, Bool) ->\nlet r = 6 + size / 7 in\nlet glyph = fun (g, gx, gy, gs) : (String, Int, Int, Int) ->\nHtml.node(\"text\",\n[Attr.create(\"x\", string_of_int(gx)), Attr.create(\"y\", string_of_int(gy)),\nAttr.create(\"font-size\", string_of_int(gs)),\nAttr.create(\"text-anchor\", \"middle\"),\nAttr.create(\"dominant-baseline\", \"central\")],\n[Html.text(g)]) in\nif xs then\nHtml.node(\"path\",\n[Attr.create(\"d\",\n\"M\" ++ string_of_int(x - r) ++ \" \" ++ string_of_int(100 - r)\n++ \" L\" ++ string_of_int(x + r) ++ \" \" ++ string_of_int(100 + r)\n++ \" M\" ++ string_of_int(x - r) ++ \" \" ++ string_of_int(100 + r)\n++ \" L\" ++ string_of_int(x + r) ++ \" \" ++ string_of_int(100 - r)),\nAttr.create(\"stroke\", \"black\"),\nAttr.create(\"stroke-width\", string_of_int(3 + r / 6)),\nAttr.create(\"stroke-linecap\", \"round\")], [])\nelse if hearts then\nHtml.node(\"g\", [],\n[glyph((\"\226\157\164\239\184\143\", x, 100, r * 3))]\n@ (if stars then [glyph((\"\226\173\144\", x + r, 100 - r, r * 3 / 2))] else []))\nelse if stars then glyph((\"\226\173\144\", x, 100, r * 3))\nelse\nHtml.node(\"circle\",\n[Attr.create(\"cx\", string_of_int(x)), Attr.create(\"cy\", \"100\"),\nAttr.create(\"r\", string_of_int(r))], []);\n\n# Lines: each from a center, along a direction (dx, dy) out of 100, #\n# from radius r0 for len. A line of length 0 is drawn but unseen, #\n# so the lists keep their length. #\nlet ray = fun (cx, cy, r0, len, width, color, dx, dy)\n: (Int, Int, Int, Int, Int, String, Int, Int) ->\nHtml.node(\"line\",\n[Attr.create(\"x1\", string_of_int(cx + r0 * dx / 100)),\nAttr.create(\"y1\", string_of_int(cy + r0 * dy / 100)),\nAttr.create(\"x2\", string_of_int(cx + (r0 + len) * dx / 100)),\nAttr.create(\"y2\", string_of_int(cy + (r0 + len) * dy / 100)),\nAttr.create(\"stroke\", color),\nAttr.create(\"stroke-width\", string_of_int(width)),\nAttr.create(\"stroke-linecap\", \"round\"),\nAttr.create(\"stroke-opacity\", if len > 0 then \"1\" else \"0\")], []);\n# Side lines fan out of the right side, and mirrored out of the #\n# left; more of the fan shows as the slider goes up, middle first. #\n# Each direction is (dx, dy + 100), so the table has no minus signs. #\nlet fan = [(100, 100), (94, 134), (94, 66), (77, 164), (77, 36)];\nlet sides_of = fun (i, v, ds) : (Int, Int, [(Int, Int)]) ->\ncase ds\n| [] => []\n| (dx, oy) :: rest =>\nlet dy = oy - 100 in\nlet shown = if v == 0 then 0 else 1 + v * 4 / 100 in\nlet len = if i < shown then 8 + v * 35 / 100 else 0 in\nlet width = 2 + v / 25 in\nlet color = nth(([\"#999999\", \"#666666\", \"#333333\", \"black\", \"black\"], v / 26)) in\nray((100, 111, 86, len, width, color, dx, dy))\n:: ray((100, 111, 86, len, width, color, 0 - dx, dy))\n:: sides_of((i + 1, v, rest))\nend;\n# Head rays shoot up out of the crack, in a fan of seven. Each is #\n# (dx + 100, how far up). #\nlet up_fan =\n[(100, 100), (134, 94), (66, 94), (164, 77), (36, 77), (187, 50),\n(13, 50)];\nlet rays_up = fun (len, width, ds) : (Int, Int, [(Int, Int)]) ->\ncase ds\n| [] => []\n| (ox, up) :: rest =>\nray((100, 60, 18, len, width, \"orange\", ox - 100, 0 - up))\n:: rays_up((len, width, rest))\nend;\n\n# Teeth: up to five triangles along the mouth, spread evenly however #\n# many there are, alternately sticking up and down: up from the lower #\n# lip, down from the upper one, so open they line the mouth's border #\n# and closed they sit on its line, where both lips are. A lip is #\n# M60 150 Q100 q 140 150, so at t = j/(n+1) it passes x = 60 + 80t, #\n# y = 150 + 2t(1-t)(q - 150). #\nlet tooth = fun (j, n, upper, lower, big) : (Int, Int, Int, Int, Int) ->\nlet d = n + 1 in\nlet x = 60 + 80 * j / d in\nlet up = j - (j / 2) * 2 == 1 in\nlet q = if up then lower else upper in\nlet y = 150 + 2 * j * (d - j) * (q - 150) / (d * d) in\nlet tip = if up then y - big else y + big in\nHtml.node(\"polygon\",\n[Attr.create(\"points\",\nstring_of_int(x - 6) ++ \",\" ++ string_of_int(y) ++ \" \"\n++ string_of_int(x + 6) ++ \",\" ++ string_of_int(y) ++ \" \"\n++ string_of_int(x) ++ \",\" ++ string_of_int(tip)),\nAttr.create(\"fill\", \"white\"), Attr.create(\"stroke\", \"black\"),\nAttr.create(\"stroke-width\", \"2\"),\nAttr.create(\"visibility\", if j <= n then \"visible\" else \"hidden\")], []);\nlet teeth_of = fun (j, n, upper, lower, big) : (Int, Int, Int, Int, Int) ->\nif j > 5 then []\nelse tooth((j, n, upper, lower, big)) :: teeth_of((j + 1, n, upper, lower, big));\n\n# Sickness: drips fall out of the mouth, then a pile grows on the #\n# ground at y = 325 below the face, a dome with bumps on it. Up to #\n# 40 the drips reach further down; from 30 the pile grows, to its #\n# full size at 100, where it gets an unhappy face of its own. Shapes #\n# not yet shown are there but hidden, so the lists keep their length. #\nlet sick_colors = [\"yellowgreen\", \"#c8c84a\", \"olivedrab\", \"#b5c22e\"];\nlet shown_if = fun on : Bool -> Attr.create(\"visibility\", if on then \"visible\" else \"hidden\");\nlet blob = fun (x, y, r, i, on) : (Int, Int, Int, Int, Bool) ->\nHtml.node(\"circle\",\n[Attr.create(\"cx\", string_of_int(x)), Attr.create(\"cy\", string_of_int(y)),\nAttr.create(\"r\", string_of_int(r)),\nAttr.create(\"fill\", nth((sick_colors, modulo((i, 4))))),\nAttr.create(\"stroke\", \"#6b7a1f\"), Attr.create(\"stroke-width\", \"1\"),\nshown_if(on)], []);\n# The drips: six along the stream, out of 100 of its length. #\nlet drips = fun (j, from, to, size, on) : (Int, Int, Int, Int, Bool) ->\nif j >= 6 then []\nelse\nblob((100 + (if modulo((j, 2)) == 0 then 0 - 4 else 4),\nfrom + (to - from) * (j + 1) / 6, size - modulo((j, 3)), j, on))\n:: drips((j + 1, from, to, size, on));\n# The pile's bumps: (x, height) on the dome out of 100, and a size. #\n# Each sits inside the dome's outline, and none where its face goes. #\nlet bumps_at =\n[(8, 15, 7), (20, 40, 8), (30, 62, 8), (40, 88, 9), (50, 96, 8),\n(60, 88, 9), (70, 62, 8), (80, 40, 8), (92, 15, 7), (25, 12, 6)];\nlet bumps = fun (i, bs, rx, ry, p) : (Int, [(Int, Int, Int)], Int, Int, Int) ->\ncase bs\n| [] => []\n| (bx, by, br) :: rest =>\nblob((100 + (bx - 50) * 2 * rx / 100, 325 - by * ry / 100,\n1 + br * p / 100, i, p > 0))\n:: bumps((i + 1, rest, rx, ry, p))\nend;\nlet sick_pile = fun (s, mouth_y) : (Int, Int) ->\nlet p = if s > 30 then (s - 30) * 100 / 70 else 0 in\nlet rx = 6 + p * 84 / 100 in\nlet ry = 3 + p * 42 / 100 in\nlet top = 325 - ry in\nlet reach = mouth_y + (top - mouth_y) * (if s < 40 then s else 40) / 40 in\nlet size = 3 + s / 12 in\n[Html.node(\"path\",\n[Attr.create(\"d\",\n\"M100 \" ++ string_of_int(mouth_y) ++ \" Q93 \"\n++ string_of_int((mouth_y + reach) / 2) ++ \" 100 \" ++ string_of_int(reach)),\nAttr.create(\"fill\", \"none\"), Attr.create(\"stroke\", \"yellowgreen\"),\nAttr.create(\"stroke-width\", string_of_int(4 + s / 10)),\nAttr.create(\"stroke-linecap\", \"round\"), shown_if(s > 0)], []),\nHtml.node(\"path\",\n[Attr.create(\"d\",\n\"M\" ++ string_of_int(100 - rx) ++ \" 325 A\" ++ string_of_int(rx) ++ \" \"\n++ string_of_int(ry) ++ \" 0 0 1 \" ++ string_of_int(100 + rx) ++ \" 325 Z\"),\nAttr.create(\"fill\", \"#a8b83a\"), Attr.create(\"stroke\", \"#6b7a1f\"),\nAttr.create(\"stroke-width\", \"2\"), shown_if(p > 0)], [])]\n@ bumps((0, bumps_at, rx, ry, p))\n@ drips((0, mouth_y, reach, size, s > 0))\n# At 100, the pile looks back: two eyes and a frown. #\n@ [Html.node(\"g\", [shown_if(s == 100)],\n[Html.node(\"circle\", [Attr.create(\"cx\", \"84\"), Attr.create(\"cy\", \"301\"), Attr.create(\"r\", \"5\")], []),\nHtml.node(\"circle\", [Attr.create(\"cx\", \"116\"), Attr.create(\"cy\", \"301\"), Attr.create(\"r\", \"5\")], []),\nHtml.node(\"path\",\n[Attr.create(\"d\", \"M84 318 Q100 306 116 318\"), Attr.create(\"fill\", \"none\"),\nAttr.create(\"stroke\", \"black\"), Attr.create(\"stroke-width\", \"3\"),\nAttr.create(\"stroke-linecap\", \"round\")], [])])];\n\n# The brow and the mouth are the face's controls, so each lights up #\n# under the pointer: a group holding the line itself and, on top, a #\n# wide invisible stroke along the same curve, so the pointer need not #\n# find a line a few units thick. Hovering anywhere on that stroke #\n# turns the line blue. #\nlet hot_css =\n\".kid-hot:hover > .kid-line { stroke: #1f6feb; }\"\n++ \" .kid-hit { stroke: transparent; fill: none; pointer-events: stroke; }\";\nlet hot = fun (d, attrs) : (String, [Attr.T]) ->\nHtml.node(\"g\", [Attr.create(\"class\", \"kid-hot\")],\n[Html.node(\"path\", [Attr.create(\"d\", d), Attr.create(\"class\", \"kid-line\")] @ attrs, []),\nHtml.node(\"path\",\n[Attr.create(\"d\", d), Attr.create(\"class\", \"kid-hit\"),\nAttr.create(\"stroke-width\", \"22\")], [])]);\n\n# The face's own sliders, for smile and brow. #\nlet own_slider = fun (label, v, act) : (String, Int, Int -> Action) ->\nHtml.div(\n[Attr.style([(\"display\", \"flex\"), (\"gap\", \"0.5em\"),\n(\"align-items\", \"center\"),\n(\"font-family\", \"var(--code-font)\"),\n(\"font-size\", \"0.8em\")])],\n[Html.span([Attr.style([(\"white-space\", \"nowrap\")])], [Html.text(label)]),\nHtml.input([\nAttr.type_(\"range\"), Attr.min(\"0\"), Attr.max(\"100\"), Attr.style([(\"flex\", \"1\"), (\"min-width\", \"0\")]),\nAttr.value(string_of_int(v)),\nAttr.on_input(fun s -> act(int_of_string(s)))\n]),\nHtml.span([Attr.style([(\"white-space\", \"nowrap\"), (\"min-width\", \"3ch\")])], [Html.text(string_of_int(v))])]);\n\nlet view = fun m : Model ->\ndo c_res <- eval_splice(m.color) in\ndo b_res <- eval_splice(m.burst) in\ndo k_res <- eval_splice(m.candy) in\ndo st_res <- eval_splice(m.stars) in\ndo ht_res <- eval_splice(m.hearts) in\ndo e_res <- eval_splice(m.eyes) in\ndo sd_res <- eval_splice(m.sides) in\ndo r_res <- eval_splice(m.rays) in\ndo t_res <- eval_splice(m.teeth) in\ndo o_res <- eval_splice(m.opening) in\ndo xe_res <- eval_splice(m.x_eyes) in\ndo ub_res <- eval_splice(m.unibrow) in\n# Each cell's value, or a default while it has none. #\nlet c = case c_res\n| Some(Val(n)) => (if n < 0 then 0 else if n > 16777215 then 16777215 else n)\n| _ => 13606912 end in\nlet b = case b_res | Some(Val(n)) => clamp(n) | _ => 0 end in\nlet k = case k_res | Some(Val(n)) => clamp(n) | _ => 0 end in\nlet st = case st_res | Some(Val(v)) => v | _ => false end in\nlet ht = case ht_res | Some(Val(v)) => v | _ => false end in\nlet e = case e_res | Some(Val(n)) => clamp(n) | _ => 50 end in\nlet sd = case sd_res | Some(Val(n)) => clamp(n) | _ => 0 end in\nlet r = case r_res | Some(Val(n)) => clamp(n) | _ => 0 end in\nlet t = case t_res | Some(Val(n)) => (if n < 0 then 0 else if n > 5 then 5 else n) | _ => 0 end in\nlet o = case o_res | Some(Val(n)) => clamp(n) | _ => 0 end in\nlet xe = case xe_res | Some(Val(v)) => v | _ => false end in\nlet sk = m.sickness in\nlet view_h = drawing_h(sk) in\nlet ub = case ub_res | Some(Val(v)) => v | _ => true end in\nlet ray_len = if r == 0 then 0 else (15 + r * 6 / 10) * b / 100 in\nlet shown = if k * b >= 2500 then pieces_n else k * b * pieces_n / 2500 in\nlet lift = b * 7 / 10 in\nlet tilt = b / 4 in\nlet head_fill = fill(c) in\nlet (upper_lip, lower_lip) = lips((m.smile, o)) in\nlet part = fun d : String ->\nHtml.node(\"path\",\n[Attr.create(\"d\", d), Attr.create(\"fill\", head_fill),\nAttr.create(\"stroke\", \"black\"), Attr.create(\"stroke-width\", \"3\")], []) in\n# The hint and the drag cursor are on the drawing only, which has #\n# room below it for the hint: a hint shows at the bottom of what it #\n# is on, and on the whole widget it covered the face's sliders. #\nPure(\nHtml.div([],\n[Html.div(\n[Attr.create(\"data-hint\", \"drag the brow or the mouth up/down\"),\nAttr.style([(\"cursor\", \"ns-resize\"), (\"padding-bottom\", \"16px\")])],\n[Html.node(\"svg\",\n[Attr.create(\"viewBox\", \"0 -80 200 \" ++ string_of_int(view_h)),\nAttr.width(string_of_int(width_px)),\nAttr.height(string_of_int(view_h * 11 / 10)),\nAttr.on_mouse_down_at(fun (_x, y) -> Down(y)),\nAttr.on_mouse_move_at(fun (_x, y) -> MoveTo(y)),\nAttr.on_mouse_up_at(fun _p -> Up)],\n[Html.node(\"style\", [], [Html.text(hot_css)])]\n@ sides_of((0, sd, fan))\n@ [part(if b > 0 then lower_head else whole_head)]\n@ rays_up((ray_len, 3 + r / 25, up_fan))\n@ [Html.node(\"g\",\n[Attr.create(\"transform\",\n\"translate(0 \" ++ string_of_int(0 - lift) ++ \") rotate(\"\n++ string_of_int(0 - tilt) ++ \" 100 60)\"),\nAttr.create(\"visibility\", if b > 0 then \"visible\" else \"hidden\")],\n[part(lid)])]\n@ pieces((0, shown, b))\n@ [Html.node(\"path\",\n[Attr.create(\"d\", crack), Attr.create(\"fill\", \"none\"),\nAttr.create(\"stroke\", if b > 0 then \"black\" else \"none\"),\nAttr.create(\"stroke-width\", \"2\")], []),\neye((68, e, st, ht, xe)), eye((132, e, st, ht, xe)),\nhot((if ub then brow(m.brow) else brow_pair(m.brow),\n[Attr.create(\"stroke\", \"black\"),\nAttr.create(\"fill\", \"transparent\"),\nAttr.create(\"stroke-width\", if ub then \"7\" else \"6\"),\nAttr.create(\"stroke-linecap\", \"round\")])),\nhot((open_mouth((m.smile, o)),\n[Attr.create(\"stroke\", \"black\"),\nAttr.create(\"fill\", if o == 0 then \"transparent\" else \"#5c1a1a\"),\nAttr.create(\"stroke-width\", \"5\"),\nAttr.create(\"stroke-linejoin\", \"round\")]))]\n@ teeth_of((1, t, upper_lip, lower_lip, 10))\n@ sick_pile((sk, 150 + (lower_lip - 150) / 2))\n@ [Html.node(\"text\",\n[Attr.create(\"x\", \"100\"), Attr.create(\"y\", string_of_int(view_h - 86)),\nAttr.create(\"text-anchor\", \"middle\"),\nAttr.create(\"font-size\", \"18\"),\nAttr.create(\"font-family\", \"var(--code-font)\"), Attr.style([(\"fill\", \"var(--text-default)\")])],\n[Html.text(mood((family(c), m.brow, m.smile)))])])]),\nown_slider((\"smile\", m.smile, fun v -> SetSmile(v))),\nown_slider((\"brow\", m.brow, fun v -> SetBrow(v))),\nown_slider((\"sickness\", m.sickness, fun v -> SetSick(v)))]));\n\n# A Macro: the cells are the client's code, so a use means a #\n# function of them, applied to them (Fig. 5). What the face alone #\n# knows -- its smile and brow -- is written into that code with #\n# antiquotes: for the feeling, the mood of each color family at #\n# this brow and mouth, since the quoted code, checked in the builtin #\n# context, cannot call mood itself -- nor family, so it tells the #\n# nearest preset again, the same way. The candy that comes out is the #\n# candy scaled by the explosion, as in the view, and so are the #\n# head rays. #\nlet expand = Macro(fun m : Model ->\n(quote fun c -> fun b -> fun k -> fun st -> fun ht -> fun e ->\nfun sd -> fun r -> fun t -> fun mo -> fun xe -> fun ub ->\n(feeling =\n(let cr = c / 65536 in\nlet cg = int_mod(c / 256, 256) in\nlet cb = int_mod(c, 256) in\nlet d0 = (cr - 220) * (cr - 220) + (cg - 20) * (cg - 20) + (cb - 60) * (cb - 60) in\nlet d1 = (cr - 140) * (cr - 140) + (cg - 190) * (cg - 190) + (cb - 50) * (cb - 50) in\nlet d2 = (cr - 170) * (cr - 170) + (cg - 178) * (cg - 178) + (cb - 186) * (cb - 186) in\nlet d3 = (cr - 207) * (cr - 207) + (cg - 160) * (cg - 160) + cb * cb in\nif d0 <= d1 && d0 <= d2 && d0 <= d3 then unquote StringLit(mood((0, m.brow, m.smile))) end\nelse if d1 <= d2 && d1 <= d3 then unquote StringLit(mood((1, m.brow, m.smile))) end\nelse if d2 <= d3 then unquote StringLit(mood((2, m.brow, m.smile))) end\nelse unquote StringLit(mood((3, m.brow, m.smile))) end),\nsmile = unquote IntLit(m.smile) end,\nbrow = unquote IntLit(m.brow) end,\nexploded = b,\ncandy = k * b / 100,\neyes =\nif xe then \"x\"\nelse if st then (if ht then \"starry hearts\" else \"stars\")\nelse (if ht then \"hearts\" else \"plain\"),\neye_size = e,\nside_lines = sd,\nrays = r * b / 100,\nteeth = t,\nmouth_open = mo,\nsickness = unquote IntLit(m.sickness) end,\nunibrow = ub)\nend,\n[m.color, m.burst, m.candy, m.stars, m.hearts, m.eyes, m.sides,\nm.rays, m.teeth, m.opening, m.x_eyes, m.unibrow]));\n\n# Taller while sick, for the pile: the drawing grows by 143 pixels. #\nlet shape = fun m : Model ->\nif m.sickness > 0 then Block(30, 23) else Block(30, 18)\n} in\n\nlet head = ^^livelit(^head_picker(13606912)) in\nlet boom = ^^livelit(^boom_dial(0)) in\nlet sweets = ^^livelit(^candy_dial(0)) in\nlet stars = ^^livelit(^star_toggle(false)) in\nlet hearts = ^^livelit(^heart_toggle(false)) in\nlet crosses = ^^livelit(^x_toggle(false)) in\nlet unibrow = ^^livelit(^unibrow_toggle(true)) in\nlet eyes = ^^livelit(^eye_dial(50)) in\nlet sides = ^^livelit(^side_dial(0)) in\nlet rays = ^^livelit(^ray_dial(0)) in\nlet teeth = ^^livelit(^teeth_dial(0)) in\nlet mouth = ^^livelit(^open_dial(0)) in\nlet ^^probe(face) = ^^livelit(^kid_face(smile=35, brow=90, drag=Idle, color=(head), burst=(boom), candy=(sweets), stars=(stars), hearts=(hearts), eyes=(eyes), sides=(sides), rays=(rays), teeth=(teeth), opening=(mouth), x_eyes=(crosses), sickness=0, unibrow=(unibrow))) in\n\nface\n\n# The sliders and toggles are let-bound above the face, as Tree Care's are, #\n# and the face's cells name them. The probe shows what the face #\n# means: its feeling, smile and brow, how exploded it is, and the #\n# candy actually coming out. #\n\n# Try: pick angry for the head color and the face reads angry; #\n# drag the brow down to glower to match. Slide explode up and the lid #\n# lifts off; then slide candy up, and it pours out, confetti and #\n# all. With explode at 0 no candy shows, however high the candy #\n# slider goes. Drag the mouth and watch the face's smile slider #\n# follow. #\n")))))(result((stepper())(theorems((thm_map()))))))))(agent((chat_system((chat_map((0a7b6500-0000-4000-a05f-23e90b7088af((id 0a7b6500-0000-4000-a05f-23e90b7088af)(title"New Chat")(message_map((097b6500-0000-4000-a05f-23e90b7088af((id 097b6500-0000-4000-a05f-23e90b7088af)(content [[HAZEL:SYSTEM_PROMPT]])(timestamp 1790991604529)(role(System Prompt))(api_message())(children(0b7b6500-0000-4000-a05f-23e90b7088af))(current_child(0b7b6500-0000-4000-a05f-23e90b7088af))(reasoning())(reasoning_duration_ms())))(0b7b6500-0000-4000-a05f-23e90b7088af((id 0b7b6500-0000-4000-a05f-23e90b7088af)(content"Development mode active. Follow developer instructions precisely. Be concise. No first-person pronouns.")(timestamp 1790991604529)(role(System DeveloperNotes))(api_message(((role Developer)(content"Development mode active. Follow developer instructions precisely. Be concise. No first-person pronouns.")(tool_calls())(cache_anchor true))))(children())(current_child())(reasoning())(reasoning_duration_ms())))))(root 097b6500-0000-4000-a05f-23e90b7088af)(agent_view((expanded_paths())))(agent_workbench((active_task())(task_dict())(t_ui((active_view Chat)(display_task())(show_archive false)))))(context())(created_at 1790991604529)(current_view Messages)(pending_send_queue())))))(current 0a7b6500-0000-4000-a05f-23e90b7088af)(ui((active_screen Chat)(current_text_box_content"")(slash_menu())))))(prompting((system_prompt [[HAZEL:SYSTEM_PROMPT]])(dev_notes"Development mode active. Follow developer instructions precisely. Be concise. No first-person pronouns.")(tools())(disabled_tool_names())))(active_timeline_node())(awaiting_response())(restore_editor_state())(last_empty_retry_attempt