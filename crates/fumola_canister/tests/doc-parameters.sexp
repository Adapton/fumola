(CodePersist((editor(((editor((root Exp)(zipper((zipper"")(backup_text"# Parameters #\n\n# One slider, many ranges. ^slider takes its bounds as PARAMETERS, #\n# the paper's $slider 0 100 (Sec. 2.4.1): the definition is a #\n# function from them to the livelit module, so every member may use #\n# lo and hi, and the module's types are the same for every range. #\n\n# A livelit that takes parameters is used through an ABBREVIATION, #\n# which gives them once and names the result, the paper's #\n# let $uslider = $slider 0: #\n\n#   let ^percent = ^slider(0, 100) in #\n\n# ^percent is then an ordinary livelit: type ^percent then a space #\n# for a new use. #\n\n# Or give the parameters at the use itself, the paper's #\n# $slider 1 12, with no abbreviation: #\n\n#   ^^livelit(^slider(1, 12)(3)) #\n\n# Using ^slider with no parameters, as ^slider(50), is an error: it #\n# takes them. #\n\n# The parameters are CLOSED: literals, or expressions over builtins. #\n# init and update run when you create a use and at each event, where #\n# the client's variables are not in scope, so an argument that names #\n# one is reported where it is written. #\n\n# Compare Define a Slider, whose bounds are fixed in its view; Tree #\n# Care, whose ^range keeps its bounds in its model; and Editable #\n# Parameters, whose bounds are splices, the client's code, edited in #\n# the widget and free to name the client's variables. #\n\nlet ^slider = fun (lo, hi) : (Int, Int) -> {\ntype Model = Int;\ntype Action = Int;\ntype Expansion = Int;\n\n# A new use starts in the middle of its range. #\nlet init = Pure((lo + hi) / 2);\n\nlet update = fun _m : Model -> fun a : Action -> Pure(a);\n\nlet view = fun m : Model -> Pure(\nHtml.div(\n[Attr.style([(\"display\", \"flex\"), (\"gap\", \"0.5em\"),\n(\"align-items\", \"center\"),\n(\"font-family\", \"var(--code-font)\"),\n(\"font-size\", \"0.8em\")])],\n[\nHtml.text(string_of_int(lo)),\nHtml.input([\nAttr.type_(\"range\"),\nAttr.min(string_of_int(lo)), Attr.max(string_of_int(hi)),\nAttr.value(string_of_int(m)),\nAttr.on_input(fun s -> int_of_string(s))\n]),\nHtml.text(string_of_int(hi) ++ \": \" ++ string_of_int(m))\n]\n));\n\nlet expand = Functional(fun m : Model -> m);\n\nlet shape = Inline(28)\n} in\n\n# Two abbreviations of one definition. #\n\nlet ^percent = ^slider(0, 100) in\nlet ^die = ^slider(1, 6) in\n\n# 25 + 3: each use means its own model, within its own range. #\n\n^^livelit((^percent(80))) + ^^livelit(^die(3))\n")))))(result((stepper())(theorems((thm_map()))))))))(agent((chat_system((chat_map((beee0000-0000-4000-bf92-a54e4f48920c((id beee0000-0000-4000-bf92-a54e4f48920c)(title"New Chat")(message_map((bdee0000-0000-4000-bf92-a54e4f48920c((id bdee0000-0000-4000-bf92-a54e4f48920c)(content [[HAZEL:SYSTEM_PROMPT]])(timestamp 1790973786681)(role(System Prompt))(api_message())(children(bfee0000-0000-4000-bf92-a54e4f48920c))(current_child(bfee0000-0000-4000-bf92-a54e4f48920c))(reasoning())(reasoning_duration_ms())))(bfee0000-0000-4000-bf92-a54e4f48920c((id bfee0000-0000-4000-bf92-a54e4f48920c)(content"Development mode active. Follow developer instructions precisely. Be concise. No first-person pronouns.")(timestamp 1790973786681)(role(System DeveloperNotes))(api_message(((role Developer)(content"Development mode active. Follow developer instructions precisely. Be concise. No first-person pronouns.")(tool_calls())(cache_anchor true))))(children())(current_child())(reasoning())(reasoning_duration_ms())))))(root bdee0000-0000-4000-bf92-a54e4f48920c)(agent_view((expanded_paths())))(agent_workbench((active_task())(task_dict())(t_ui((active_view Chat)(display_task())(show_archive false)))))(context())(created_at 1790973786681)(current_view Messages)(pending_send_queue())))))(current beee0000-0000-4000-bf92-a54e4f48920c)(ui((active_screen Chat)(current_text_box_content"")(slash_menu())))))(prompting((system_prompt [[HAZEL:SYSTEM_PROMPT]])(dev_notes"Development mode active. Follow developer instructions precisely. Be concise. No first-person pronouns.")(tools())(disabled_tool_names())))(active_timeline_node())(awaiting_response())(restore_editor_state())(last_empty_retry_attempt())(last_active_task_nudge_attempt())(tools_view_expanded())(compaction_in_progress())(compaction_method_override())(main_llm_seq 0)(compaction_llm_seq 0)(pending_ignore_main_reply_seq())(pending_ignore_compaction_reply_seq())(pending_dispatch_send())(pending_assistant_content"")(pending_assistant_reasoning"")))))
