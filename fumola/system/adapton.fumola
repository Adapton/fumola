import Map "hashMap";
module {
    /// Adapton's structures in Fumola.
    ///
    /// PeekInfo --- Fumola values that describe Adapton behavior and structures.
    ///
    /// Outline --- A depth-first structure over PeekInfo at some root.
    /// IntoText --- for outline printouts that are compact, and textual.
    ///
    /// Scene --- A multi-dimensional structure for exporting PeekInfo to interactive tools.
    /// IntoJSON --- for the web-based DCG Player tool.
    ///

    /// PeekInfo gives the fumola value-based types for the
    /// internal state of Adapton within Fumola.
    ///
    /// Specifically, these types follow the output of the 
    /// PeekValue trait (in Rust) within the  
    /// graphical representation of the Adapton cache.
    ///
    public module PeekInfo {
        public type History = {
            events : Events;
            nodes : [{
                nodeId : NodeId;
                metaTime: MetaTime;
                node : Node; 
            }];
            edges : [{
                edgeId : EdgeId;
                metaTime: MetaTime;
                edge : Edge
            }]
        };
        public type Events = [Event];
        public type Event = {
            #addNode : NodeId;
            #addEdge : EdgeId;
            #removeEdge : EdgeId;
            #forceBegin : NodeId;
            #forceEnd : (NodeId, EdgeId);
        };
        public type MetaTime = Nat;
       
        public type Time = { #time : Symbol }; // --- TO DO
        public type Space = { #space : Symbol }; // --- TO DO
        public type Pointer = Space;

        // TO DO --
        // public type NodeId = { #nodeId : (Pointer, Time, MetaTime) };
        public type NodeId = (Space, Time, MetaTime);
       
        public type EdgeId = { #edgeId : Nat };

        public type Node = {
            #nonThunk : Any;
            #thunk_ : ThunkNode;
        };

        public type ThunkNode = {
            body : Thunk<Any>;
            trace : [ EdgeId ];
            result : ?(MetaTime, Any);
            space : Space;
        };

        // meta time intervals (begin, end) where begin <= end.
        public type MetaTimes = (MetaTime, MetaTime);

        public type Edge = {
            source : NodeId;
            target : NodeId;
            action : Action;
            metaTimes : MetaTimes;
        };

        public type NodeInfo = {
            node : Node;
            nodeId : NodeId;
            incomingEdges : [(EdgeId, Edge)];
            outgoingEdges : [(EdgeId, Edge)];
        };
    };

    public func peekInfo(p : Pointer) : ?PeekInfo.NodeInfo {
        prim "adaptonPeekCell" p
    };

    #[test]
    func testPeekInfo() {
        let p = 1 := 1;
        prim "print" (debug_show (peekInfo(p)))

        // TO DO
    };

    public func peekHistory() : PeekInfo.History {
        let history = prim "adaptonPeekHistory" ();
	    history
    };

    public func peekEvents() : PeekInfo.Events {
        let history = prim "adaptonPeekHistory" ();
	    history.events
    };

    public func now() : Time {
        prim "adaptonNow" ()
    };

    public func here() : Space {
        prim "adaptonHere" ()
    };

    public func space(s : Symbol) : Space {
        prim "adaptonSpace" s
    };

    #[test]
    func testSpace() {
        assert (debug_show(space(`x)) == "@adaptonSpace (x)")
    };

    #[test]
    func testPeekEvents() {       
        let p = 1 := 1;
        let pId = (space(1), now(), 1);
        let evs = peekEvents();
        assert (evs.size() == 2);
        assert (evs[0] == { event = #addNode(pId); metaTime = 1});
        assert (evs[1] == { event = #addEdge(#edgeId(1001)); metaTime = 1});

        let t = 2 := thunk { p := 0 };
        let tId = (space(2), now(), 2);
        let pId_ = (space(1), now(), 4);
        
        let evs = peekEvents();
        assert (evs.size() == 4);
        assert (evs[2] == { event = #addNode(tId);           metaTime = 2});
        assert (evs[3] == { event = #addEdge(#edgeId(1002)); metaTime = 2});

        assert((force(t)) == p);

        let evs = peekEvents();
    
        assert (evs.size() == 9);
        assert (evs[4] == { event = #forceBegin(tId);        metaTime = 3});
        assert (evs[5] == { event = #addNode(pId_);          metaTime = 4});
        assert (evs[6] == { event = #addEdge(#edgeId(1003)); metaTime = 4});
        assert (evs[7] == { event = #addEdge(#edgeId(1004)); metaTime = 5});
        assert (evs[8] == { event = #forceEnd(tId, #edgeId(1004)); metaTime = 5});
    
        assert((force(t)) == p);

        let evs = peekEvents();

        assert (evs.size() == 11);
        assert (evs[9] == {event = #forceBegin(tId); metaTime = 6});
        assert (evs[10] == {event = #forceEnd((tId, #edgeId(1005))); metaTime = 6});

        if false {
            prim "print" (evs.size());
            var count = 0;
            for (ev in evs.vals()) {
                prim "print" (debug_show (count, ev));
                count += 1;
            }
        };
    };

    // helper code:
    // this codifies a simple convention that works when every spatial name
    // is unique enough to stand without its temporal or meta-temporal components.
    public func nodeIdsByLabelFromEvents(evs : [Event]) : Map<Text, [NodeId]> {
        var map = Map.new();
        for (ev in evs.vals()) {
        switch (ev.event) {
        case (#addNode(nodeId)) {
          let (sp, tm, mt) = nodeId;
          let label_ = (debug_show sp.0);
          switch (Map.get(map, label_)) {
            case null {
              let (map_, _) = Map.put(map, label_, [(debug_show nodeId)]);
              map := map_;
            };
            case (?nodeIds) {
              let (map_, _) = Map.put(map, label_, nodeIds # [(debug_show nodeId)]);
              map := map_;
            }
          }
        };
        case _ {};
        }
        };
        map;
    };

    //
    // Outline representation for printing on terminals,
    // and for generating other output file formats (Text, JSON, TikZ).
    // 
    public module Outline {
        public type Outline = {
            #leaf : LeafNode;
            #internal : InternalNode; 
        };
        public type LeafNode = {
            nodeId : NodeId;
            shape : NodeShape;
            value : Any;
        };
	    public type InternalNode = {
            __nodeId : NodeId;      // using __ prefixes to promote in default print order.
            __shape : NodeShape;
            edges : [ OutlineEdge ];
            metaTimes : MetaTimes;
            value : Any;
        };
        public type NodeShape = {
	        #thunk_;
	        #nonThunk;
	    };
        
        // Using the prefix "Outline" to avoid confusion with
        // types of otherwise the same name.

        public type OutlineEdge = {
            action : ShowAction ;
            actionTarget : NodeId ;
            outline : ?Outline;
            forcedThunk : ?Thunk<Any>;
            value : Any;
            metaTimes : MetaTimes;
        };
        //
        // Just the "tag" of the action, where the other action information
        // is organized into the OutlineEdge type.
        //
	    public type ShowAction = {
            #put ;
            #putForce ; // same as #put ; #force_ in sequence.
            #get ;
            #force_ 
        };

        public func outline(root: Pointer) : Outline {
            // To do -- 
            // When we have sharing across forces, we'll need to check a "visited set"
            // We skip that detail for now. 2026-05-05.
            outlineRec(root /*, PointerSetObj.new()*/ )
        };

        public func outlineRec(root : Pointer /*, visited : PointerSetOBj */) : Outline {
            let nodeInfo = (peekInfo root)!;
	        let nodeId = nodeInfo.nodeId;
            switch (nodeInfo.node) {
                case(#nonThunk(value)) {
                    #leaf({
                        nodeId = nodeInfo.nodeId;
                        shape = #nonThunk; 
                        value
                    })
                };
                case(#thunk_(t)) {
                    if (t.trace.size() == 0) {
                        assert (nodeInfo.outgoingEdges.size() == 0);
                        #leaf({
                            nodeId = nodeInfo.nodeId;
                            shape = #thunk_;
                            value = t.result;
                        })
                    } else {
                        var prevEdge = null;
                        var edges = [var ];
                        for ((_, edge) in nodeInfo.outgoingEdges.vals()) {
                            let edgeInfo = edgeActionInfo(edge);
                            let actionTarget = prim "adaptonPointer" (edge.target.0);
                            var outline = null;
                            if (edgeInfo.action == #force_ 
                                /* and not(visited.contains(target)) */ ) {
                                // visited.insert(target);
                                outline := ? outlineRec(actionTarget /*, visited */);
                            };
                            let metaTimes = edgeInfo.metaTimes;
                            if ( 
                                prevEdge != null and
                                prevEdge!.action == #put and 
                                prevEdge!.actionTarget == actionTarget  ) {
                                edges[edges.size() - 1] := {
                                    actionTarget;
                                    action=#putForce;
                                    outline;
                                    value=edgeInfo.value;
                                    metaTimes=(prevEdge!.metaTimes.0, metaTimes.1);
                                }
                            } else { 
                                let edge = {
                                    action=edgeInfo.action;
                                    actionTarget;
                                    outline;
                                    metaTimes;
                                    value=edgeInfo.value;
                                };
                                edges #= [ edge ];
                                prevEdge := ?edge;
                            }
                        };
                        #internal({
                            __nodeId = nodeId;
                            __shape = #thunk_ ;
                            edges;
                            value = t.result
                            })
                    }
                }
            }
        };

        // some helper code for re-packaging certain variant-based fields into a uniform, flat record.
        public func edgeActionInfo(edge : Edge) : { 
            action: Action;
            putValue: ?Any; // TODO -- distinguish thunks and non-thunks
            forcedThunk: ?Thunk<A>;
            metaTime: MetaTime;
        } {
          switch (edge.action) {
            case(#put(value)) {{action=#put; value; forcedThunk=null; metaTimes=edge.metaTimes}};
            case(#get(value)) {{action=#get; value; forcedThunk=null; metaTimes=edge.metaTimes}};
            case(#force_(t, value)) {{action=#force_; value; forcedThunk=?t; value; metaTimes=edge.metaTimes}};
            }
        };
    };

    public module IntoText { 
        func indentText(n : Nat) : Text {
            if (n == 0) { "" } else 
            if (n == 1) { " " }  
            else {
            " ┆" # (indentText(n - 1))
            }
        };

        public func outlineRec(o : Outline, indent : Nat) : Text {
            switch o {
                case (#leaf(n)) { debug_show (n.nodeId.0) };
                case (#internal(n)) {
                    var text = debug_show (prim "adaptonPointer" (n.__nodeId.0));
                    for (edge in n.edges.vals()) {
                        text #= "\n" # (edgeIntoText(edge, indent + 1));
                    };
                    text # "\n" 
                    # indentText(indent + 1)
                    # "╰〜〜> " # (debug_show n.value)
                }
            }
        };

        public func actionIntoUnicode(action : ShowAction) : Text {
            switch action {
                case (#put)      { "───» " };
                case (#get)      { "───> " };
                case (#putForce) { "══▷» " };
                case (#force_)   { "═══▷ " };
            }
        };

        public func metaTimesIntoText(mts : MetaTimes) : Text {
            if (mts.0 == mts.1) { "(" # debug_show (mts.0) # ")" }
            else { debug_show mts }
        };

        public func edgeIntoText(edge : OutlineEdge, indent : Nat) : Text {
            indentText(indent) # "├" # metaTimesIntoText(edge.metaTimes) # (
            switch (edge.outline) {
                case null {
                    actionIntoUnicode(edge.action) # 
                    debug_show(edge.actionTarget)
                };
                case (?internalOutline) {
                    actionIntoUnicode(edge.action) # 
                      /* debug_show edge.actionTarget # */
                      outlineRec(internalOutline, indent);
                }
            })
        };

        public func outline(o : Outline) : Text {
            outlineRec(o, 0) # "\n"
        };
    };

    public module Scene {
        public type Vec3 = { x : Float; y : Float; z : Float };
        public let zero = { x = 0.0; y = 0.0; z =0.0 };
        public type SceneObject = {
            #orb : LabeledObject;
            #box : LabeledObject;
            #action : Action;
            #pointer : Edge;
        };
        public type LabeledObject = {
            label_ : Label;
            nodeIds: [NodeId];
            position : Vec3;
            textFields : Text;
            pointerFields : [Text]
        };
        public type Label = Text;
        public type Edge = { from : Label ; to : Label };
        public type Pointer = Edge;
        public type Action = { actionType: ActionType; from: Label; to:Label } /* and Edge */ ;
        public type ActionType = { #get ; #put ; #force_ ; #forcePut };

        public type Scene = {
            objects : [ SceneObject ];
            outline : Outline.Outline;
            history : {
                events : [PeekInfo.History.Event];
                nodes : [PeekInfo.History.Node];
                edges : [PeekInfo.History.Edge];
            };
        };
    };


    public module IntoJSON {

        public func fromArray<X>(a: [X], elemIntoJSON : X -> Text) : Text {
            var result = "[\n";
            var isFirst = true;
            for (elm in (a.vals())) {
                if (isFirst) {
                    isFirst := false;
                } else {
                    result #= ",\n";
                };
                result #= elemIntoJSON(elm);
            };
            result # "\n]"
        };

        #[test]
        func testArray() {
            let actual = fromArray([1, 2, 3], func(x) { debug_show x });
            let expected = "[\n1,\n2,\n3\n]";
            assert actual == expected
        };

        public func fromObjects(input : [SceneObject]) : Text {
            fromArray(input, fromObject)
        };

        public func fromEvents(input : [SceneObject]) : Text {
            fromArray(input, fromEvent)
        };

        public func fromScene( s : Scene ) : Text {
            let nodesText = "{}";
            let edgesText = "{}";
            "{ " # 
            "\"objects\" : \n" # fromObjects(s.objects) # "\n,\n" #
            "\"outline\" : \n" # fromOutline(s.outline) # "\n,\n" #
            "\"events\": \n" # fromEvents(s.events) # "\n,\n" #
            "\"nodes\": \n" # nodesText # "\n,\n" #
            "\"edges\": \n" # edgesText # "\n\n" #
            "}"
        };
   
        public func fromObject( o : Object ) : Text {
            switch o {
                case (#box(fields)) {
                    "{ \"type\": \"box\""#
                    ", \"position\": "#(debug_show [fields.position.x, fields.position.y, fields.position.z])#
                    ", \"label\": "#(debug_show fields.label_)#
                    ", \"textLines\": "#(debug_show fields.textFields)#
                    ", \"pointerFields\": "#(debug_show fields.pointerFields)#
                    ", \"nodeIds\": " #(debug_show fields.nodeIds)#
                    "}"
                };
                case (#pointer(fields)) {
                    "{ \"type\": \"pointer\", \"from\": " # (debug_show fields.from) # 
                    ", \"to\": " # (debug_show fields.to) # 
                    "}"
                }
            };
        };

        public func fromEvent( ev : Event ) : Text {
                switch(ev.event) {
                    case (#addNode(node_id)) {
                            "{ \"metaTime\":" # (debug_show ev.metaTime) # 
                            ", \"type\": \"addNode\", \"nodeId\": " # (debug_show (debug_show node_id)) #
                            "}"
                    };
                    case (#addEdge(edge_id)) {
                            "{ \"metaTime\":" # (debug_show ev.metaTime) # 
                            ", \"type\": \"addEdge\", \"edgeId\": " # (debug_show (debug_show edge_id)) #
                            "}"
                    };
                    case (#removeEdge(edge_id)) {
                            "{ \"metaTime\":" # (debug_show ev.metaTime) #
                            ", \"type\": \"removeEdge\", \"edgeId\": " # (debug_show (debug_show edge_id)) #
                            "}"
                    };
                    case (#forceBegin(node_id)) {
                            "{ \"metaTime\":" # (debug_show ev.metaTime) # 
                            ", \"type\": \"forceBegin\", \"nodeId\": " # (debug_show (debug_show node_id)) #
                            "}"
                    };
                    case (#forceEnd(node_id, edge_id)) {
                            "{ \"metaTime\":" # (debug_show ev.metaTime) # 
                            ", \"type\": \"forceEnd\", \"nodeId\": " # (debug_show (debug_show node_id)) # 
                            ", \"edgeId\": " # (debug_show (debug_show edge_id)) #
                            "}"
                    };
                }
            };
        
        public func fromNodeId(nodeId : NodeId) : Text {
            debug_show (debug_show nodeId)
        };

        public func fromNodeShape(nodeShape : NodeShape) : Text {
            debug_show (debug_show nodeShape)
        };

        public func fromShowAction(showAction : ShowAction) : Text {
            debug_show (debug_show showAction)
        };

        public func fromOutlineEdges(outlineEdges : [OutlineEdge]) : Text {
            fromArray(outlineEdges, fromOutlineEdge)
        };

        public func fromAnyValue(v : Any) : Text {
            debug_show (debug_show v)
        };

        public func fromOutline(outline : Outline) : Text {
            switch outline {
                case (#leaf(leaf)) {
                    "{ \"type\": \"outlineLeaf\" " #
                    ", \"nodeId\":" # (fromNodeId(leaf.nodeId)) #
                    ", \"shape\": " # (fromNodeShape(leaf.shape)) #
                    ", \"value\": " # (fromAnyValue(leaf.value)) #
                    "}"

                };
                case (#internal(internal)) {
                    "{ \"type\": \"outlineInternal\" " #
                    ", \"nodeId\":" # (fromNodeId(internal.__nodeId)) #
                    ", \"shape\": " # (fromNodeShape(internal.__shape)) #
                    ", \"edges\":" # 
                        (if (internal.edges.size() == 0) "" else "\n" ) #
                        (fromOutlineEdges(internal.edges)) #
                    //", \"metaTimes\": " # (fromMetaTimes(internal.metaTimes)) #
                    ", \"value\": " # (fromAnyValue(internal.value)) #
                    "}"
                };
            }
        };

        public func fromOutlineOption(outline : ?Outline) : Text {
            switch outline {
                case null "null";
                case (?o) { "\n" # fromOutline(o) }
            }
        };

        public func fromMetaTimes( metaTimes: MetaTimes) : Text {
            if (metaTimes.0 == metaTimes.1) {
                debug_show metaTimes.0
            } else {
                debug_show ([metaTimes.0, metaTimes.1])
            }
        };

        public func fromOutlineEdge(edge : OutlineEdge) : Text {
            "{ \"type\": \"outlineEdge\" " #
            ", \"action\":" # (fromShowAction(edge.action)) #
            ", \"actionTarget\":" # (fromNodeId(edge.actionTarget)) #
            ", \"outline\": " # (fromOutlineOption(edge.outline)) #
            ", \"value\": " # (fromAnyValue(edge.value)) #
            ", \"metaTimes\": " # fromMetaTimes(edge.metaTimes) #
            "}"
        };
    };
};
