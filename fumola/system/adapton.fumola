import Map "../collections/hashMap";
import Prim "prim";

/// Adapton's structures represented within Fumola.
///
///    A Fumola library or algorithm can use this interface to reflect its
/// own past behavior back to it, and process it into useful output
/// for interactive replay (web-based DCG Player).
///
/// - PeekInfo --- Fumola values that describe Adapton behavior and structures.
///
/// - Outline --- A depth-first structure over PeekInfo at some root.
///
/// - IntoText --- For outline printouts that are compact, and textual.
///
/// - Scene --- A multi-dimensional structure for exporting into a playback tool.
///
/// - IntoJSON --- JSON format for web-based playback tools. 
///                Useful line breaks for VSCode mode.
///
/// ----------------------------------------------------------------------------
module {

    /// PeekInfo gives the fumola value-based types for the
    /// internal state of Adapton within Fumola.
    ///
    /// Specifically, these types follow the output of the 
    /// PeekValue trait (in Rust) within the  
    /// graphical representation of the Adapton cache.
    ///
    public module PeekInfo {
        public type NodeHistoryItem = {
            nodeId : NodeId;
            metaTime: MetaTime;
            node : Node; 
        };
        
        public type EdgeHistoryItem = {
            edgeId : EdgeId;
            metaTime: MetaTime;
            edge : Edge
        };
        
        public type EventHistoryItem = {
            metaTime: MetaTime;
            event: Event;
        };
        
        public type Events = [EventHistoryItem];
        public type Nodes = [NodeHistoryItem];
        public type Edges = [EdgeHistoryItem];

        public type History = {
            events : Events;
            nodes : Nodes;
            edges : Edges;
        };
        
        public type Event = {
            #addNode : NodeId;
            #addEdge : EdgeId;
            #updateEdge : EdgeId;
            // A re-evaluated thunk's old trace leaving the live graph. Emitted by repair.
            #removeEdge : EdgeId;
            // The edge by which the thunk was demanded, and the meta time of the cached
            // result when this force found one. (Corrected to what the runtime emits;
            // these two used to be documented as a NodeId and a pair.)
            #forceBegin : (EdgeId, ?MetaTime);
            #forceEnd : EdgeId;
            // Realignment. A put that changes a cell with readers *signals*: between these
            // two, the edges that observed the old contents, and the force edges upstream of
            // them, are marked signaled. The node is the new version the put made.
            #signalingBegin : NodeId;
            #signalingEnd : NodeId;
            #edgeSignaled : EdgeId;
            // A force of a thunk whose trace holds a signaled edge *repairs*: between these
            // two its edges are checked in order, and either all realign or the thunk is
            // re-evaluated as a new version. The outcome says which.
            #repairBegin : NodeId;
            #repairEnd : (NodeId, RepairOutcome);
            #edgeAligned : EdgeId;
        };

        public type RepairOutcome = { #aligned; #reevaluated };

        // The status of an edge: aligned with the graph, or signaled that it may not be.
        public type Align = { #aligned; #signaled };
        
        public type MetaTime = Nat;
       
        public type Time = { #time : Symbol }; // --- TO DO
        public type Space = { #space : Symbol }; // --- TO DO
        public type Pointer = Space;

        // TO DO --
        // public type NodeId = { #nodeId : (Pointer, Time, MetaTime) };
        public type NodeId = (Space, Time, MetaTime);
       
        public type EdgeId = { #edgeId : Nat };

        public type Node = {
            #nonThunk : Any;
            #thunk_ : ThunkNode;
        };

        public type ThunkNode = {
            body : Thunk<Any>;
            trace : [ EdgeId ];
            result : ?(MetaTime, Any);
            space : Space;
        };

        // meta time intervals (begin, end) where begin <= end.
        public type MetaTimes = (MetaTime, MetaTime);

        public type Edge = {
            source : NodeId;
            target : NodeId;
            action : Action;
            metaTimes : MetaTimes;
            align : Align;
        };

        public type Action = {
            #forceBegin : Any; // forced thunk can have any type.
            #force_ : (Any, Any); // forced thunk and result can be any types.
            #put : Any;
            #get : Any;
        };

        public type NodeInfo = {
            node : Node;
            nodeId : NodeId;
            incomingEdges : [(EdgeId, Edge)];
            outgoingEdges : [(EdgeId, Edge)];
        };
    };

    //
    // Diff'ing a pair of histories by looking at final node values.
    //  
    public module Diff {
        // Node value (for a meaningful diff):
        //
        // To diff two runs, we focus on comparing each node pointer's nodes.
        // For each node, ignore the edgeIds and metaTimes of each node,
        // (edgeIds and metaTimes are each transient and do not affect cache reuse),
        // and focus on the non-thunk value, or thunk-value and possible result value.
        public type NodeVal = {
            #nonThunk : Any;
            #_thunk : (Any, ?Any);
        };

        // NodeVals is the map we want to diff.
        // Each NodeVals map represents the outcome of a sequence of events, ignoring metaTimes and edgeIds.
        public type NodeVals = Map<Pointer, NodeVal>;

        // When two NodeVals maps disagree, we can represent their diff as a pairing:
        // When analyzing the stability of an algorithm, it can be helpful to analyze
        // the patterns within these disagreements, when they arise.
        public type NodeValPairs = Map<Pointer, (NodeVal, NodeVal)>;

        // The result of diffing two event histories is multi-dimensional:
        public type NodeValsDiff = {
            // --- input of diff ---
            left : NodeVals;
            right: NodeVals;
            // --- output of diff ---
            onlyLeft : NodeVals;
            onlyRight : NodeVals;
            equal : NodeVals;
            notEqual : NodeValPairs;
        };

        public func nodeValFromNode(node : PeekInfo.Node) : NodeVal {
            switch node {
                case (#thunk_(t)) {
                    // to do -- Option.right
                    let result = switch (t.result) {
                        case null null;
                        case (?(_l, r)) ?r;
                    };
                    #thunk_(t.body, result)
                };
                case (#nonThunk(v)) {
                    #nonThunk(v)
                };
            }
        };

        public func nodeValsFromNodes(nodes : PeekInfo.Nodes) : NodeVals {
            var nodeVals = Map.new();
            for (node in nodes.vals()) {
                let pointer = (node.nodeId.0).0;
                let nodeVal = nodeValFromNode(node.node);
                let (nodeVals_, _) = Map.put(nodeVals, pointer, nodeVal);
                nodeVals := nodeVals_;
            };
            nodeVals
        };

        public func nodeValsDiff(left : NodeVals, right : NodeVals) : NodeValsDiff
        {
            var onlyLeft = Map.new();
            var onlyRight = Map.new();
            var equal = Map.new();
            var notEqual = Map.new();

            // process left to populate everything except onlyRight.
            for ((p, v) in left.vals()) {
                let rightVal = Map.get(right, p);
                switch rightVal {
                    case null {
                        let (onlyLeft_, null) = Map.put(onlyLeft, p, v);
                        onlyLeft := onlyLeft_;
                    };
                    case (?rightVal) {
                       if (v == rightVal) {
                            let (equal_, null) = Map.put(equal, p, v);
                            equal := equal_;
                        } else {
                            let (notEqual_, null) = Map.put(notEqual, p, (v, rightVal));
                            notEqual := notEqual_;
                        }
                    }
                };
            };
            
            // process right after left to populate onlyRight.
            for ((p, v) in right.vals()) {
                if (Map.get(left, p) == null) {
                    let (onlyRight_, null) = Map.put(onlyRight, p, v);
                    onlyRight := onlyRight_;
                }
            };
            {
                left;
                right;
                onlyLeft;
                onlyRight;
                equal;
                notEqual;
            }
        };
    };

    /// Reading the graph where it lies, without converting it into Fumola values.
    ///
    ///    `peekHistory` answers with the whole history as ordinary Fumola values: arrays of
    /// records, every node's thunk body among them. That is what a scene wants -- a program
    /// that draws its own past behaviour has to be able to walk it -- and it is what a diff
    /// cannot afford, because a diff only wants to know which pointers disagree, and pays for
    /// the conversion of every node before it can ask.
    ///
    ///    These operations keep the history and the node maps on the Rust side, as the
    /// runtime's own structures, and answer with a value that Fumola can hold but not look
    /// inside. What comes back from a diff is numbers, which is what measurement wants.
    ///
    ///    Measured on mergeSort at size 1000, removing the highest-level cell; release build,
    /// medians of three. Two runs and no diff at all cost 28.78 s and 478 MB of peak memory;
    /// with the Fumola-side diff, 31.85 s and 1472 MB; with this one, 28.93 s and 575 MB. So
    /// the diffing itself went from 3.07 s and 994 MB to **0.15 s and 97 MB** -- 20x faster,
    /// and a tenth of the memory.
    ///
    ///    On a whole sample the two runs dominate the clock, so a sample is only 1.10x faster.
    /// What it is, is 2.56x smaller in peak memory, and memory is what killed the sweeps: the
    /// size-1000 average-case runs died at 10.2 GB. See `docs/native-diff.md`.
    ///
    ///    `Diff.nodeValsDiff` is still the way to ask *which* cells differ: it answers with the
    /// four maps, and `webPlay.pair` colours a comparative example from them. Drawing wants the
    /// maps; measurement wants the numbers and no allocation. Both stay.
    public module Native {

        /// A run's event history, as the runtime holds it. Opaque: the point of it is to not be
        /// converted. `IntoJSON` and the scene functions take the `PeekInfo.History` that
        /// `peekHistory` answers with instead.
        public type History = Any;

        /// Every pointer a run named and what it last held. Opaque, and the operand of `diff`.
        public type NodeVals = Any;

        /// What two runs' node maps say, as numbers.
        ///
        ///    The four categories of `Diff.NodeValsDiff`, and `notEqual` split three ways --
        /// which the Fumola side cannot do without walking the pairs itself. The split is the
        /// distinction realignment turns on: a thunk whose *body* differs was named again for a
        /// different closure, so a repair must evaluate it as it would a cell with no
        /// counterpart; a thunk whose body is the same and whose *result* differs is repair
        /// proper. On mergeSort at size 1000, 99% of `notEqual` is `notEqualNewBody`.
        public type DiffCounts = {
            left : Nat;
            right : Nat;
            onlyLeft : Nat;
            onlyRight : Nat;
            equal : Nat;
            notEqual : Nat;
            notEqualNewBody : Nat;
            notEqualSameBody : Nat;
            notEqualNonThunk : Nat;
        };

        /// The history so far, shared rather than copied.
        public func history() : History {
            prim "adaptonHistory" ()
        };

        /// The node map of a history: the last version of every pointer in it.
        public func nodeVals(h : History) : NodeVals {
            prim "adaptonHistoryNodeVals" h
        };

        /// The node map of the run so far -- `nodeVals(history())`, which is what a sample
        /// takes at the end of each run it means to compare.
        public func nodeValsNow() : NodeVals {
            nodeVals(history())
        };

        /// How many pointers a node map holds.
        public func size(nv : NodeVals) : Nat {
            prim "adaptonNodeValsSize" nv
        };

        /// Compare two node maps.
        public func diff(l : NodeVals, r : NodeVals) : DiffCounts {
            prim "adaptonNodeValsDiff" (l, r)
        };

        /// The native and the Fumola-side diff answer the same question, and this asserts they
        /// answer it the same way on a graph with a thunk, a cell, an edit and a repair in it.
        ///
        ///    A stronger check runs at size 16 over the merge network, in `levelTree`; this one
        /// is here so that the two implementations cannot drift without a test in the module
        /// that defines them both.
        #[test]
        func testAgreesWithTheFumolaSideDiff() {
            let run = func(x : Nat) : (NodeVals, Diff.NodeVals) {
                reset();
                let c = `c := x;
                let t = `t := thunk { let v = @ c; v * 2 };
                let u = `u := thunk { let v = force t; v + 1 };
                let _ = force u;
                (nodeValsNow(), Diff.nodeValsFromNodes(peekHistory().nodes))
            };
            let (nl, fl) = run(1);
            let (nr, fr) = run(2);
            let native = diff(nl, nr);
            let fumola = Diff.nodeValsDiff(fl, fr);
            assert native.left == fl.size();
            assert native.right == fr.size();
            assert native.equal == fumola.equal.size();
            assert native.notEqual == fumola.notEqual.size();
            assert native.onlyLeft == fumola.onlyLeft.size();
            assert native.onlyRight == fumola.onlyRight.size();
            // And the split accounts for exactly the cells that disagree.
            assert native.notEqual ==
                native.notEqualNewBody + native.notEqualSameBody + native.notEqualNonThunk;
        };
    };

    public func reset() {
        prim "adaptonReset" ();
    };

    /// What the runtime knows about the cell `p` points at, without
    /// recording that anything looked.
    public func peekCell(p : Pointer) : ?PeekInfo.NodeInfo {
        prim "adaptonPeekCell" p
    };

    /// The same, for the symbol that names the cell.
    ///
    /// (The parameter is annotated `Pointer` and is in fact a `Symbol`, since
    /// `pointer` is applied to it. Worth correcting; left alone here so that
    /// this change is only about where the primitives live.)
    public func peekInfo(p : Pointer) : ?PeekInfo.NodeInfo {
        peekCell(pointer(p))
    };

    /// Write `value` into the cell `p` points at without recording it: no
    /// dependency, and no edge in the graph.
    ///
    /// The counterpart of `peekCell`. Where `:=` is the archivist's write,
    /// recorded like any other, this is the editor's -- how a layer outside a
    /// computation keeps a tally of what it saw without becoming part of what
    /// it is counting.
    public func poke(p : Pointer, value : Any) {
        prim "adaptonPoke" (p, value)
    };

    #[test]
    func testPeekInfo() {
        let p = 1 := 1;
        Prim.print (debug_show (peekInfo(p)))

        // TO DO
    };

    public func peekForce(p : Pointer) : ?(MetaTime, Any) {
        let nodeInfo = peekInfo(p);
        switch (nodeInfo!.node) {
            case (#thunk_(t)) { t.result };
            case _ { assert false };
        }
    };

    #[test]
    func testPeekForce() {
        let t = `t := thunk { 137 };
        let x = force(t);
        assert x == 137;
        assert ((peekForce(t)).0).1 == 137;
    };

    public func peekHistory() : PeekInfo.History {
        let history = prim "adaptonPeekHistory" ();
	    history
    };

    public func peekEvents() : PeekInfo.Events {
        let history = prim "adaptonPeekHistory" ();
	    history.events
    };

    public func now() : Time {
        prim "adaptonNow" ()
    };

    public func here() : Space {
        prim "adaptonHere" ()
    };

    public func space(s : Symbol) : Space {
        prim "adaptonSpace" s
    };

    /// The time that the symbol `s` names.
    ///
    /// The counterpart of `space`, which was here without it.
    public func time(s : Symbol) : Time {
        prim "adaptonTime" s
    };

    /// The pointer that the symbol `s` names, whether or not anything has
    /// been written there.
    public func pointer(s : Symbol) : Pointer {
        prim "adaptonPointer" (s)
    };

    /// Read the cell that `s` names, recording a dependency on it.
    ///
    /// A tracked operation: it belongs to the archivist, and means what it
    /// says only while a computation is in progress to record it against.
    public func get(s : Symbol) : Any {
        @(prim "adaptonPointer" (s))
    };

    /// Read the cell that `s` names without recording anything. Answers an
    /// option, since the cell may never have been written.
    public func peek(s : Symbol) : ?Any {
        prim "adaptonPeek" (prim "adaptonPointer" (s))
    };

    /// Run a thunk on a branch of the graph: keep what it computed, discard
    /// what it did.
    ///
    ///    This is `peek`'s idea one level further in. A peek reads a cell
    /// without recording that it read it; a scratch runs a whole computation
    /// without the graph keeping any of it. Both are how a layer outside a
    /// computation looks at it without becoming part of what it sees.
    ///
    ///    It exists because portrayal is itself computation. Laying a scene
    /// out -- walking a tree, placing its parts in space -- runs in Fumola and
    /// the graph records it like anything else, and it records far more of it
    /// than of the thing being portrayed: measured on mergeSort, 504 events
    /// for the subject and 2043 by the time it had been drawn. A picture
    /// mostly of itself is not the picture anyone wanted.
    ///
    ///    What the thunk returns comes back. What it wrote does not, and
    /// neither does the graph it built. It is safe inside a force: the whole
    /// state is put back, the enclosing force included, so the force carries
    /// on as though nothing happened. A failure inside is put back too.
    ///
    ///    Two things to know. The names it minted -- node ids, edge ids --
    /// point at nothing afterwards, on purpose: the counters that hand them
    /// out are kept moving forward so that an id which escapes names nothing
    /// rather than naming something else. And a pointer that escapes a
    /// scratch is dangling, so a scene must carry the values it wants to
    /// show, not the pointers to them.
    public func scratch(t) { prim "adaptonScratch" t };

    #[test]
    func testScratchKeepsTheValueNotTheEffects() {
        reset();
        `kept := 41;
        let v = scratch(thunk { `kept := 999; `onlyInScratch := 1; 7 });
        assert v == 7;
        assert peek(`kept) == ?41;
        assert peek(`onlyInScratch) == null;
    };

    #[test]
    func testScratchInsideAForce() {
        reset();
        `x := 3;
        // The enclosing force is part of the state that gets put back, so it
        // carries on as though the branch never happened.
        let r = force(`outer := thunk {
            let a = scratch(thunk { `scribble := 1; 10 });
            a + get(`x)
        });
        assert r == 13;
        assert peek(`scribble) == null;
    };

    /// Realignment, smallest case: a cell with one reader is changed, and the reader's next
    /// force repairs it by re-evaluation. The PLDI 2014 paper's Figure 1, in three cells.
    #[test]
    func testRepairReevaluatesAReader() {
        reset();
        let x = `x := 1;
        let t = `t := thunk { get(`x) + 1 };
        let before = force(t);
        assert before == 2;
        x := 5;
        let after = force(t);
        assert after == 6;
        let signalings = @(`adapton(`counts)(`signalings));
        assert signalings == 1;
        let reevaluations = @(`adapton(`counts)(`reevaluations));
        assert reevaluations == 1;
    };

    /// The cutoff that makes repair cheaper than a re-run: `a` reads `x` and comes to the
    /// same answer regardless, so `t`, which only forces `a`, realigns without re-evaluation.
    /// Algorithm 1 line 12, when the values are equal.
    #[test]
    func testRepairStopsWhereTheValueIsUnchanged() {
        reset();
        let x = `x := 1;
        let a = `a := thunk { get(`x) * 0 };
        let t = `t := thunk { let v = force(a); v + 1 };
        let before = force(t);
        assert before == 1;
        x := 7;
        let after = force(t);
        assert after == 1;
        // `a` was re-evaluated; `t` was not.
        let reevaluations = @(`adapton(`counts)(`reevaluations));
        assert reevaluations == 1;
        // The one edge realigned by comparison is `t`'s edge to `a`.
        let aligned = @(`adapton(`counts)(`edgesAligned));
        assert aligned == 1;
    };

    /// Putting what a cell already holds is a matched put: no new version, nothing signaled,
    /// and the reader's cached result still stands.
    #[test]
    func testMatchedPutSignalsNothing() {
        reset();
        let x = `x := 1;
        let t = `t := thunk { get(`x) };
        let before = force(t);
        assert before == 1;
        x := 1;
        let matched = @(`adapton(`counts)(`putMatched));
        assert matched == 1;
        let signalings = @(`adapton(`counts)(`signalings));
        assert signalings == 0;
        let cells = @(`adapton(`counts)(`cells));
        assert cells == 2;
        let after = force(t);
        assert after == 1;
        let repairs = @(`adapton(`counts)(`repairs));
        assert repairs == 0;
    };

    /// A thunk put again with a different body: its forcers are signaled, and see the new
    /// body on their next force. Nominal Adapton's `Eval-thunkDirty`.
    #[test]
    func testRepairSeesANewThunkBody() {
        reset();
        let a = `a := thunk { 1 };
        let t = `t := thunk { let v = force(a); v * 10 };
        let before = force(t);
        assert before == 10;
        `a := thunk { 2 };
        let after = force(t);
        assert after == 20;
    };

    #[test]
    func testPointerGetPeek() {
        `cell := 41;
        assert get(`cell) == 41;
        assert peek(`cell) == ?41;
        assert peek(`neverWritten) == null;
        // `:=` evaluates to the pointer it wrote, and `pointer` names the
        // same cell, so the two agree.
        assert pointer(`cell) == (`cell := 41);
    };
    #[test]
    func testSpace() {
        assert (debug_show(space(`x)) == "@adaptonSpace (x)")
    };

    #[test]
    func testTopLevelForces() {
        // From a known-empty history, so this counts only its own forces.
        reset();
        `x := 3;
        force(`outer := thunk { let a = force(`inner := thunk { get(`x) * 2 }); a + 1 });
        force(`second := thunk { get(`x) + 100 });
        let roots = Outline.topLevelForced(peekHistory());
        // `outer` and `second`. `inner` was forced from inside `outer`, so it
        // is already in `outer`'s tree and is not a root of its own.
        assert roots.size() == 2;
        assert roots[0] == space(`outer);
        assert roots[1] == space(`second);
        // Forcing something again does not add a second root for it: both
        // name one node, and an outline reads the node as it stands.
        force(pointer(`second));
        assert Outline.topLevelForced(peekHistory()).size() == 2;
    };

    #[test]
    func testPeekEvents() {       
        let p = 1 := 1;
        let pId = (space(1), now(), 1);
        let evs = peekEvents();
        assert (evs.size() == 2);
        assert (evs[0] == { event = #addNode(pId); metaTime = 1});
        assert (evs[1] == { event = #addEdge(#edgeId(1001)); metaTime = 1});

        let t = 2 := thunk { p := 0 };
        let tId = (space(2), now(), 2);
        let pId_ = (space(1), now(), 4);
        
        let evs = peekEvents();
        assert (evs.size() == 4);
        assert (evs[2] == { event = #addNode(tId);           metaTime = 2});
        assert (evs[3] == { event = #addEdge(#edgeId(1002)); metaTime = 2});

        assert((force(t)) == p);

        let evs = peekEvents();
    
        assert (evs.size() == 10);
        assert (evs[4] == {event = #addEdge(#edgeId(1003)); metaTime = 3});
        assert (evs[5] == {event = #forceBegin(#edgeId(1003), null); metaTime = 3});
        assert (evs[6] == {event = #addNode(pId_); metaTime = 4});
        assert (evs[7] == {event = #addEdge(#edgeId(1004)); metaTime = 4});
        assert (evs[8] == {event = #forceEnd(#edgeId(1003)); metaTime = 5});
        assert (evs[9] == {event = #updateEdge(#edgeId(1003)); metaTime = 5});
     
        assert((force(t)) == p);

        let evs = peekEvents();

        assert (evs.size() == 12);
    
        assert (evs[10] == {event = #forceBegin(#edgeId(1005), ?5); metaTime = 6});
        assert (evs[11] == {event = #forceEnd(#edgeId(1005)); metaTime = 6});
      
        // set to true when this test fails to see the correct output
        if false {
            Prim.print (evs.size());
            var count = 0;
            for (ev in evs.vals()) {
                Prim.print (debug_show (count, ev));
                count += 1;
            }
        };
    };

    // helper code:
    // this codifies a simple convention that works when every spatial name
    // is unique enough to stand without its temporal or meta-temporal components.
    public func nodeIdsByLabelFromEvents(evs : [Event]) : Map<Text, [Text]> {
        var map = Map.new();
        for (ev in evs.vals()) {
        switch (ev.event) {
        case (#addNode(nodeId)) {
          let (sp, tm, mt) = nodeId;
          let label_ = (debug_show sp.0);
          switch (Map.get(map, label_)) {
            case null {
              let (map_, _) = Map.put(map, label_, [(debug_show nodeId)]);
              map := map_;
            };
            case (?nodeIds) {
              let (map_, _) = Map.put(map, label_, nodeIds # [(debug_show nodeId)]);
              map := map_;
            }
          }
        };
        case _ {};
        }
        };
        map;
    };

    //
    // Outline representation.
    // - for generating other output file formats (Text, JSON, TikZ).
    // - or directly inspecting within the Fumola REPL.
    // 
    public module Outline {
        public type Outline = {
            #leaf : LeafNode;
            #internal : InternalNode; 
        };
        /// Zero or more outline trees, in the order whoever produced them
        /// chose.
        ///
        ///    A session has one force tree per force begun from outside any
        /// other, so a single tree is the special case rather than the rule.
        /// Anything that carries "the outline" of something carries this, and
        /// `[]` is how it says there is none -- the same way an empty array of
        /// objects says there are none.
        public type Outlines = [ Outline ];
        public type LeafNode = {
            nodeId : NodeId;
            shape : NodeShape;
            value : Any;
        };
	    public type InternalNode = {
            __nodeId : NodeId;      // using __ prefixes to promote in default print order.
            __shape : NodeShape;
            edges : [ OutlineEdge ];
            metaTimes : MetaTimes;
            value : Any;
        };
        public type NodeShape = {
	        #thunk_;
	        #nonThunk;
	    };
        
        // Using the prefix "Outline" to avoid confusion with
        // types of otherwise the same name.

        public type OutlineEdge = {
            action : OutlineAction ;
            actionTarget : NodeId ;
            outline : ?Outline;
            forcedThunk : ?Thunk<Any>;
            value : Any;
            metaTimes : MetaTimes;
        };
        //
        // Just the "tag" of the action, where the other action information
        // is organized into the OutlineEdge type.
        //
	    public type OutlineAction = {
            #put ;
            #putForce ; // same as #put ; #force_ in sequence.
            #get ;
            #force_ 
        };

        public func outline(root: Pointer) : Outline {
            // To do -- 
            // When we have sharing across forces, we'll need to check a "visited set"
            // We skip that detail for now. 2026-05-05.
            outlineRec(root /*, PointerSetObj.new()*/ )
        };

        public func outlineLeaf(p : Pointer) : Outline {
            let nodeInfo = (peekInfo p)!;
	        let nodeId = nodeInfo.nodeId;
            let (shape, value) = switch (nodeInfo.node) {
                case(#nonThunk(value)) { (#nonThunk, value) };
                case(#thunk_(t)) { (#thunk_, t.body) };
            };
            #leaf({
                nodeId;
                shape; 
                value
            })
        };

        public func outlineRec(root : Pointer /*, visited : PointerSetOBj */) : Outline {
            force(`outline(root) := thunk {
            let nodeInfo = (peekInfo root)!;
	        let nodeId = nodeInfo.nodeId;
            switch (nodeInfo.node) {
                case(#nonThunk(value)) {
                    #leaf({
                        nodeId = nodeInfo.nodeId;
                        shape = #nonThunk; 
                        value
                    })
                };
                case(#thunk_(t)) {
                    if (t.trace.size() == 0) {
                        assert (nodeInfo.outgoingEdges.size() == 0);
                        #leaf({
                            nodeId = nodeInfo.nodeId;
                            shape = #thunk_;
                            value = t.result;
                        })
                    } else {
                        var prevEdge = null;
                        var edges = [var ];
                        for ((edgeId, edge) in nodeInfo.outgoingEdges.vals()) {
                            let edgeInfo = edgeActionInfo(edge);
                            let actionTarget = prim "adaptonPointer" (edge.target.0);
                            var outline = null;
                            if (edgeInfo.action == #force_ 
                                /* and not(visited.contains(target)) */ ) {
                                // visited.insert(target);
                                outline := ? outlineRec(actionTarget /*, visited */);
                            } else {
                                outline := ? outlineLeaf(actionTarget);
                            };
                            let metaTimes = edgeInfo.metaTimes;
                            if ( edgeInfo.action == #force_ and
                                prevEdge != null and
                                prevEdge!.action == #put and 
                                prevEdge!.actionTarget == actionTarget  ) {
                                edges[edges.size() - 1] := {
                                    edgeId; // TO DO -- 2026-05-23 -- better to combine two edgeIds into an array here?
                                    actionTarget;
                                    action=#putForce;
                                    outline;
                                    forcedThunk=edgeInfo.forcedThunk;
                                    value=edgeInfo.value;
                                    metaTimes=(prevEdge!.metaTimes.0, metaTimes.1); // TO DO -- 2026-05-23 -- combine into a longer array?
                                }
                            } else { 
                                let edge = {
                                    edgeId;
                                    action=edgeInfo.action;
                                    actionTarget;
                                    outline;
                                    metaTimes;
                                    value=edgeInfo.value;
                                    forcedThunk=edgeInfo.forcedThunk;
                                };
                                edges #= [ edge ];
                                prevEdge := ?edge;
                            }
                        };
                        #internal({
                            __nodeId = nodeId;
                            __shape = #thunk_ ;
                            edges;
                            value = t.result
                            })
                    }
                }
            }
        })};

        // some helper code for re-packaging certain variant-based fields into a uniform, flat record.
        public func edgeActionInfo(edge : Edge) : { 
            action: Action;
            putValue: ?Any; // TODO -- distinguish thunks and non-thunks
            forcedThunk: ?Thunk<A>;
            metaTime: MetaTime;
        } {
          switch (edge.action) {
            case(#put(value)) {{action=#put; value; forcedThunk=null; metaTimes=edge.metaTimes}};
            case(#get(value)) {{action=#get; value; forcedThunk=null; metaTimes=edge.metaTimes}};
            case(#force_(t, value)) {{action=#force_; value; forcedThunk=?t; value; metaTimes=edge.metaTimes}};
            }
        };

        //
        // Every force tree in a session, not just the one you name.
        //
        //   A session forces several thunks over its life, and each force
        // begun from outside any other is the root of its own tree. The ones
        // begun from inside are already somewhere in a root's tree, so an
        // outline of them would be a repeat of part of one.
        //
        //   Which are which is already in the event list: a `#forceBegin`
        // seen while no force is in progress is a root. Nothing needs to ask
        // the runtime how deep it is; counting begins against ends says it.
        //

        /// The force edges begun while no other force was in progress.
        public func topLevelForceEdges(h : PeekInfo.History) : [EdgeId] {
            var depth = 0;
            var roots = [];
            for (item in h.events.vals()) {
                switch (item.event) {
                    case (#forceBegin(edgeId, _cacheHit)) {
                        if (depth == 0) { roots #= [edgeId] };
                        depth += 1
                    };
                    // Guarded because a history can begin mid-force: peeking
                    // during a run, or a reset that dropped the begins.
                    case (#forceEnd(_)) { if (depth > 0) { depth -= 1 } };
                    case _ { };
                }
            };
            roots
        };

        /// The pointer a force edge leads to.
        ///
        /// First match wins: an edge appears once per meta-time it changed at,
        /// and they all lead to the same node.
        public func forceEdgeTarget(h : PeekInfo.History, edgeId : EdgeId) : ?Pointer {
            var found = null;
            for (e in h.edges.vals()) {
                if (e.edgeId == edgeId) {
                    switch found {
                        case null { found := ?(e.edge.target.0) };
                        case _ { };
                    }
                }
            };
            found
        };

        /// Every pointer forced from outside, in the order first forced.
        ///
        /// Without repeats: forcing the same thunk again is a second root
        /// event, but both roots name one node, and an outline reads the node
        /// as it stands now -- so the second would draw the same tree twice.
        public func topLevelForced(h : PeekInfo.History) : [Pointer] {
            var seen = [];
            for (edgeId in topLevelForceEdges(h).vals()) {
                switch (forceEdgeTarget(h, edgeId)) {
                    case (?p) {
                        var already = false;
                        for (q in seen.vals()) { if (q == p) { already := true } };
                        if (not already) { seen #= [p] }
                    };
                    case null { };
                }
            };
            seen
        };

        /// One outline per top-level force, in the order they were forced.
        ///
        /// The pointer each grew from is not returned beside it: a tree's root
        /// nodeId is already inside the tree.
        public func outlines() : Outlines {
            var out = [];
            for (p in topLevelForced(peekHistory()).vals()) {
                out #= [ outline(p) ]
            };
            out
        };
    };

    public module IntoText { 
        func indentText(n : Nat) : Text {
            if (n == 0) { "" } else 
            if (n == 1) { " " } else {
            " ┆" # (indentText(n - 1))
            }
        };

        public func outlineRec(o : Outline, indent : Nat) : Text {
            switch o {
                case (#leaf(n)) { debug_show (n.nodeId.0) };
                case (#internal(n)) {
                    var text = debug_show (prim "adaptonPointer" (n.__nodeId.0));
                    for (edge in n.edges.vals()) {
                        text #= "\n" # (edgeIntoText(edge, indent + 1));
                    };
                    text # "\n" 
                    # indentText(indent + 1)
                    # "╰〜〜> " # (debug_show n.value)
                }
            }
        };

        public func actionIntoUnicode(action : OutlineAction) : Text {
            switch action {
                case (#put)      { "───» " };
                case (#get)      { "───> " };
                case (#putForce) { "══▷» " };
                case (#force_)   { "═══▷ " };
            }
        };

        public func metaTimesIntoText(mts : MetaTimes) : Text {
            if (mts.0 == mts.1) { "(" # debug_show (mts.0) # ")" }
            else { debug_show mts }
        };

        public func edgeIntoText(edge : OutlineEdge, indent : Nat) : Text {
            indentText(indent) # "├" # metaTimesIntoText(edge.metaTimes) # (
            switch (edge.outline) {
                case null {
                    actionIntoUnicode(edge.action) # 
                    debug_show(edge.actionTarget)
                };
                case (?internalOutline) {
                    actionIntoUnicode(edge.action) # 
                      /* debug_show edge.actionTarget # */
                      outlineRec(internalOutline, indent);
                }
            })
        };

        public func outline(o : Outline) : Text {
            outlineRec(o, 0) # "\n"
        };

        /// A forest, one tree after another.
        ///
        /// Each tree already begins with the name of what was forced, so
        /// nothing is added to tell them apart -- a session reads as the
        /// things it forced, in the order it forced them.
        public func outlines(os : Outline.Outlines) : Text {
            var text = "";
            for (o in os.vals()) { text #= outline(o) };
            text
        };
    };

    public module Scene {
        public type SceneObject = {
            #orb : LabeledObject;
            #box : LabeledObject;
            #action : ActionEdge;
            #pointer : Edge;
        };
        public type LabeledObject = {
            label_ : Label;
            // nodeIds: [Text]; // <-- 2026-07-06 Remove this.
            position : Vec3;
            textFields : Text;
            pointerFields : [Text]
        };
        public type Label = Text;
        public type Edge = { from : Label ; to : Label };
        public type Pointer = Edge;
        public type ActionEdge = { action: SceneAction; from: Label; to:Label } /* and Edge */ ;
        public type SceneAction = Outline.OutlineAction;

        public type Vec3 = { x : Float; y : Float; z : Float };
        public let zero = { x = 0.0; y = 0.0; z =0.0 };
        public func vec3Add(v : Vec3, w : Vec3) : Vec3 = {
            x = v.x + w.x;
            y = v.y + w.y;
            z = v.z + w.z; 
        };
     
        public type Scene = {
            objects : [ SceneObject ];
            outline : Outline.Outlines;
            history : {
                events : [PeekInfo.History.Event];
                nodes : [PeekInfo.History.Node];
                edges : [PeekInfo.History.Edge];
            };
        };
    };


    public module IntoJSON {

        public func fromArray<X>(a: [X], elemIntoJSON : X -> Text) : Text {
            var result = "[\n";
            var isFirst = true;
            for (elm in (a.vals())) {
                if (isFirst) {
                    isFirst := false;
                } else {
                    result #= ",\n";
                };
                result #= elemIntoJSON(elm);
            };
            result # "\n]"
        };

        #[test]
        func testArray() {
            let actual = fromArray([1, 2, 3], func(x) { debug_show x });
            let expected = "[\n1,\n2,\n3\n]";
            assert actual == expected
        };

        public func fromObjects(input : [SceneObject]) : Text {
            fromArray(input, fromObject)
        };

        public func fromEvents(input : [Event]) : Text {
            fromArray(input, fromEvent)
        };

        public func fromNodeHistoryItems(input : [NodeHistoryItem]) : Text {
            fromArray(input, fromNodeHistoryItem)
        };

        public func fromEdgeHistoryItems(input : [EdgeHistoryItem]) : Text {
            fromArray(input, fromEdgeHistoryItem)
        };

        public func fromScene( s : Scene ) : Text {
            let nodesText = "{}";
            let edgesText = "{}";
            "{ " # 
            "\"objects\" : \n" # fromObjects(s.objects) # "\n,\n" #
            "\"outline\" : \n" # fromOutlines(s.outline) # "\n,\n" #
            "\"events\": \n" # fromEvents(s.history.events) # "\n,\n" #
            "\"nodes\": \n" # fromNodeHistoryItems(s.history.nodes) # "\n,\n" #
            "\"edges\": \n" # fromEdgeHistoryItems(s.history.edges) # "\n\n" #
            "}"
        };
   
        public func fromObject( o : Object ) : Text {
            //prim "print" o;
            switch o {
                case (#box(fields)) {
                    "{ \"type\": \"box\"" #
                    ", \"position\": " # debug_show [fields.position.x, fields.position.y, fields.position.z] #
                    ", \"label\": " # debug_show fields.label_ #
                    ", \"textLines\": " # debug_show fields.textFields #
                    ", \"pointerFields\": " # debug_show fields.pointerFields #
                    // ", \"nodeIds\": " # debug_show fields.nodeIds #
                    "}"
                };
                case (#orb(fields)) {
                    "{ \"type\": \"orb\"" #
                    ", \"position\": " # debug_show [fields.position.x, fields.position.y, fields.position.z] #
                    ", \"label\": " # debug_show fields.label_ #
                    ", \"textLines\": " # debug_show fields.textFields #
                    ", \"pointerFields\": " # debug_show fields.pointerFields #
                    // ", \"nodeIds\": " # debug_show fields.nodeIds #
                    "}"
                };
                case (#pointer(fields)) {
                    "{ \"type\": \"pointer\", \"from\": " # debug_show fields.from # 
                    ", \"to\": " # debug_show fields.to # 
                    "}"
                };
                case(#action(fields)) {
                   "{ \"type\": " # fromShowAction(fields.action) #
                    ", \"from\": " # debug_show fields.from # 
                    ", \"to\": " # debug_show fields.to # 
                    ", \"edgeId\": " # fromEdgeId(fields.edgeId) #
                    "}"
                };
            };
        };

        public func fromEvent( ev : Event ) : Text {
                "{ \"metaTime\":" # debug_show ev.metaTime  # 
                (switch(ev.event) {
                    case (#addNode(node_id)) {
                            ", \"type\": \"addNode\", \"nodeId\": " # fromNodeId(node_id)
                    };
                    case (#addEdge(edge_id)) {
                            ", \"type\": \"addEdge\", \"edgeId\": " # fromEdgeId(edge_id)
                    };
                    case (#updateEdge(edge_id)) {
                            ", \"type\": \"updateEdge\", \"edgeId\": " # fromEdgeId(edge_id)
                    };
                    case (#removeEdge(edge_id)) {
                            ", \"type\": \"removeEdge\", \"edgeId\": " # fromEdgeId(edge_id)
                    };
                    case (#forceBegin(edge_id, cache_hit)) {
                            ", \"type\": \"forceBegin\", \"edgeId\": " # fromEdgeId(edge_id) #
                            (switch cache_hit {
                                case null ", \"cacheMiss\": true";
                                case (?meta_time) {
                                ", \"cacheHit\": " # (debug_show meta_time)
                                };
                            })
                    };
                    case (#forceEnd(edge_id)) {
                            ", \"type\": \"forceEnd\"" # 
                            ", \"edgeId\": " # fromEdgeId(edge_id)
                    };
                    // Realignment: the two bracketed traversals and their per-edge steps.
                    case (#signalingBegin(node_id)) {
                            ", \"type\": \"signalingBegin\", \"nodeId\": " # fromNodeId(node_id)
                    };
                    case (#signalingEnd(node_id)) {
                            ", \"type\": \"signalingEnd\", \"nodeId\": " # fromNodeId(node_id)
                    };
                    case (#edgeSignaled(edge_id)) {
                            ", \"type\": \"edgeSignaled\", \"edgeId\": " # fromEdgeId(edge_id)
                    };
                    case (#repairBegin(node_id)) {
                            ", \"type\": \"repairBegin\", \"nodeId\": " # fromNodeId(node_id)
                    };
                    case (#repairEnd(node_id, outcome)) {
                            ", \"type\": \"repairEnd\", \"nodeId\": " # fromNodeId(node_id) #
                            ", \"outcome\": " #
                            (switch outcome {
                                case (#aligned) "\"aligned\"";
                                case (#reevaluated) "\"reevaluated\"";
                            })
                    };
                    case (#edgeAligned(edge_id)) {
                            ", \"type\": \"edgeAligned\", \"edgeId\": " # fromEdgeId(edge_id)
                    };
                })
                # "}"
            };
        
        public func fromNodeId(nodeId : NodeId) : Text {
            //debug_show (debug_show nodeId)
            let (sp, tm, mt) = nodeId;
            "[" # debug_show (debug_show (sp.0)) 
            # "," # debug_show (debug_show (tm.0))
            # "," # debug_show (debug_show mt)
            # "]"
        };

        public func fromSpace(sp : Space)  : Text {
            fromAny(sp)
        };

        public func fromAction(action : Action) : Text {
            (switch action {
                case (#force_(t, v)) {
                    "{ \"type\": \"force\" " #
                    ", \"thunk\": " # fromAny(t) #
                    ", \"value\": " # fromAny(v)
                };
                case (#forceBegin(t)) {
                    "{ \"type\": \"forceBegin\" " #
                    ", \"thunk\": " # fromAny(t)
                };
                case (#put(v)) {
                    "{ \"type\": \"put\" " #
                    ", \"value\": " # fromAny(v)
                };
                case (#get(v)) {
                    "{ \"type\": \"get\" " #
                    ", \"value\": " # fromAny(v)
                }}) # "}"
        };
        
        public func fromNode(node : Node) : Text {
            (switch node {
                case (#nonThunk(v)) {
                    "{ \"type\": \"nonThunk\" " #
                    ", \"value\": " # fromAny(v)
                };
                case (#thunk_(thunkNode)) {
                    "{ \"type\": \"thunk\" " #
                    ", \"body\": " # fromAny(thunkNode.body) #
                    ", \"trace\": " # fromArray(thunkNode.trace, fromEdgeId) #
                    ", \"space\": " # fromSpace(thunkNode.space) #
                    ", \"result\": " # (switch (thunkNode.result) {
                        case null "null";
                        case (?(valueMetaTime, value)) {
                            debug_show [valueMetaTime, debug_show value]                
                        }})
                }
            }) # "}"
        };

        public func fromEdge(edge : Edge) : Text {
            "{ \"source\":" # fromNodeId(edge.source) #
            ", \"target\": " # fromNodeId(edge.target) #
            ", \"action\": " # fromAction(edge.action) #
            ", \"metaTimes\": " # fromMetaTimes(edge.metaTimes) #
            "}"
        };

        public func fromNodeHistoryItem(item : NodeHistoryItem) : Text {
            "{ \"metaTime\":" # debug_show item.metaTime  # 
            ", \"nodeId\": " # fromNodeId(item.nodeId) #
            ", \"node\": " # fromNode(item.node) #
            "}"
        };

        public func fromEdgeHistoryItem(item : EdgeHistoryItem) : Text {
            "{ \"metaTime\":" # debug_show item.metaTime  # 
            ", \"edgeId\": " # fromEdgeId(item.edgeId) #
            ", \"edge\": " # fromEdge(item.edge) #
            "}"
        };

        public func fromEdgeId(edgeId : EdgeId) : Text {
            fromAnyValue(edgeId)
        };

        public func fromPointer(ptr : Pointer<Any>) : Text {
            debug_show (debug_show (ptr.0))
        };

        public func fromNodeShape(nodeShape : NodeShape) : Text {
            debug_show (debug_show nodeShape)
        };

        public func fromShowAction(showAction : OutlineAction) : Text {
            debug_show (debug_show showAction);
            debug_show (switch showAction {
                case (#get) "get";
                case (#put) "put";
                case (#putForce) "putForce";
                case (#force_) "force";
            })
        };

        public func fromOutlineEdges(outlineEdges : [OutlineEdge]) : Text {
            fromArray(outlineEdges, fromOutlineEdge)
        };

        public func fromAnyValue(v : Any) : Text {
            debug_show (debug_show v)
        };
        public let fromAny = fromAnyValue;

        public func fromOutline(outline : Outline) : Text {
            switch outline {
                case (#leaf(leaf)) {
                    "{ \"type\": \"outlineLeaf\" " #
                    ", \"nodeId\":" # fromNodeId(leaf.nodeId) #
                    ", \"shape\": " # fromNodeShape(leaf.shape) #
                    ", \"value\": " # fromAnyValue(leaf.value) #
                    "}"

                };
                case (#internal(internal)) {
                    "{ \"type\": \"outlineInternal\" " #
                    ", \"nodeId\":" # fromNodeId(internal.__nodeId) #
                    ", \"shape\": " # fromNodeShape(internal.__shape) #
                    ", \"edges\":" # 
                        (if (internal.edges.size() == 0) "" else "\n") #
                        fromOutlineEdges(internal.edges) #
                    //", \"metaTimes\": " # (fromMetaTimes(internal.metaTimes)) #
                    ", \"value\": " # (switch(internal.value){ case null "null"; case (?(_, v)) fromAnyValue(v) }) #
                    ", \"valueMetaTime\": " # (switch(internal.value){ case null "null"; case (?(mt, _)) fromAnyValue(mt) }) #
                    "}"
                };
            }
        };

        /// A forest, as a JSON array. A consumer that used to receive one
        /// outline object here now receives an array of them; `[]` is the
        /// empty case that `null` used to be.
        public func fromOutlines(outlines : Outlines) : Text {
            fromArray(outlines, fromOutline)
        };

        public func fromOutlineOption(outline : ?Outline) : Text {
            switch outline {
                case null "null";
                case (?o) { "\n" # fromOutline(o) }
            }
        };

        public func fromMetaTimes( metaTimes: MetaTimes) : Text {
            if (metaTimes.0 == metaTimes.1) {
                debug_show metaTimes.0
            } else {
                debug_show ([metaTimes.0, metaTimes.1])
            }
        };

        public func fromOutlineEdge(edge : OutlineEdge) : Text {
            "{ \"type\": \"outlineEdge\" " #
            ", \"edgeId\":" # fromEdgeId(edge.edgeId) #
            ", \"action\":" # fromShowAction(edge.action) #
            ", \"actionTarget\":" # fromPointer(edge.actionTarget) #
            ", \"forcedThunk\":" # (switch (edge.forcedThunk) { case null "null"; case (?t) fromAny(t) })  #
            ", \"outline\": " # fromOutlineOption(edge.outline) #
            ", \"value\": " # fromAnyValue(edge.value) #
            ", \"metaTimes\": " # fromMetaTimes(edge.metaTimes) #
            "}"
        };
    };
};
