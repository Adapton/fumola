import A "adapton";

/// What a program hands to the web playground.
///
///    A scene is three things: an outline, some objects in space, and a
/// history. Only two of them are judgements.
///
///    The history is mechanical. Events, nodes and edges are what the runtime
/// recorded while the program ran, and it can hand them over without being
/// asked and without being told how. Nothing is decided there.
///
///    The outline and the objects are not mechanical. Which force trees are
/// worth looking at, and where the parts of a structure belong in space, are
/// claims about what the computation means -- and the program is the only
/// thing that knows them. A viewer given the history alone can draw a graph;
/// it cannot know that this subtree is the input list and that one is the
/// merge network, or that they should sit a level apart.
///
///    So nothing here is extracted from a program against its will. An
/// `#[example]` is a piece of code opting in, and its author decides what
/// goes in each component. Either may be left empty; an empty component is
/// one the author did not offer, and the playground simply has nothing to
/// show in that panel.
///
///    An example takes `()` and must succeed when applied to `()`. One that
/// does not is not an example, and is a thing for CI and the CLI to report.
///
/// ----------------------------------------------------------------------------
module {

    /// The components of a scene that a program supplies for itself.
    ///
    /// `objects` is `A.Scene.Scene`'s own array of `SceneObject`.
    ///
    /// `outline` is a forest: zero or more outline trees, in the order the
    /// provider chose. A session has one force tree per force begun from
    /// outside any other, so one tree is the special case rather than the
    /// rule, and an example that wants to show two need not choose between
    /// them. `[]` says this example offered no outline, which is what an
    /// empty `objects` says about objects -- one convention rather than two.
    public type SceneComponents = {
        objects : [ A.Scene.SceneObject ];
        outline : A.Outline.Outlines;
    };

    /// What an `#[example]` returns: the components, in a record, directly.
    ///
    ///    No tag around them. A record carrying `objects` and `outline` is
    /// recognisable as a scene by having those fields, and requiring a
    /// wrapper only meant that code already holding the right shape had to
    /// take it apart and put it back together. `A.Scene.Scene` is such a
    /// record already, with a `history` beside them, so a scene built by the
    /// library is one of these without being converted into one.
    public type ExampleOutput = SceneComponents;

    /// Both components.
    public func scene(objects, outline) : ExampleOutput {
        { objects ; outline }
    };

    /// Objects, and no outline.
    public func sceneOfObjects(objects) : ExampleOutput {
        { objects ; outline = [] }
    };

    /// Outlines, and no objects.
    public func sceneOfOutline(outline) : ExampleOutput {
        { objects = [] ; outline }
    };

    /// One tree, for the common case of portraying a single force.
    public func sceneOfOneOutline(outline) : ExampleOutput {
        sceneOfOutline([ outline ])
    };

    /// Every top-level force in the session, outlined, in the order forced.
    ///
    /// The case that needs no decisions: each force begun from outside any
    /// other is the root of its own tree, and all of them are offered.
    public func sceneOfForces() : ExampleOutput {
        sceneOfOutline(A.Outline.outlines())
    };

    /// Two related runs, and what differs between them.
    ///
    ///    What was one panel becomes three. A comparative example answers
    /// with a left run, a right run, and the difference between them --- and
    /// each view a plain example offers has all three: left objects beside
    /// right objects, left outline beside right outline, and for each a
    /// statement of what changed.
    ///
    ///    Both sides are full scenes rather than bare components, because a
    /// difference between two runs is mostly a difference between their
    /// histories, and a component list cannot say what a run did. Each side
    /// therefore has to be produced the way a scene is: reset, run, peek. An
    /// example that does not reset between the two is not comparing two runs,
    /// it is comparing a run against itself continued.
    ///
    ///    `nodes` is the diff that matters for reuse. `A.Diff.nodeValsDiff`
    /// compares the two runs node by node, keyed on the pointer, ignoring
    /// edge ids and meta times because neither affects whether a cached
    /// result can be used. Its four output fields are the measurement: what
    /// only the left run named, what only the right named, what both named
    /// and agreed on, and what both named and disagreed on.
    ///    What crosses is what a viewer reads, and no more. The two runs'
    /// histories are what the diff is computed *from*, not what anyone looks
    /// at, and they dominate the cost of handing a pair over: measured on the
    /// tree pair, 0.81 MB of 1.17 MB, and the whole reply took 232 ms to
    /// serialise against 56 ms to compute. So the diff is reduced here, in
    /// Fumola, to the numbers and the names a viewer needs, and the
    /// histories stay behind. See issue #83.
    ///
    ///    `sizes` gives the four counts; `keys` gives the names of the nodes
    /// that are not simply equal. Neither could be recovered from a `Map`
    /// across a boundary anyway: `A.Diff.NodeVals` has a hidden
    /// representation and arrives as an opaque rendering rather than
    /// something a host can read.
    public type ExamplePairOutput = {
        left : SceneComponents;
        right : SceneComponents;
        sizes : DiffSizes;
        keys : DiffKeys;
    };

    /// The four numbers, and the two totals they came from.
    ///
    /// The maps themselves say which nodes; these say how many, which is what
    /// a panel shows first and what a measurement over many runs collects.
    public type DiffSizes = {
        left : Nat;
        right : Nat;
        onlyLeft : Nat;
        onlyRight : Nat;
        equal : Nat;
        notEqual : Nat;
    };

    public func diffSizes(d : A.Diff.NodeValsDiff) : DiffSizes {
        { left = d.left.size();
          right = d.right.size();
          onlyLeft = d.onlyLeft.size();
          onlyRight = d.onlyRight.size();
          equal = d.equal.size();
          notEqual = d.notEqual.size() }
    };

    /// Which nodes differ, by name, and nothing about the ones that agree.
    ///
    ///    Three lists and an assumption: anything not named here was named by
    /// both runs and they agreed about it. That is the whole diff, because
    /// `equal` is by far the largest of the four categories and the least
    /// worth transmitting -- for the tree pair, 60 of 80 nodes.
    ///
    ///    A name is the same `Text` a scene object carries as its `label_`.
    /// Both come from `debug_show` of the node's pointer, so a host can match
    /// an object against these lists directly, with no second key scheme to
    /// keep in step. `Scene.sceneObjects` and `Diff.nodeValsFromNodes` derive
    /// it from the same expression, which is why the correspondence holds by
    /// construction rather than by care.
    ///
    ///    This is what a host needs in order to say *how* two runs differ,
    /// and it is small: for the tree pair, 4 names and 16 names against the
    /// 0.8 MB the two histories cost. See issue #83.
    public type DiffKeys = {
        leftOnly : [Text];
        rightOnly : [Text];
        notEqual : [Text];
    };

    func namesOf(m : A.Diff.NodeVals) : [Text] {
        var out = [];
        for ((pointer, _) in m.vals()) { out #= [debug_show pointer] };
        out
    };

    func namesOfPairs(m : A.Diff.NodeValPairs) : [Text] {
        var out = [];
        for ((pointer, _) in m.vals()) { out #= [debug_show pointer] };
        out
    };

    public func diffKeys(d : A.Diff.NodeValsDiff) : DiffKeys {
        { leftOnly = namesOf(d.onlyLeft);
          rightOnly = namesOf(d.onlyRight);
          notEqual = namesOfPairs(d.notEqual) }
    };

    /// Two scenes, paired, with the node diff computed from their histories.
    ///
    /// The caller produces each side; this only relates them. Which two runs
    /// are worth comparing is a judgement, like the rest of an example.
    public func pair(left : A.Scene.Scene, right : A.Scene.Scene) : ExamplePairOutput {
        let nodes = A.Diff.nodeValsDiff(
            A.Diff.nodeValsFromNodes(left.history.nodes),
            A.Diff.nodeValsFromNodes(right.history.nodes));
        { left = { objects = left.objects ; outline = left.outline };
          right = { objects = right.objects ; outline = right.outline };
          sizes = diffSizes(nodes);
          keys = diffKeys(nodes) }
    };

    /// How much of the larger run the difference covers: the share of nodes a
    /// repair would have to touch, were repair implemented.
    ///
    /// `onlyLeft + onlyRight + notEqual` over the larger of the two runs.
    /// Nodes both runs named and agreed on are the ones a repair gets for
    /// free, so they are what this measures against.
    public func diffFraction(d : A.Diff.NodeValsDiff) : Float {
        let s = diffSizes(d);
        let changed = s.onlyLeft + s.onlyRight + s.notEqual;
        let total = if (s.left >= s.right) { s.left } else { s.right };
        if (total == 0) { 0.0 } else { (0.0 + changed) / (0.0 + total) }
    };

    /// An example's components, plus the history the runtime kept: an
    /// `A.Scene.Scene`, exactly as that type stands.
    ///
    /// No longer optional. `Scene.outline` is a forest now (#66), so any
    /// number of trees fits, and without the tag the components are already
    /// the fields a Scene wants.
    ///
    /// Call this from outside the example, after it has run, so the history
    /// is the one the example produced. An example that lays itself out
    /// inside `A.scratch` keeps that history to the subject rather than to
    /// the drawing of it.
    public func withHistory(e : ExampleOutput) : A.Scene.Scene {
        { outline = e.outline ; objects = e.objects ; history = A.peekHistory() }
    };

}
