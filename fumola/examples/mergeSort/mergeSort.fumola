import Seq "levelTree";
import LazyList "LazyList";
import List "List";
import A "adapton";
import R "randomInput";

module {
    public func report( outputs ) {
        //
        // For now, just report about the
        // comparison counts and the related input trees' depths.
        //
        prim "print" "";
        prim "print" "## SeqTree input metrics";
        for (run in (outputs[0].1).vals()) {
            prim "print" {
                _A_size = run.size;
                _B_depth = run.inputSeqMetrics.depth;
                _C_comparisonCount = run.counts.comparisonCount;
            };
        };
    };
    public func demandSym(demand) = switch demand {
                case null `full;
                case (?#one) `one;
                case (?#half) `half;
            };

    // Canonical scene components for mergeSort at full demand.
    //
    // todo -- edits would be more general if it had type ?(List_<Nat> -> ())
    //         that is, when it takes the head pointer, not the list head directly.
    //         that pointer doesn't exist yet in our scene; just the head thunk.
    public func sceneComponentsFullDemand(seed : Nat, size : Nat, edits: ?(List<Nat> -> ())) {
        `scene := thunk {
        let inputArray = R.generateRandomInput(seed, size);
        let inputList_ = `ListFromRandomArray := thunk {
            do within space `inputList {
                List.fromIter(inputArray.vals())
            }
        };
        let inputList = force(inputList_);
        do ? { edits!(inputList) };
        let inputTree_ =
          `LevelTreeFromList := thunk {
            do within space `inputTree {
                Seq.fromList(inputList)
            };
        };
        let inputTree = force(inputTree_);
        let lazySorted_ = 
            do within space `lazyMergeSort {
                Seq.lazyMergeSort_(inputTree)
            };
        let sorted = LazyList.takeN_(lazySorted_, size);
        let components = {
            inputArray;
            inputList_;
            inputList;
            inputTree_;
            inputTree;
            lazySorted_;
            sorted;
        };
        // this may be a useless field indirection
        { components };
        } 
    };

    public func generateSceneFullDemand(seed : Nat, size : Nat, edits: ?List<Nat> -> ()) {
        A.reset(); // reset so history only contains our components.
        let scene_ = sceneComponentsFullDemand(seed, size, edits);
        let scene = force(scene_);
        let history = A.peekHistory();

        // - - - - Create 3D objects that represent each component - - - - -
        // Positioning algorithm: 
        // Step 1: input tree is oriented first, and its positions determine the positions
        // of its producer and consumer orbs.
        let inputTreeObjects =
            Seq.Scene.sceneObjects(scene.components.inputTree!,
            { x = 0.0; y = 0.0; z = 0.0});

        // Step 2: we use the height of the tree to determine the gaps between structures.
        let inputTreeGeom2d = Seq.Scene.geom2d(scene.components.inputTree!);
        let height = inputTreeGeom2d.height;
        let e = 2.71828;
        let levelGap = height * e;
     
        // Step 3: the input list sits at depth levelGap;
        let inputListObjects =
            List.sceneObjectsFromThunk(scene.components.inputList_,
            { x = 0.0 - (size + 0.0) / 2.0 ; y = 5.0; z = levelGap});

        // Step 4: tree-from-list orbs:
        // the orbs that produce the input tree from the list sit between it, at depth levelGaph / 2.0.
        // these orbs have interesting sub-structures and sub-cases,
        // ...each with a geometric spacing parameter of type Vec3.
        let inputTreeFromListObjects =
            Seq.Scene.sceneObjectsFromList(A.Outline.outline(scene.components.inputTree_),
            { x = 0.0; y = 0.0; z = levelGap / 2.0}, {
                binary = { x = 0.0; y = 0.0; z = levelGap / 2.0};
                leafL = { x = -(0.2 * e); y = -0.1 * e; z = 1.0};
                leafR = { x =  (0.2 * e); y = -0.1 * e; z = 1.0};
            });

        // Step 5 -- constants that represent empty structures (List and LazyList).
        //
        // Step 5(a) -- constant pointer created by the tree-of-list procedure for initializing the accumlator:
        //
        let inputTree_NilList = 
            #box{
                label_="inputTree(`(nilList))";
                position = {x=0; y=0; z=levelGap / 2.0};
                textFields=""; pointerFields=""
            };

        //
        // Step 5(b) -- constant pointer created by the mergeSort algorithm:
        //
        let lazyMergeSort_NilList = 
            #orb{
                label_="lazyMergeSort(`(nilList))";
                position = {x=0; y=-1; z=-levelGap};
                textFields=""; pointerFields=""
            };

        //
        // Step 6 -- merge network: orbs that merge two incoming sorted streams into an output stream.
        //
        // - the `reduce` gap orients the reduction tree orbs to the input tree.
        // - the `merge` gap orients the next orb in a sorted lazy list to the prior one.
        //   each orb merges two sorted input lists into this lazy list, as the sorted output.
        //
        let mergeGap = 1.0;
        let lazyMergeSort =
            Seq.Scene.sceneObjectsLazyMergeSort_(A.Outline.outline(scene.components.lazySorted_),
            { x = 0.0; y = 1.618 * height; z = -levelGap/2.0 },
            {
                reduce = { x = 0; y = 1; z = -levelGap/2.0; };
                merge = { x =  0.0; y = 0.0; z = -mergeGap };
            });

        let outline = A.Outline.outline(scene_);
        let sceneData = {
            history ;
            outline ;
            objects = inputListObjects 
                    # inputTreeFromListObjects
                    # [inputTree_NilList]
                    # inputTreeObjects
                    # lazyMergeSort
                    # [lazyMergeSort_NilList]
                    ;
        };
        if (false) {
            let outlineText = A.IntoText.outline(outline);
            prim "writeFile" (`mergeSort
                            -`FullDemand
                            -`seed-seed
                            -`size-size
                            -`Outline-`txt, outlineText);
        };
        // this step (generating JSON Text) takes about half of the runtime.
        if (true) {
            let sceneText = A.IntoJSON.fromScene(sceneData);
            prim "writeFile" (`mergeSort
                            -`FullDemand
                            -`seed-seed
                            -`size-size
                            -`Scene-`json, sceneText);
        };
        {
            sceneData ;
            components = scene.components ;
        }
    };

    #[test]
    public func testGenerateSceneFullDemand() {
        let scene = generateSceneFullDemand(10, 10, null).sceneData;
        // set to true when this test fails to see the new values and compare.
        if true { prim "print" (debug_show ({
            _0_eventsSize = scene.history.events.size();
            _1_nodesSize = scene.history.nodes.size();
            _2_edgesSize = scene.history.edges.size();
            _3_objectsSize = scene.objects.size();
            _4_finalMetaTime = ((scene.outline.1).0).value!.0;
        }))};
        assert scene.history.events.size() == 522;
        assert scene.history.nodes.size() == 193;
        assert scene.history.edges.size() == 280;
        assert scene.objects.size() == 291;
        assert ((scene.outline.1).0).value!.0 == 307; // Final Meta Time.
    };
            
    public func dcg(seed : Nat, size : Nat, demand) {
        let inputArray = R.generateRandomInput(seed, size);
        let inputSeq = 
        // do @ `SeqFromArray {
          Seq.fromArray(inputArray);
        // }
        // do @ `lazyMergeSortDemand {
        let sorted = Seq.lazyMergeSort(inputSeq);
        let result = switch (demand) {
            case (null) { LazyList.takeAll(sorted) };
            case (?#all) { LazyList.takeAll(sorted) };
            case (?#one) { LazyList.takeOne(sorted) };
            case (?#quarter) { LazyList.takeN(sorted, size / 4) };
            case (?#half) { LazyList.takeN(sorted, size / 2) };
            case (?#frac(f)) { LazyList.takeN(sorted, size * f) };
        };
        {
            inputArray;
            inputSeq;
            sorted;
            result
        }
        // }
    };

    #[test]
    func testDcg() {
        let dcg = dcg(10, 10, null);
    };

    public func writeDcgText(seed : Nat, size : Nat, demand) {
        prim "adaptonReset" ();
        let dcg = dcg(seed, size, demand);
        let outline = A.Outline.outline(dcg.sorted);
        let text = A.IntoText.outline(outline);
        prim "writeFile" (`demand-demandSym(demand)-`size-size-`seed-seed-`DCG-`txt, text); 
    };

    #[test]
    func testDcgText() {
        writeDcgText(10, 10, null);
    };

    public func runRandom(seed : Nat, size : Nat, enableCache, demand) {
        prim "adaptonReset" ();
        if (not enableCache) {
            `adapton(`settings)(`forceBeginAlwaysMisses) := true
        };
        assert (enableCache == (not (@ (`adapton(`settings)(`forceBeginAlwaysMisses)))));
        //
        // Build input sequence, as a tree.
        //
        let inputArray = R.generateRandomInput(seed, size);
        let inputSeq = Seq.fromArray(inputArray);
        let inputBuildCounts = @(`adapton(`counts));
        //
        // Compute some input metrics.
        //
        let inputSeqMetrics = Seq.metrics(inputSeq!);
        assert (inputSeqMetrics.size == size);
        let postInputMetricsCounts = @(`adapton(`counts));
        //
        // Record the input tree as TikZ for a LaTeX report, if applicable.
        //
        Seq.writeTikzText(`mergeSort-`inputSeq-`seed-seed-`size-size-`TikZ, inputSeq);
        let postInputWriteCounts = @(`adapton(`counts));
        //
        // Demand-driven (lazy) MergeSort on the input tree.
        //
        let sorted = Seq.lazyMergeSort(inputSeq);
        let preDemandCounts = @(`adapton(`counts));
        let result = switch (demand) {
            case (null) { LazyList.takeAll(sorted) };
            case (?#all) { LazyList.takeAll(sorted) };
            case (?#one) { LazyList.takeOne(sorted) };
            case (?#quarter) { LazyList.takeN(sorted, size / 4) };
            case (?#half) { LazyList.takeN(sorted, size / 2) };
            case (?#frac(f)) { LazyList.takeN(sorted, size * f) };
        };
        let postDemandCounts = @(`adapton(`counts));
        let comparisonCount = (prim "adaptonPeek" (prim "adaptonPointer" (`merge)))!;
        let counts = { comparisonCount;
                       inputBuildCounts;
                       postInputMetricsCounts;
                       postInputWriteCounts;  
                       preDemandCounts;
                       postDemandCounts
                     };
        let res = { seed; size; counts; demand; inputSeqMetrics };
        res
    };

    #[test]
    public func testRunRandom() {
        let res = runRandom(10, 10, true, null);
        assert res.size == 10;
        // prim "print" (debug_show res.counts.postDemandCounts);
        assert true or res.counts.postDemandCounts == ({
            cells = 57;
            force_begin = 47;
            force_begin_cache_hit = 9;
            force_begin_cache_miss = 38;
            force_end = 38;
            get = 57;
            non_thunk_cells = 19;
            put = 57;
            put_delay = 0;
            thunk_cells = 38})
    };

    public func runAll() {
        let demands = [null, ?#one, ?#half]; // param?
        var outputs = [];
        for (demand in demands.vals()) {
            var output = [];
            for (sizes in [[3,5,7,10,11,13,17,21,23],
                           [25,33,50,75,100,125,150,175],
                           // [200,250,300,350,400,450],[500,750],
                           // [1000],[1500],[2000],[2500],[5000]
                       ].vals()) {
                prim "print" { demand ; sizes };
                for (size in sizes.vals()) {
                    if (size <= 33) {
                        writeDcgText(R.defaultSeed, size, demand)
                    };
                    let data = runRandom(R.defaultSeed, size, true, demand);
                    output  #= [ data ];
                    //
                    // At small sizes, re-run without a cache
                    // and assert that there's no difference: 
                    // Our MergeSort algorithm forces each thunk
                    // at most once.
                    //
                    if (size < 100) {
                      let data_ = runRandom(10, size, false, demand);
                      assert (data_.counts.comparisonCount ==
                              data.counts.comparisonCount)
                    }
                }
            };
            outputs #= [(demand, output)];
        };
        
        // Prepare ouput files.
        for ((demand, output) in outputs.vals()) {
            var sizes = "";
            var depths = "";
            var comparisonCounts = "";
            for (out in output.vals()) {
               sizes #= ((debug_show out.size) # "\n");
               depths #= ((debug_show out.inputSeqMetrics.depth)) # "\n";
               comparisonCounts #= ((debug_show out.counts.comparisonCount) # "\n");
            };
            let demand = demandSym(demand);
            prim "writeFile" (`demand-demand-`size-`dat, sizes);
            prim "writeFile" (`demand-demand-`depth-`mdat, depths);
            prim "writeFile" (`demand-demand-`comparisonCount-`dat, comparisonCounts);
        };

        report(outputs);

        return outputs
    }
}
 