import Counters "Counters";
import A "../system/adapton";
import W "../system/webPlay";
import Prim "../system/prim";

module {

  #[listing(23)]
  public type LazyListCell<X> = {
    element : X;
    symbol : Symbol;
    next : LazyList_<X>;
  };

  #[listing]
  public type LazyList<X> = ?LazyListCell<X>;
  
  #[listing]
  public type LazyList_<X> = Pointer<Thunk<LazyList<X>>>;

  /// Merge two sorted streams, naming each continuation for the element that
  /// won the comparison which produced it.
  ///
  ///    The name is the winner's symbol alone, so the caller is expected to
  /// have opened a namespace for the reduction node this merge belongs to --
  /// see `lazyMergeSort_`. Both halves of that name move when the input is
  /// edited: the tree reshapes, and the winner at a given position changes.
  /// Very little of the network survives. `mergeCartesian` is the alternative
  /// that does, and it is the same computation.
  #[listing(69)]
  public func mergeInductive(xs : LazyList<X>, ys : LazyList<X>) : LazyList<X> {
    switch (xs, ys) {
      case (_, null) xs;
      case (null, _) ys;
      case (?xc, ?yc) {
        Counters.inc `merge;
        if (xc.element <= yc.element) {
          ?{ 
              element=xc.element;
              symbol=xc.symbol;
              next = xc.symbol := thunk { mergeInductive(force(xc.next), ?yc) }
           }
        } else {
          ?{
              element=yc.element;
              symbol=yc.symbol;
              next = yc.symbol := thunk { mergeInductive(?xc, force(yc.next)) }
            }
        }
      };
    }
  };

  /// The same merge, naming each continuation for the pair of symbols whose
  /// comparison produced it.
  ///
  ///    A merge network never compares the same two symbols twice, so the pair
  /// is a name no other cell can claim. That is the property any naming
  /// strategy for a dataflow graph has to have, and having it here is what
  /// lets this one do without a namespace per reduction node -- the namespace
  /// was what kept names apart before, and it is also what made them move
  /// under an edit.
  ///
  ///    The pair is ordered `xs` before `ys`, which is already canonical:
  /// `xs` is the left subtree and `ys` the right, so the `xs` side is always
  /// earlier in the input list. Removing some other element reshapes the tree
  /// but does not reorder what remains, so two elements are compared under the
  /// same name in both runs. That is the whole point -- the name of a
  /// comparison outlives an edit that does not touch its operands.
  #[listing(69)]
  public func mergeCartesian(xs : LazyList<X>, ys : LazyList<X>) : LazyList<X> {
    switch (xs, ys) {
      case (_, null) xs;
      case (null, _) ys;
      case (?xc, ?yc) {
        Counters.inc `merge;
        // Named before the branch: the pair is the same comparison whichever
        // of the two wins it.
        //
        //    Application, not `-`. `-` is overloaded and these symbols are
        // usually numbers, so `(xc.symbol)-(yc.symbol)` is arithmetic: every
        // comparison of adjacent elements comes out as -1, the network
        // collapses onto a handful of names, and the list it builds is cyclic.
        // Application cannot be read that way, and it is structural, so
        // 1(13) and 11(3) stay apart.
        let compared = (xc.symbol)(yc.symbol);
        if (xc.element <= yc.element) {
          ?{ 
              element=xc.element;
              symbol=xc.symbol;
              next = compared := thunk { mergeCartesian(force(xc.next), ?yc) }
           }
        } else {
          ?{
              element=yc.element;
              symbol=yc.symbol;
              next = compared := thunk { mergeCartesian(?xc, force(yc.next)) }
            }
        }
      };
    }
  };

  func objectFromEdge(source, port, (edgeId, edge)) : A.Scene.SceneObject {
    // prim "print" (debug_show edge.edgeId);
    let x = A.Outline.edgeActionInfo(edge);
    #action{ from = source # ":" # port; 
             to = debug_show (edge.target.0).0;
             action = x.action;
             edgeId;
    } 
  };

  #[listing(88)]
  public func sceneObjectsMergeSortStream<X>(list : Pointer<Thunk<List<X>>>, position : Vec3, offset : Vec3) : SceneObjects {
    let label_ : Text = (debug_show list);
    var objs : SceneObjects = [];
    let cell = A.peekForce(list);
    let nodeInfo = A.peekInfo(list);
    //prim "print" nodeInfo;
    //prim "print" (nodeInfo!.outgoingEdges);
    if (nodeInfo!.outgoingEdges.size() == 2) {
      //prim "print" "xxx";
      
      let forceMergeEdge = nodeInfo!.outgoingEdges[0];
      //prim "print" forceMergeEdge;
      let forceMergeObj = objectFromEdge(label_, "forceMerge", forceMergeEdge);
      //prim "print" forceMergeObj;

      let putMergeEdge = nodeInfo!.outgoingEdges[1];
      //prim "print" forceMergeEdge;
      let putMergeObj = objectFromEdge(label_, "putMerge", putMergeEdge);
      //prim "print" forceMergeObj;
  
      objs := objs # [ forceMergeObj, putMergeObj ];
    };
    let cellPos = A.peekInfo(`position(list));
    if (cellPos != null) { return [] }; // we've already processed this tail of the stream.
      // Continue only if the stream isn't processed yet; avoid duplicates.
    let (textFields : Text, pointerFields : Text, isNilList :?Bool) = 
      switch (cell) {
        case null { 
          `position(list) := position;
          ("(unforced)", [], null)
        };
        case (?(_, null)) { ("null", [], ?true); };
        case (?(_, ?cons)) {
          `position(list) := position;
          objs #= [ #pointer ( {from=label_# ":next"; to=(debug_show cons.next)}) ];
          let nextPosition = A.Scene.vec3Add(position, offset);
          objs #= sceneObjectsMergeSortStream(cons.next, nextPosition, offset);
          ("symbol=" # (debug_show cons.symbol) # "\nelement=" # (debug_show cons.element),
           ["forceMerge", "putMerge", "next"], ?false) 
        };
      };
    if (isNilList != (?true)) {
      [#orb({label_; position; textFields; pointerFields })] # objs
    } else { objs }
  };

  // #[test]
  func testSceneObjectMergeSortStream() {
    let s = testStreamNats();
    //prim "print" s;
    let out = sceneObjectsMergeSortStream(s, A.Scene.zero, A.Scene.zero);
    assert out.size() == 1;
    //prim "print" (debug_show out);
    assert out[0].1!.textFields == "(unforced)";
    let _ = takeN_(s, 3);
    let out = sceneObjectsMergeSortStream(s, A.Scene.zero, {x=0.0;y=0.0;z=1.0});
    Prim.print (debug_show out);
    assert out.size() == 5;
    assert out[4].1!.textFields == "null";
  };


  #[listing]
  public func takeN(l : LazyList<X>, len : Nat) : [(Symbol, X)] {
    if (len == 0) { return [] };
    switch (force l) {
      case null [];
      case (?lc) {
        [(lc.symbol, lc.element)] # takeN(lc.next, len - 1)
      }
    }
  };

  #[listing]
  public func takeN_(l : LazyList_<X>, len : Nat) : ([(LazyList_<X>, Symbol, X)], LazyList_<X>) {
    if (len == 0) { return ([], l) };
    switch (force l) {
      case null ([], l);
      case (?lc) {
        let (arr, last) = takeN_(lc.next, len - 1);
        ([(l, lc.symbol, lc.element)] # arr, last)
      }
    }
  };

  func testStreamNats() : LazyList_<Nat> {
    let p3 = `p3 := thunk { null };
    let p2 = `p2 := thunk { ?{symbol=2; element=2; next=p3}};
    let p1 = `p1 := thunk { ?{symbol=1; element=1; next=p2}};
    p1
  };

  /// A lazy list of three, taken from, and how to look at it.
  ///
  /// Derived from `testTakeN_`: the same three thunks, and the same walk over
  /// them. Taking from a lazy list forces it one cell at a time, so the
  /// outline is the shape of that demand -- which is the thing about a lazy
  /// list worth seeing.
  ///
  ///    An outline and no objects, deliberately. The only layout function for
  /// a lazy stream is `sceneObjectsMergeSortStream`, and it is for a stream
  /// that is merging: it displaces each cell by an offset meant to separate
  /// the parts of a merge. This list merges nothing, so there is no offset
  /// that would mean anything, and passing `zero` puts every cell at the
  /// origin on top of the others. Offering no objects is the honest answer
  /// until a lazy list has a layout of its own.
  #[example]
  public func exampleLazyList() : W.ExampleOutput {
    let p3 = `p3 := thunk { null };
    let p2 = `p2 := thunk { ?{symbol=2; element=2; next=p3}};
    let p1 = `p1 := thunk { ?{symbol=1; element=1; next=p2}};
    let _ = takeN_(p1, 7);
    A.scratch(thunk { W.sceneOfOneOutline(A.Outline.outline(p1)) })
  };

  #[test]
  public func testTakeN_() {
    let p3 = `p3 := thunk { null };
    let p2 = `p2 := thunk { ?{symbol=2; element=2; next=p3}};
    let p1 = `p1 := thunk { ?{symbol=1; element=1; next=p2}};
    let (array, last) = takeN_(p1, 7);
    assert array == [(p1, 1, 1), (p2, 2, 2)];
    assert last == p3;
  };

  #[listing]
  public func takeAll(l : LazyList<X>) : [(Symbol, X)] {
    switch (force l) {
      case null [];
      case (?lc) {
        [(lc.symbol, lc.element)] # takeAll(lc.next)
      }
    }
  };

  #[listing]
  public func takeOne(l : LazyList<X>) : [(Symbol, X)] {
    switch (force l) {
      case null [];
      case (?lc) {
        [(lc.symbol, lc.element)]
      }
    }
  };

}