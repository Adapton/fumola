  #[listing]
  public func append_<X>(
    genSym : GenSymThk,
    left : ?LevelTree_<X>, right : ?LevelTree_<X>
  ) : ?LevelTree_ {
    // prim "print" (debug_show (force genSym));
    switch (left, right) {
      case (null, _) right;
      case (_, null) left;
      case (?l, ?r) {
        append(genSym, @ l, @ r)
      }
    }
  };

  public func genSymsFrom(s : Symbol, n : Nat) : GenSymThk {
    thunk { (s-n, genSymsFrom(s, n + 1))}
  };

  #[test]
  public func testAppend() {
    let (lSize, rSize) = (3, 3);
    let left = fromArray(R.generateRandomInput(10, lSize));
    let right = fromArray(R.generateRandomInput_(10, lSize, rSize));

    Prim.print (debug_show (intoArray(left), intoArray(right)));

    let out = append_(genSymsFrom(`x, 0), left, right);
    Prim.print out;
  };

  #[listing(62)]
  public func lazyMergeSort<X>(t : ?SeqTree_<X>) : LazyList_<X> {
    let nilList = `(nilList) := thunk { null };
    if (t == null) { return nilList };
    `result := thunk {
      reduceUp(
        @(t!),
        null,
        func(symbol:Symbol, element:X) : LazyList<X> {
         ?{ symbol; element; next = nilList }
        },
        func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
         do within space (`merge-symbol) {
           LazyList.merge(xs, ys)
         }
      },
     )
    }
  };

  #[listing(62)]
  public func lazyMergeSort_<X>(t : ?SeqTree_<X>) : LazyList_<X> {
    let nilList = `(nilList) := thunk { null };
    if (t == null) { return nilList };
    `result := thunk {
      reduce_(
        t!,
        null,
        func(symbol:Symbol, element:X) : LazyList<X> {
         ?{ symbol; element; next = nilList }
        },
        func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
         do within space (`merge-symbol) {
           LazyList.merge(xs, ys)
         }
      },
     )
    }
  };

  public func intoArray<X>(tree : ?SeqTree_<X>) : [(Symbol, X)] {
    if (tree == null) { return [] };
    reduceUp(@(tree!), [], func(s,x){[(s,x)]}, func(_,l,r){l # r})
  };

  public func fromArray<X>(array : [(Symbol, X)]) : ?SeqTree_<X> {
    fromPureList(pureList.fromIter(array.vals()))
  };

  #[listing]
  public func fromPureList<X>(list : PureList<X>) : ?SeqTree_<X> {
    do ? {
      let {symbol; element; next} = list!;
      let level = Prim.symbolLevel symbol;
      let (tree, nil) = fromPureListRec(next, symbol-`element := #element {symbol; element}, null);
      assert (nil == null);
      tree
    }
  };

  #[listing]
  func fromPureListRec<X>(list : PureList<X>, left : SeqTree_<X>, parentLevel : ?Nat) : (SeqTree_<X>, PureList<X>) {
    switch list {
      case null (left, null);
      case (?{symbol; element; next}) {
        let level = Prim.symbolLevel symbol;
        if (levelLte(level, parentLevel)) {
          let rightLeft = symbol-`element := #element {symbol; element};
          let (right, next) = fromPureListRec(next, rightLeft, ?level);
          let left = symbol-`binary := #binary {symbol; level; left; right};
          fromPureListRec(next, left, parentLevel)
        } else {
          (left, list)
        }
      };
    }
  };


  #[listing]
  public func fromList<X>(list : List<X>) : ?SeqTree_<X> {
    do ? {
      let {symbol; element; next} = list!;
      let level = Prim.symbolLevel symbol;
      let nilList = `(nilList) := null;
      let (tree, nilList_) = fromListRec(next, symbol-`element := #element {symbol; element}, null, nilList);
      assert (nilList == nilList_);
      tree
    }
  };

  #[listing]
  func fromListRec<X>(list : List_<X>, left : SeqTree_<X>, parentLevel : ?Nat, nil : List_) : (SeqTree_<X>, List_<X>) {
    switch (@ list) {
      case null (left, nil);
      case (?{symbol; element; next}) {
        let level = Prim.symbolLevel symbol;
        if (levelLte(level, parentLevel)) {
          let rightLeft = symbol-`element := #element {symbol; element};
          let (right, next) = force (symbol-`rec1 := thunk { fromListRec(next, rightLeft, ?level, nil) });
          let left = symbol-`binary := #binary {symbol; level; left; right};
          force ( symbol-`rec2 := thunk { fromListRec(next, left, parentLevel, nil) } );
        } else {
          (left, list)
        }
      };
    }
  };

  #[test]
  public func testFromList() {
    let array = R.generateRandomInput(10, 10);
    fromList(List.fromIter(array.vals()))
  };

  #[listing]
  func levelLte(level : Nat, parentLevel : ?Nat) : bool {
    switch parentLevel {
      case null true;
      case (?p) level <= p;
    }
  };

  func max(a, b) {
    if (a > b) { a } else { b }
  };

  func indentText(n : Nat) : Text {
    if (n == 0) { "" } else {
      "  " # (indentText(n - 1))
    }
  };

  public func tikzText<X>(tree : SeqTree_<X>, n : Nat) : Text {
    switch (@ tree) {
      case (#empty) { "emptyNode\n" };
      case (#element(e)) {
        indentText(n) # "[{\\SeqTreeElement" #
        "{" # (debug_show e.symbol) # "}" #
        "{" # (debug_show e.element) # "}}]\n"
      };
      case (#binary(b)) {
        indentText(n) # "[\n" #
        indentText(n + 1) # "{\\SeqTreeBinaryNode" #
        "{" # (debug_show b.symbol) # "}" #
        "{" # (debug_show b.level) # "}" #
        "}\n" #
        tikzText(b.left, n + 1) #
        tikzText(b.right, n + 1) #
        indentText(n) # "]\n"
      };
    }
  };

  public func writeTikzText<X>(path : Symbol, tree : ?Pointer<SeqTree<X>>) {
    let ?() = do ? {
      let firstPart = "\\begin{forest}\n";
      let lastPart = "\\end{forest}\n";
      Files.write (path, firstPart # tikzText(tree!, 0) # lastPart)
    };
  };

  func abs(x : Int) : Nat {
    if (x < 0) -x else x
  };

  #[listing]
  public func metrics<X>(tree : Pointer<SeqTree<X>>) {
    switch (@ tree) {
      case (#empty) { { depth=1; size=0; hasEmpty=true} };
      case (#element(e)) { { depth=1; size=1; hasEmpty=false } };
      case (#binary(b)) {
        let ml = metrics(b.left);
        let mr = metrics(b.right);
        { 
          depth = max(ml.depth, mr.depth) + 1; 
          size = ml.size + mr.size;
          hasEmpty = ml.hasEmpty or mr.hasEmpty;
        }
      };
    }
  };

  public module Index {
    //
    // The number of leaf nodes.
    // used by the index-based edit operations in Edit module.
    //
    #[listing]
    public func size<X>(tree : ?LevelTree_<X>) : Nat {
      do goto space (`levelTree(`Index)(`size)) {
        reduceUp(@(tree!), 0, func(_,_) { 1 }, func(_,l,r){l + r})
      }
    };
  };

  public module Edit {

  };

  public module Scene {

  public type Geom2D = {
    height : Nat;
    width : Nat;
    widthLeft : Nat;
    widthRight : Nat;
  };

  public func writeSceneFile(file : Symbol, seed : Nat, size : Nat) {
    let a = R.generateRandomInput(seed, size);
    let t = fromArray(a);
    // let evs = A.peekEvents();
    // let nodeIdsByLabel = A.nodeIdsByLabelFromEvents(evs);
    let objs = sceneObjects(t!, A.Scene.zero);
    let text = A.IntoJSON.fromObjects(objs);
    Files.write (file, text)
  };

  #[test]
  public func testWriteSceneFile() {
    writeSceneFile(`testWriteSceneFile, 10, 10)
  };

  func objectFromEdge(source, port, edge) : A.Scene.SceneObject {
    // prim "print" (debug_show edge.edgeId);
    #action{ from = source # ":" # port; 
             to = debug_show edge.actionTarget;
             action = edge.action;
             edgeId = edge.edgeId;
    } 
  };

  public func sceneObjectsFromList(outline, position, offsets) : A.Scene.SceneObjects {
    func sceneObjectsFromList_(outline, position) : A.Scene.SceneObjects {
      switch (outline) {
        case (#leaf(n)) { assert false };
        case (#internal(n)) {
          let label_ = (debug_show ((n.__nodeId.0).0));
          switch (n.edges.size()) {
            case 1 { 
              //
              // various base cases land here.
              // use position for the orb object.
              //
              [#orb { label_; position; textFields = ""; pointerFields = ["get"]}] #
              [objectFromEdge(label_, "get", n.edges[0])]
            };
            case 5 { 
              let position = @ ((`position)(n.edges[3].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.binary);
              let positionL = A.Scene.vec3Add(position, offsets.leafL);
              let positionR = A.Scene.vec3Add(position, offsets.leafR);
      
              // most common (binary) recursive case lands here.
              // use position of the target of n.edges[3] for orb object.
              // re-set position for each sub-case using logic like in original binary tree layout.
              [#orb { label_; position; textFields = ""; pointerFields = [
                "get", "putE", "rec1", "putB", "rec2"
              ]}] #
              [ 
                objectFromEdge(label_, "get", n.edges[0]),
                objectFromEdge(label_, "putE", n.edges[1]),
                objectFromEdge(label_, "rec1", n.edges[2]),
              ] #
              sceneObjectsFromList_(n.edges[2].outline!, positionL)
              # [ 
                objectFromEdge(label_, "putB", n.edges[3]),
                objectFromEdge(label_, "rec2", n.edges[4])
              ] #
              sceneObjectsFromList_(n.edges[4].outline!, positionR)
            };
            case 7 { 
              let position = @ ((`position)(n.edges[1].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.binary);
              let positionL = A.Scene.vec3Add(position, offsets.leafL);
              let positionR = A.Scene.vec3Add(position, offsets.leafR);
              
              // special case for the top of the recursion.
              // similar to case 5 except for extra two initial steps: 
              //  - intialize a local copy of the empty input/output list,
              //  - and put the first list element into an initial leaf-element tree. 
              [#orb { label_; position; textFields = ""; pointerFields = [
                "putN", "putE1", "get", "putE2", "rec1", "putB", "rec2"
              ]}] #
              [ 
                objectFromEdge(label_, "putN", n.edges[0]),
                objectFromEdge(label_, "putE1", n.edges[1]),
                objectFromEdge(label_, "get", n.edges[2]),
                objectFromEdge(label_, "putE2", n.edges[3]),
                objectFromEdge(label_, "rec1", n.edges[4]),
              ] #
              sceneObjectsFromList_(n.edges[4].outline!, positionL)
              # [
                objectFromEdge(label_, "putB", n.edges[5]),
                objectFromEdge(label_, "rec2", n.edges[6])
              ] #
              sceneObjectsFromList_(n.edges[6].outline!, positionR)
            };
            case _ { 
              assert false
            };
          };
        };
      }
    };
    sceneObjectsFromList_(outline, position)
  };
  

  /// A tree built from a list, and both ways of looking at it.
  ///
  /// Derived from `testSceneObjectsFromList`, which already computed exactly
  /// this and then discarded it. Two layouts are concatenated: `sceneObjects`
  /// places the tree, and `sceneObjectsFromList` places the list it was built
  /// from, displaced by real offsets so the two do not sit on top of one
  /// another. The outline is the force tree that built it.
  /// The same as `exampleTreeFromList`, over symbols that carry entropy.
  ///
  /// One call different, for the reason given on
  /// `exampleLevelTreeRandomSymbols`.
  #[example]
  public func exampleTreeFromListRandomSymbols() : W.ExampleOutput {
    let array = R.generateRandomInputSymbols(10, 10);
    let buildList = `buildList := thunk { List.fromIter(array.vals()) };
    let list = force buildList;
    let buildTree = `buildTree := thunk { fromList(list); };
    let tree = force buildTree;
    A.scratch(thunk {
      let outline = A.Outline.outline(buildTree);
      let offsets = {
        binary = { x = 0.0; y = 0.0; z = 5.0};
        leafL  = { x = -0.5; y = -0.25; z = 1.0};
        leafR  = { x =  0.5; y = -0.25; z = 1.0};
      };
      W.scene(
        sceneObjects(tree!, A.Scene.zero) # sceneObjectsFromList(outline, A.Scene.zero, offsets),
        [ outline ]
      )
    })
  };

  #[example]
  public func exampleTreeFromList() : W.ExampleOutput {
    let array = R.generateRandomInput(10, 10);
    let buildList = `buildList := thunk { List.fromIter(array.vals()) };
    let list = force buildList;
    let buildTree = `buildTree := thunk { fromList(list); };
    let tree = force buildTree;
    A.scratch(thunk {
      let outline = A.Outline.outline(buildTree);
      let offsets = {
        binary = { x = 0.0; y = 0.0; z = 5.0};
        leafL  = { x = -0.5; y = -0.25; z = 1.0};
        leafR  = { x =  0.5; y = -0.25; z = 1.0};
      };
      W.scene(
        sceneObjects(tree!, A.Scene.zero) # sceneObjectsFromList(outline, A.Scene.zero, offsets),
        [ outline ]
      )
    })
  };

  #[test]
  public func testSceneObjectsFromList() {
    let array = R.generateRandomInput(10, 10);
    let buildList = `buildList := thunk { List.fromIter(array.vals()) };
    let list = force buildList;
    let buildTree = `buildTree := thunk { fromList(list); };
    let tree = force buildTree;
    let outline = A.Outline.outline(buildTree);
    let sceneObjects1 = sceneObjects(tree!, A.Scene.zero);
    let offsets = {
          binary = { x = 0.0; y = 0.0; z = 5.0};
          leafL = { x = -0.5; y = -0.25; z = 1.0};
          leafR = { x =  0.5; y = -0.25; z = 1.0};
    };
    let sceneObjects2 = sceneObjectsFromList(outline, A.Scene.zero, offsets);
    let sceneObjects = sceneObjects1 # sceneObjects2;
    let _ = A.IntoJSON.fromObjects(sceneObjects);
    { array; sceneObjects }
  };

  #[listing(88)]
  public func sceneObjectsLazyMergeSort_(outline, position, offsets) {
   func rec_(outline, position) : A.Scene.SceneObjects {
      switch (outline) {
        case (#leaf(n)) { assert false };
        case (#internal(n)) {
          let label_ = (debug_show ((n.__nodeId.0).0));        
          switch (n.edges.size()) {
            // the setup for the recursion creates a nil output element,
            // and then recurs according to reduce(tree, nil, singleton, merge)
            case 2 { 
              assert false;
              // TODO -- use this case in our tests.

              let position = @(`position(n.edges[1].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.reduce);
              [#orb { label_; position; textFields = ""; pointerFields = [
                "putNil", "reduceRoot"
                ]}] #
              [ 
                objectFromEdge(label_, "putNil", n.edges[0]),
                objectFromEdge(label_, "reduceRoot", n.edges[1]),
              ] #
              rec_(n.edges[1].outline!, position)
            };
            case 4 {
              let position = @(`position(n.edges[0].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.reduce);
              let positionM = A.Scene.vec3Add(position, offsets.merge);
              [
                #orb { label_; position; textFields = ""; pointerFields = [
                "getBinary", "recL", "recR", "putMerge"
                ]},
                objectFromEdge(label_, "getBinary", n.edges[0]),
                objectFromEdge(label_, "recL", n.edges[1]),
              ] #
              rec_(n.edges[1].outline!, position) #
              [
                objectFromEdge(label_, "recR", n.edges[2])
              ] #
              rec_(n.edges[2].outline!, position) #
              [
                objectFromEdge(label_, "putMerge", n.edges[3])
              ] #
              LazyList.sceneObjectsMergeSortStream(n.edges[3].actionTarget,
                  positionM, offsets.merge)
            }; 
            case 1 {
              let position = @(`position(n.edges[0].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.reduce);
              [
                #orb { label_; position; textFields = ""; pointerFields = [
                "getElement",
                ]},
                objectFromEdge(label_, "getElement", n.edges[0]),
              ]
            };
            case arity {
              Prim.print arity; 
              assert false
            };
          };
        };
      }
    };
    rec_(outline, position)
  };

  #[listing]
  public func sceneObjects<X>(tree : Pointer<SeqTree<X>>, origin : Vec3) : SceneObjects {
    let g = geom2d(tree);
    let label_ : Text = (debug_show tree);
    let position : Vec3 = {y = origin.y + g.height * 1.618; x = origin.x; z = origin.z};
    `position(tree) := position;
    var objs : SceneObjects = [];
    let (textFields : Text, pointerFields : Text) = 
      switch (@ tree) {
        case (#empty) { ("#empty", []) };
        case (#element(e)) { (
          "#element\n\tsymbol="#(debug_show e.symbol)#"\n\telement="#(debug_show e.element), []) 
        };
        case (#binary(b)) { 
          objs #= [
            #pointer ( {from=label_# ":left"; to=(debug_show b.left)}),
            #pointer ( {from=label_# ":right"; to=(debug_show b.right)})
          ];
          assert (g.width == (g.widthLeft + g.widthRight));
          objs #= sceneObjects(b.left, {x=origin.x - (g.widthRight * 0.5); y=origin.y; z=origin.z});
          objs #= sceneObjects(b.right, {x=origin.x + (g.widthLeft * 0.5); y=origin.y; z=origin.z});
          ("#binary\n\tsymbol=" # (debug_show b.symbol) # "\n\tlevel=" # (debug_show b.level),
           ["left", "right"]) 
        };
      };
    [#box({label_; position; textFields; pointerFields })] # objs
  };

  #[test]
  public func testSceneObjects() {
    let a = R.generateRandomInput(10, 10);
    let t = fromArray(a);
    let objs = sceneObjects(t!, A.Scene.zero);
    assert (objs.size() == 37);
    let last = objs[36];
    switch last {
      case (#box(b)) {
        assert b.label_ == "10-element";
        assert (b.position == {x=4.5;y=1.618;z=0.0});
        assert (b.textFields == "#element\n\tsymbol=10\n\telement=545");
      };
      case _ { assert false };
    }
   };

  #[listing]
  public func geom2d<X>(tree : Pointer<SeqTree<X>>) : Geom2D {
    let oneUnit = { height=1; width=1; widthLeft=0.5; widthRight=0.5};
    force(`geom2d(tree) := thunk { switch (@ tree) {
      case (#empty) { oneUnit };
      case (#element(e)) { oneUnit };
      case (#binary(b)) {
        let ml = geom2d(b.left);
        let mr = geom2d(b.right);
        { 
          height = max(ml.height, mr.height) + 1; 
          widthLeft = ml.width;
          widthRight = mr.width;
          width = ml.width + mr.width;
        }
      };
    }})
  };

  /// The same tree, over symbols that carry entropy.
  ///
  ///    A duplicate of `exampleLevelTree` differing in one call:
  /// `generateRandomInputSymbols` rather than `generateRandomInput`. Its
  /// symbols are `sym-1-482710`, `sym-2-1826057930`, ... rather than 1, 2,
  /// ..., so the levels -- and therefore the shape -- depend on the seed.
  /// Change the first argument and the tree changes; with the other
  /// generator it does not, whatever the seed (#72).
  ///
  ///    Kept beside the original rather than replacing it: the existing
  /// examples and tests assert on values built from positional symbols.
  #[example]
  public func exampleLevelTreeRandomSymbols() : W.ExampleOutput {
    let array = R.generateRandomInputSymbols(10, 10);
    let buildTree = `buildTree := thunk { fromArray(array) };
    let tree = force buildTree;
    A.scratch(thunk {
      W.scene(
        Scene.sceneObjects(tree!, A.Scene.zero),
        [ A.Outline.outline(buildTree) ]
      )
    })
  };

  /// A level tree, and the program's own account of how to look at it.
  ///
  /// Two phases, and the difference between them is the point. Building the
  /// tree is the subject: it runs in the session and the graph records it.
  /// Laying it out is the portrayal: it runs in a scratch, so the graph
  /// records none of it, and the history the runtime hands over afterwards is
  /// of the tree rather than of the drawing of the tree.
  #[example]
  public func exampleLevelTree() : W.ExampleOutput {
    let array = R.generateRandomInput(10, 10);
    let buildTree = `buildTree := thunk { fromArray(array) };
    let tree = force buildTree;
    A.scratch(thunk {
      W.scene(
        Scene.sceneObjects(tree!, A.Scene.zero),
        [ A.Outline.outline(buildTree) ]
      )
    })
  };

  /// One run of list-into-tree, as its own scene.
  ///
  /// Reset first, so the history belongs to this run alone --- a pair of
  /// these is only comparable if neither carries the other's events. The
  /// layout runs in a scratch, so what the runtime hands over is the history
  /// of building the tree and not of drawing it.
  ///
  /// `remove` names a cell to drop from the list before the tree is built.
  /// `null` is the unedited run. The head cannot be named: the cursor starts
  /// one cell in, which is issue #77.
  func treeFromListRun(seed : Nat, size : Nat, remove : ?Symbol) : A.Scene.Scene {
    A.reset();
    let array = R.generateRandomInput(seed, size);
    let list_ = `ListFromArray := thunk {
      do within space `inputList { List.fromIter(array.vals()) }
    };
    let list = force list_;
    do ? {
      let editor = List.Edit.cursor(list!.next);
      let editor = List.Edit.gotoSymbol(editor, remove!)!;
      List.Edit.remove(editor);
    };
    let tree_ = `LevelTreeFromList := thunk {
      do within space `inputTree { fromList(list) }
    };
    let tree = force tree_;
    W.withHistory(A.scratch(thunk {
      W.scene(Scene.sceneObjects(tree!, A.Scene.zero),
              [ A.Outline.outline(tree_) ])
    }))
  };

  /// One run of list-into-tree, keeping only the node map the diff needs.
  ///
  /// No objects and no outline: a scaling study wants histories, and laying
  /// out a thousand elements costs more than building the tree does. Same
  /// reset-run-peek shape as `treeFromListRun` otherwise.
  public func treeNodesRun(seed : Nat, size : Nat, remove : ?Symbol) : A.Diff.NodeVals {
    A.reset();
    let array = R.generateRandomInput(seed, size);
    let list_ = `ListFromArray := thunk {
      do within space `inputList { List.fromIter(array.vals()) }
    };
    let list = force list_;
    do ? {
      let editor = List.Edit.cursor(list!.next);
      let editor = List.Edit.gotoSymbol(editor, remove!)!;
      List.Edit.remove(editor);
    };
    let tree_ = `LevelTreeFromList := thunk {
      do within space `inputTree { fromList(list) }
    };
    let _ = force tree_;
    A.Diff.nodeValsFromNodes(A.peekHistory().nodes)
  };

  /// Random samples: a fresh input seed and a fresh removal position each.
  ///
  ///    Both drawn from the seeded generator rather than swept, so no
  ///    structure of the sampling grid can be mistaken for structure in the
  ///    answer. Each sample builds its own unedited run, since its input
  ///    differs from every other sample's.
  ///
  /// Positions fall in `2 .. size`; the head is not addressable (#77).
  public func treeRepairRandom(sampleSeed : Nat, size : Nat, samples : Nat) : Text {
    let seeds = R.generateRandomInput(sampleSeed, samples);
    let posns = R.generateRandomInput(sampleSeed + 7919, samples);
    var out = "";
    var i = 0;
    while (i < samples) {
      let (_, sd) = seeds[i];
      let (_, pr) = posns[i];
      let pos = 2 + (pr % (size - 1));
      let left = treeNodesRun(sd, size, null);
      let right = treeNodesRun(sd, size, ?pos);
      let d = A.Diff.nodeValsDiff(left, right);
      out #= (debug_show sd) # "," # (debug_show size) # "," # (debug_show pos) # ","
           # (debug_show (d.left.size())) # "," # (debug_show (d.right.size())) # ","
           # (debug_show (d.onlyLeft.size())) # "," # (debug_show (d.onlyRight.size())) # ","
           # (debug_show (d.equal.size())) # "," # (debug_show (d.notEqual.size())) # ";";
      i += 1
    };
    out
  };

  /// Sweep removal positions and report the four numbers for each.
  ///
  ///    The unedited run is built once and compared against each edited run,
  /// because its history is a value: `A.reset()` inside a later run cannot
  /// disturb a node map already taken.
  ///
  /// Positions run from 2 by `step`; the head is not addressable (#77).
  public func treeRepairSweep(seed : Nat, size : Nat, step : Nat) : Text {
    let left = treeNodesRun(seed, size, null);
    var out = "";
    var r = 2;
    while (r <= size) {
      let right = treeNodesRun(seed, size, ?r);
      let d = A.Diff.nodeValsDiff(left, right);
      out #= (debug_show seed) # "," # (debug_show size) # "," # (debug_show r) # ","
           # (debug_show (d.left.size())) # "," # (debug_show (d.right.size())) # ","
           # (debug_show (d.onlyLeft.size())) # "," # (debug_show (d.onlyRight.size())) # ","
           # (debug_show (d.equal.size())) # "," # (debug_show (d.notEqual.size())) # ";";
      r += step
    };
    out
  };

  /// The same list built into a tree twice, differing by one removed cell.
  ///
  ///    What a repair would cost, if repair were implemented. Neither run
  /// reuses anything from the other --- there is no repair algorithm yet, and
  /// that is deliberate while the specification is still being written. What
  /// the pair gives instead is the shape of the answer a repair would have to
  /// produce: which named nodes both runs agree on, which they disagree on,
  /// and which exist in only one of them.
  ///
  ///    Cell 3 is removed rather than any other. Its symbol has the highest
  /// level of the first several hundred, so it roots every tree over
  /// positional symbols, and removing it is the worst case rather than a
  /// typical one (#72). Sampled over twelve seeds at size 16, removing cell 3
  /// changed 27% of the tree's nodes where a typical position changed 11-16%.
  #[examplePair]
  public func examplePairTreeAfterRemoval() : W.ExamplePairOutput {
    W.pair(treeFromListRun(10, 16, null),
           treeFromListRun(10, 16, ?3))
  };

  #[test]
  public func testGeom2d<X>(tree : Pointer<SeqTree<X>>) : Geom2D {
    let a = R.generateRandomInput(10, 10);
    let t = fromArray(a);
    let g = geom2d(t!);
    // These are a function of `prim "symbolLevel"`, which hashes a symbol.
    // They changed when that hash was made independent of the target's
    // pointer width, and they are now the same on every target -- which is
    // the point: before, this tree was 6/10/8/2 natively and 6/10/4/6 under
    // wasm32, from the same input.
    assert (g == 
      { height = 8;
        width = 10;
        widthLeft = 2;
        widthRight = 8 });
  };

  }; 

  public module Tests {

    #[test]
    func testFromIntoArray() {
      assert intoArray(fromArray([])) == [];
      assert intoArray(fromArray([(0,0)])) == [(0,0)];
      assert intoArray(fromArray([(0,0), (1,1)])) == [(0,0), (1,1)];
      let input = R.generateRandomInput(10, 10);
      let tree = fromArray(input);
      assert intoArray(tree) == input
    };

    #[test]
    func testSize() {
      let input = R.generateRandomInput(10, 10);
      let tree = fromArray(input);
      assert Index.size(tree) == 10;
    };

  }

};
