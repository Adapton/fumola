import pureList "pureList";
import List "List";
import LazyList "LazyList";
import R "randomInput";
import A "../system/adapton";
import Map "hashMap";
import W "../system/webPlay";
import Prim "../system/prim";
import Pure "pureLevelTree";
import Files "../system/files";

/// A sequence represented as a balanced binary tree, keyed by level.
///
///    The structure and its balance argument come from Pugh and Teitelbaum,
/// "Incremental Computation via Function Caching", POPL 1989. Each element
/// draws a `level` from a geometric distribution, and the tree is the one
/// those levels determine: the highest level roots, and partitions the
/// sequence around itself. That makes the representation a function of the
/// sequence's contents rather than of the history of edits that produced it,
/// which is what lets a cached result be reused --- the same subsequence has
/// the same shape however it was arrived at. Balance holds in expectation
/// over the draws.
///
///    Fumola departs from the paper in one necessary way. The paper draws
/// each level independently, by coin flips. Here the level is a deterministic
/// function of the element's symbol --- `Prim.symbolLevel`, which packs four
/// geometric samples taken from the symbol's hash. Determinism is the
/// requirement rather than a shortcut: reuse depends on a symbol receiving
/// the same level every time it appears.
///
///    The cost of that departure is that there is no averaging left. The
/// expectation the paper's theorem quantifies over becomes a single fixed
/// realisation, so a set of symbols whose levels happen to be poorly
/// distributed stays that way permanently. Positional symbols are the case
/// to be careful with, being both few and shared across every structure that
/// uses them. See issue #72, and `R.generateRandomInputSymbols` for symbols
/// that carry entropy instead.
///
///    Two details of the representation, both of which are easy to get wrong
/// when reasoning about the shape. The elements are the *leaves*: the n-1
/// internal `#binary` nodes are the gaps between consecutive elements, gap i
/// carrying `symbolLevel` of the i-th symbol for i in 2..n. So it is a treap
/// over the gaps, the root holds a symbol rather than an element, and the
/// element whose symbol labels the root is the leftmost leaf of the right
/// subtree. One consequence: the first element's level is never consulted,
/// and only n-1 of the n levels drive the shape. The other detail is the
/// depth convention --- `metrics` and `Scene.geom2d` count nodes, taking a
/// leaf to be 1, so they report one more than the root-to-leaf edge count.

module { 
    
  #[listing(30)]
  public type LevelTree<X> = {
    #empty;
    #element : Element<X>;
    #binary : Binary<X>
  };

  #[listing]
  public type LevelTree_<X> = Pointer<LevelTree<X>>;

  #[listing(30)]
  public type Binary<X> = {
    symbol : Symbol;
    level : Nat;
    left : LevelTree_<X>;
    right : LevelTree_<X>
  };

  #[listing(23)]
  public type Element<X> = {
    element : X;
    symbol : Symbol
  };

  #[listing]
  public func reduceUp<X,Y>(
        t : LevelTree<X>, 
        empty : Y,
        element : (Symbol, X) -> Y,
        binary : (Symbol, Y, Y) -> Y) : Y 
  {
    switch t {
      case (#empty) empty;
      case (#element(e)) element(e.symbol, e.element);
      case (#binary(b)) {
        force (b.symbol := thunk {
          binary(b.symbol,
            reduceUp(@(b.left),  empty, element, binary), 
            reduceUp(@(b.right), empty, element, binary)
          )
        })
      };
    }
  };

 #[listing]
  public func reduce_<X,Y>(
        t : LevelTree_<X>, 
        empty : Y,
        element : (Symbol, X) -> Y,
        binary : (Symbol, Y, Y) -> Y) : Y
  {
    switch (@ t) {
      case (#empty) empty;
      case (#element(e)) element(e.symbol, e.element);
      case (#binary(b)) {
        let recLeft = force(`recLeft(b.symbol) := thunk {
          reduce_(b.left, empty, element, binary)
        });
        let recRight = force(`recRight(b.symbol) := thunk {
          reduce_(b.right, empty, element, binary)
        });
        binary(b.symbol, recLeft, recRight)
      };
    }
  };


  #[listing]
  public type GenSymThk = Thunk<(Symbol, GenSymThk)>;
  
  /// The symbol of a sequence's first element, or null if it has none.
  ///
  ///    A break carries the symbol of the element it sits before, so the
  /// break that `append` introduces between two sequences carries the first
  /// symbol of the second one. Walks the left spine, and falls to the right
  /// only for a malformed node with an empty left child.
  func firstSymbol<X>(t : LevelTree_<X>) : ?Symbol {
    switch (@ t) {
      case (#empty) null;
      case (#element(e)) ?e.symbol;
      case (#binary(b)) {
        switch (firstSymbol(b.left)) {
          case (?s) ?s;
          case null firstSymbol(b.right);
        }
      };
    }
  };

  /// Append two sequences, allocating the pointers the join needs.
  ///
  ///    `appendSym` names this append. Every pointer the operation allocates
  /// is named by pairing it with a symbol already in the trees, so the whole
  /// operation occupies one path of its own in the graph and cannot land on
  /// cells some unrelated computation is using:
  ///
  ///     `append(appendSym)(localSym)
  ///
  ///    The `append head is not decoration. `#cartesian` merge naming already
  /// builds names of the form `a(b)` out of two symbols carried by the data,
  /// so a bare `appendSym(localSym)` would collide with one of those the day
  /// an append symbol coincided with an element symbol. A literal head gives
  /// every append its own space and makes that impossible rather than
  /// unlikely.
  ///
  /// PRECONDITION: each pairing of `appendSym` with a symbol in either tree
  /// is unused. One fresh `appendSym` per append is enough to give that,
  /// since the symbols paired with it come from the trees and a spine walk
  /// visits each node once. It is a precondition rather than a check because
  /// nothing here can see what else the graph holds -- and getting it wrong
  /// does not fail, it silently rebinds a pointer somebody else is reading.
  ///
  ///    One symbol rather than a stream. A `GenSymThk` would name each
  /// allocation by its position in the recursion, which is `pathwise` naming,
  /// and a position survives only as long as the shape it addresses --
  /// measured on the merge network, that multiplies the cost of a reshaping
  /// edit by five and a half. Pairing with a symbol from the tree keeps the
  /// name attached to the data it is about, which is what survives an edit
  /// elsewhere. `GenSymThk` and `genSymsFrom` remain for a pathwise variant
  /// to use, if one is ever wanted for comparison.
  ///
  ///    The recursive cases follow Pugh and Teitelbaum, "Incremental
  /// Computation via Function Caching", POPL 1989, Figure 5.3, and their
  /// Theorem 5.6 gives the bound: each step walks down a right branch of
  /// `tree1` or a left branch of `tree2`, so the whole append is
  /// O(log |tree1| + log |tree2|) in expectation. The three candidate breaks
  /// are the most preferable break in `tree1`, the break between the two, and
  /// the most preferable break in `tree2`; the level comparisons choose which.
  ///    Pointers in and a pointer out, not bare trees. The `#empty` cases and
  /// every subtree the join does not rebuild are then returned as the
  /// pointers they arrived as, which is what keeps their sharing -- taking
  /// values would leave the break-between-the-two case holding two subtrees
  /// with no pointers to put in the node it has to build, and re-putting them
  /// under fresh names would duplicate them.
  ///
  ///    A note on reading the level comparisons. The paper's `level(X)` is the
  /// level of X's *first element*, while a `#binary` here caches the level of
  /// its *break*, which is the level of the first element of its right child.
  /// So `b.level` is the paper's `level(right child)`, and of the three
  /// quantities Figure 5.3 compares we hold two directly: their `level(S1)`
  /// is `b1.level` and their `level(T1)` is `b2.level`. Their `level(T0)` is
  /// the level of `tree2`'s leftmost element, which is not cached -- but it
  /// does not need to be, because it never changes: recursing into `T0` keeps
  /// the same leftmost element, and recursing into `S1` does not touch
  /// `tree2`. Compute it once on entry and carry it, and the walk stays
  /// O(log n) without a new field on the node.
  #[listing]
  public func append<X>(
    appendSym : Symbol,
    tree1 : LevelTree_<X>,
    tree2 : LevelTree_<X>
  ) : LevelTree_<X> {
    switch(@ tree1, @ tree2) {
      case(#empty, _) { tree2 };
      case(_, #empty) { tree1 };
      case(_, _) {
        switch (firstSymbol(tree2)) {
          // No elements on the right, so nothing to join.
          case null tree1;
          case (?midSym) {
            appendRec(appendSym, midSym, Prim.symbolLevel midSym, tree1, tree2)
          };
        }
      };
    }
  };

  /// `append`'s recursion, carrying the break it would introduce.
  ///
  ///    `midSym` is the first symbol of the original right-hand sequence and
  /// `midLevel` its level -- the paper's `level(T0)`, the one quantity in
  /// Figure 5.3 a `#binary` here does not cache. It is carried rather than
  /// recomputed because it never changes: descending into `T0` keeps the same
  /// leftmost element, and descending into `S1` does not touch the right-hand
  /// sequence at all. So the walk stays O(log |tree1| + log |tree2|), which is
  /// Theorem 5.6, without adding a field to the node.
  ///
  ///    Every node this builds is named `append(appendSym)(sym)` for the
  /// symbol of the break it carries, which is why the precondition on
  /// `append` has to include the two sequences being symbol-disjoint: a
  /// symbol in both trees would have its pairing claimed twice.
  func appendRec<X>(
    appendSym : Symbol,
    midSym : Symbol,
    midLevel : Nat,
    tree1 : LevelTree_<X>,
    tree2 : LevelTree_<X>
  ) : LevelTree_<X> {
    let node = func(sym : Symbol, level : Nat,
                    left : LevelTree_<X>, right : LevelTree_<X>) : LevelTree_<X> {
      `append(appendSym)(sym) := #binary {
        symbol = sym; level = level; left = left; right = right
      }
    };
    switch(@ tree1, @ tree2) {
      case(#empty, _) { tree2 };
      case(_, #empty) { tree1 };

      // Nothing to compare: two single elements have exactly one break
      // between them, and it is the one this returns.
      case(#element(_), #element(_)) {
        node(midSym, midLevel, tree1, tree2)
      };

      // Paper: if level(T0) <= level(T1) then cList(append(S, T0), T1)
      //                                  else cList(S, T)
      case(#element(_), #binary(b2)) {
        if (midLevel <= b2.level) {
          node(b2.symbol, b2.level,
               appendRec(appendSym, midSym, midLevel, tree1, b2.left),
               b2.right)
        } else {
          node(midSym, midLevel, tree1, tree2)
        }
      };

      // Paper: if level(S1) <= level(T) then cList(S, T)
      //                                 else cList(S0, append(S1, T))
      //
      // `level(T)` for a single element is its own level, which is `midLevel`
      // here, since a one-element sequence's first element is that element.
      case(#binary(b1), #element(_)) {
        if (b1.level <= midLevel) {
          node(midSym, midLevel, tree1, tree2)
        } else {
          node(b1.symbol, b1.level,
               b1.left,
               appendRec(appendSym, midSym, midLevel, b1.right, tree2))
        }
      };

      // Paper: if      level(S1) <= level(T1) and level(T0) <= level(T1)
      //          then  cList(append(S, T0), T1)
      //        else if level(S1) <= level(T0) and level(T1) <  level(T0)
      //          then  cList(S, T)
      //        else    cList(S0, append(S1, T))
      //
      // The asymmetry between <= and < is Definition 5.2's tie-breaking rule:
      // of two breaks at equal level the rightmost wins. Writing these the way
      // they read aloud loses it.
      case(#binary(b1), #binary(b2)) {
        if (b1.level <= b2.level and midLevel <= b2.level) {
          node(b2.symbol, b2.level,
               appendRec(appendSym, midSym, midLevel, tree1, b2.left),
               b2.right)
        } else if (b1.level <= midLevel and b2.level < midLevel) {
          node(midSym, midLevel, tree1, tree2)
        } else {
          node(b1.symbol, b1.level,
               b1.left,
               appendRec(appendSym, midSym, midLevel, b1.right, tree2))
        }
      };
    }
  };

  #[listing]
  public func append_<X>(
    appendSym : Symbol,
    left : ?LevelTree_<X>, right : ?LevelTree_<X>
  ) : ?LevelTree_<X> {
    switch (left, right) {
      case (null, _) right;
      case (_, null) left;
      case (?l, ?r) {
        ?append(appendSym, l, r)
      }
    }
  };

  public func genSymsFrom(s : Symbol, n : Nat) : GenSymThk {
    thunk { (s-n, genSymsFrom(s, n + 1))}
  };

  /// The first element of a sequence, or null if it has none.
  ///
  ///    Walks the left spine. `split` needs it to learn the value a node
  /// divides its sequence at: a break carries a symbol and a level but not a
  /// value, and for a sorted sequence the value at a break is the first
  /// element of the node's right side.
  func firstElement<X>(t : LevelTree_<X>) : ?X {
    switch (@ t) {
      case (#empty) null;
      case (#element(e)) ?e.element;
      case (#binary(b)) {
        switch (firstElement(b.left)) {
          case (?x) ?x;
          case null firstElement(b.right);
        }
      };
    }
  };

  /// Divide a **sorted** sequence at a value: what is below `pivot`, and the
  /// rest.
  ///
  ///    Strictly below, so an element equal to the pivot lands on the right.
  /// Merging wants it that way: it splits one sequence at a value taken from
  /// the other, and everything at or above that value belongs with it.
  ///
  /// PRECONDITION: `t` is sorted, and `splitSym` paired with the symbols in it
  /// is unused. Sortedness is not checked and cannot be cheaply -- a break
  /// carries no value, so learning what a node divides at means walking to a
  /// leaf.
  ///
  ///    That walk is why this is O(log^2 n) rather than O(log n): one leftmost
  /// walk per level descended. `append` avoided the same cost because the
  /// value it needed never changed and could be carried; here it changes at
  /// every step. Caching a first element on each node, which is what Pugh and
  /// Teitelbaum do to keep their bound, would fix it and is a change to the
  /// representation rather than to this function.
  public func split<X>(splitSym : Symbol, t : ?LevelTree_<X>, pivot : X)
    : (?LevelTree_<X>, ?LevelTree_<X>) {
    switch t {
      case null (null, null);
      case (?p) {
        switch (@ p) {
          case (#empty) (null, null);
          case (#element(e)) {
            if (e.element < pivot) { (?p, null) } else { (null, ?p) }
          };
          case (#binary(b)) {
            switch (firstElement(b.right)) {
              case null (?p, null);
              case (?v) {
                if (pivot <= v) {
                  // Everything on the right is at or above the pivot, so the
                  // division is somewhere on the left.
                  let (lo, hi) = split(splitSym, ?b.left, pivot);
                  (lo, append_(`splitJoin(splitSym)(b.symbol), hi, ?b.right))
                } else {
                  let (lo, hi) = split(splitSym, ?b.right, pivot);
                  (append_(`splitJoin(splitSym)(b.symbol), ?b.left, lo), hi)
                }
              };
            }
          };
        }
      };
    }
  };

  /// Append two **sorted** sequences, giving one sorted sequence.
  ///
  ///    A different function from `append`, not a wrapper on it: `append`
  /// concatenates whatever it is given, and this interleaves. What they share
  /// is the shape of the problem -- two sequences in, one out, the levels
  /// deciding the result's shape -- and the invariant is what differs. Hence
  /// the name: append, for sequences that are sorted, keeping them so.
  ///
  ///    It is the union of two treaps, done in the order their own levels ask
  /// for.
  /// Whichever sequence has the higher break has the break that will root the
  /// result, so that one is divided where it already divides, the other is
  /// split at the same value, and the two halves are merged and appended. The
  /// levels decide the shape, so the shape comes out canonical: the same
  /// sorted sequence however it was arrived at.
  ///
  ///    A single element is inserted rather than recursed on. Treating it as a
  /// sequence to divide would split the other at that element's own value,
  /// leaving the same pair to merge again.
  ///
  /// PRECONDITION: both are sorted, and `mergeSym` paired with the symbols in
  /// them is unused. `eagerMergeSort` passes the reduction node's own symbol,
  /// which gives that: one node, one merge.
  public func appendSorted<X>(mergeSym : Symbol, a : ?LevelTree_<X>, b : ?LevelTree_<X>)
    : ?LevelTree_<X> {
    switch (a, b) {
      case (null, _) b;
      case (_, null) a;
      case (?pa, ?pb) {
        switch (@ pa, @ pb) {
          case (#empty, _) b;
          case (_, #empty) a;
          case (#element(e), _) {
            let (lo, hi) = split(`mergeInsertA(mergeSym)(e.symbol), b, e.element);
            append_(`mergeHiA(mergeSym)(e.symbol),
                    append_(`mergeLoA(mergeSym)(e.symbol), lo, a),
                    hi)
          };
          case (_, #element(e)) {
            let (lo, hi) = split(`mergeInsertB(mergeSym)(e.symbol), a, e.element);
            append_(`mergeHiB(mergeSym)(e.symbol),
                    append_(`mergeLoB(mergeSym)(e.symbol), lo, b),
                    hi)
          };
          case (#binary(ba), #binary(bb)) {
            if (ba.level >= bb.level) {
              switch (firstElement(ba.right)) {
                case null a;
                case (?v) {
                  let (blo, bhi) = split(`mergeSplitA(mergeSym)(ba.symbol), b, v);
                  append_(`mergeJoinA(mergeSym)(ba.symbol),
                          appendSorted(`mergeLeftA(mergeSym)(ba.symbol), ?ba.left, blo),
                          appendSorted(`mergeRightA(mergeSym)(ba.symbol), ?ba.right, bhi))
                };
              }
            } else {
              switch (firstElement(bb.right)) {
                case null b;
                case (?v) {
                  let (alo, ahi) = split(`mergeSplitB(mergeSym)(bb.symbol), a, v);
                  append_(`mergeJoinB(mergeSym)(bb.symbol),
                          appendSorted(`mergeLeftB(mergeSym)(bb.symbol), alo, ?bb.left),
                          appendSorted(`mergeRightB(mergeSym)(bb.symbol), ahi, ?bb.right))
                };
              }
            }
          };
        }
      };
    }
  };

  /// A sorted sequence's elements as a pure list, left to right.
  ///
  ///    `reduceUp`'s remaining use case. The result carries no pointers, so
  /// nothing about the conversion can reach the graph -- which is the point:
  /// an intermediate that has cells has names, and names chosen by an
  /// operation are exactly what `appendSortedRebuild` exists to avoid.
  ///
  ///    `reduceUp` itself does allocate, one cell per node it passes through,
  /// so the call belongs in `A.scratch`: the list it computed is kept and the
  /// cells it wrote are not. `intoPureList` does that, and callers should use
  /// it rather than `reduceUp` directly.
  func intoPureListRaw<X>(t : ?SeqTree_<X>) : PureList<X> {
    switch t {
      case null null;
      case (?p) {
        reduceUp(
          @ p,
          null,
          func(s : Symbol, x : X) : PureList<X> {
            ?{ symbol = s; element = x; next = null }
          },
          func(_ : Symbol, l : PureList<X>, r : PureList<X>) : PureList<X> {
            appendPure(l, r)
          }
        )
      };
    }
  };

  func appendPure<X>(l : PureList<X>, r : PureList<X>) : PureList<X> {
    switch l {
      case null r;
      case (?c) ?{ symbol = c.symbol; element = c.element; next = appendPure(c.next, r) };
    }
  };

  public func intoPureList<X>(t : ?SeqTree_<X>) : PureList<X> {
    A.scratch(thunk { intoPureListRaw(t) })
  };

  /// Merge two sorted pure lists. No cells, so no names.
  func mergePure<X>(xs : PureList<X>, ys : PureList<X>) : PureList<X> {
    switch (xs, ys) {
      case (null, _) ys;
      case (_, null) xs;
      case (?x, ?y) {
        if (x.element <= y.element) {
          ?{ symbol = x.symbol; element = x.element; next = mergePure(x.next, ys) }
        } else {
          ?{ symbol = y.symbol; element = y.element; next = mergePure(xs, y.next) }
        }
      };
    }
  };

  /// Append two sorted sequences by rebuilding, rather than by splitting and
  /// joining.
  ///
  ///    The same job as `appendSorted` and the opposite approach to it, and the
  /// difference is what the result's cells are called.
  ///
  ///    `appendSorted` works on the trees and names every cell it allocates
  /// after the operation that allocated it -- `append(appendSym)(local)`. So
  /// its output shares no cell with the same sequence arrived at any other
  /// way, and two runs share only what their operations happened to have in
  /// common. Measured, that costs three to thirteen times the repair of the
  /// lazy merge network.
  ///
  ///    This one drops to pure lists, merges them, and hands the result to
  /// `fromPureList`, which names each node after its own element -- `sym-`element`
  /// for a leaf and `sym-`binary` for a gap. Those are the names any route to
  /// that sequence produces, so the output is identified by what it holds
  /// rather than by how it was built. That is the structural end of the axis
  /// `docs/cache-naming.md` describes, and this is the first place in the
  /// library where that document's recommendation is tested rather than
  /// asserted.
  ///
  ///    The intermediates are pure and therefore nameless, and the conversion
  /// runs in `scratch`, so the only cells this leaves behind are the answer's.
  /// A literal fusion -- the merge feeding the builder without a list in
  /// between -- would save host allocation and change nothing about the names,
  /// so it is an optimisation rather than part of the design.
  ///
  ///    `sym` gives the intermediate a space of its own, since a symbol that
  /// is a gap in one intermediate can be a gap in another, and `fromPureList`
  /// would otherwise write the same cell twice with different contents.
  public func appendSortedRebuild<X>(sym : Symbol, a : ?SeqTree_<X>, b : ?SeqTree_<X>)
    : ?SeqTree_<X> {
    let merged = mergePure(intoPureList(a), intoPureList(b));
    do within space (`sorted(sym)) { fromPureList(merged) }
  };

  /// Sort by rebuilding at each step. The counterpart of `eagerMergeSort`.
  public func eagerMergeSortRebuild<X>(t : ?SeqTree_<X>) : ?SeqTree_<X> {
    switch t {
      case null null;
      case (?p) {
        reduce_(
          p,
          null,
          func(symbol : Symbol, element : X) : ?SeqTree_<X> {
            ?(symbol-`element := #element { symbol = symbol; element = element })
          },
          func(symbol : Symbol, l : ?SeqTree_<X>, r : ?SeqTree_<X>) : ?SeqTree_<X> {
            appendSortedRebuild(symbol, l, r)
          }
        )
      };
    }
  };

  /// The rebuilding sort agrees with the splitting one, element for element
  /// and shape for shape.
  ///
  ///    Two implementations of one function is the strongest test available
  /// here: they share no code below `reduce_`, so agreeing means both are
  /// right about the order and about the shape a sorted sequence must take.
  #[test]
  public func testEagerMergeSortRebuild() {
    var size = 1;
    while (size <= 12) {
      let xs = R.generateRandomInput(10, size);
      let bySplitting = eagerMergeSort(fromArray(xs));
      let byRebuilding = eagerMergeSortRebuild(fromArray(xs));
      assert (Pure.equal(erase(bySplitting), erase(byRebuilding)));
      size += 1
    };
  };

  /// Sort a sequence, merging eagerly, keeping a level tree throughout.
  ///
  ///    The counterpart of `lazyMergeSort`. That one builds a network of
  /// streams and hands back a promise; this one merges as it goes and hands
  /// back a sorted sequence in the same representation it was given, so the
  /// result can be appended to, split, sorted again, or compared with a tree
  /// built any other way.
  ///
  ///    Each merge is named by the reduction node it happens at, which is
  /// `#inductive` naming for this path: the node's own symbol is the extra
  /// symbol every `append` and `split` underneath it pairs with. One node, one
  /// merge, so the pairings are unused, which is what those two require.
  public func eagerMergeSort<X>(t : ?SeqTree_<X>) : ?SeqTree_<X> {
    switch t {
      case null null;
      case (?p) {
        reduce_(
          p,
          null,
          func(symbol : Symbol, element : X) : ?SeqTree_<X> {
            ?(symbol-`element := #element { symbol = symbol; element = element })
          },
          func(symbol : Symbol, l : ?SeqTree_<X>, r : ?SeqTree_<X>) : ?SeqTree_<X> {
            appendSorted(symbol, l, r)
          }
        )
      };
    }
  };

  /// `eagerMergeSort` sorts, keeps every element, and leaves the result in
  /// the canonical shape for the sequence it holds.
  ///
  ///    The third is the one worth having and the one that needs no oracle: a
  /// level tree's shape is a function of its contents, so whatever route the
  /// sorted sequence was arrived at by, the tree holding it must be the tree
  /// `fromArray` would build for it. Sortedness alone would pass for a
  /// correctly ordered but badly shaped tree, and a badly shaped one costs
  /// every later reuse without ever being wrong.
  ///
  ///    Swept over sizes because `appendSorted` reaches different cases
  /// depending on which side's break is higher, and small inputs reach the
  /// single-element insert path that recursion would otherwise loop on.
  #[test]
  public func testEagerMergeSort() {
    let valuesOf = func(a : [(Symbol, Nat)]) : Text {
      var out = "";
      for ((_, v) in a.vals()) { out #= (debug_show v) # "," };
      out
    };
    let sumOf = func(a : [(Symbol, Nat)]) : Nat {
      var n = 0;
      for ((_, v) in a.vals()) { n += v };
      n
    };
    let nonDecreasing = func(a : [(Symbol, Nat)]) : bool {
      var ok = true;
      var i = 1;
      while (i < a.size()) {
        if (a[i].1 < a[i - 1].1) { ok := false };
        i += 1
      };
      ok
    };
    var size = 1;
    while (size <= 12) {
      let xs = R.generateRandomInput(10, size);
      let t = fromArray(xs);
      let sorted = eagerMergeSort(t);
      let got = Pure.intoArray(erase(sorted));
      // Sorted.
      assert (nonDecreasing(got));
      // Every element, once.
      assert (got.size() == size);
      assert (sumOf(got) == sumOf(xs));
      // And in the shape this representation says that sequence has.
      assert (Pure.equal(erase(sorted), erase(fromArray(got))));
      size += 1
    };
  };

  /// `split` divides a sorted sequence, loses nothing, and leaves both halves
  /// canonical.
  #[test]
  public func testSplit() {
    var size = 1;
    while (size <= 10) {
      let sorted = eagerMergeSort(fromArray(R.generateRandomInput(10, size)));
      let all = Pure.intoArray(erase(sorted));
      var i = 0;
      while (i < all.size()) {
        let pivot = all[i].1;
        let (lo, hi) = split(`p(size)(i), sorted, pivot);
        let loA = Pure.intoArray(erase(lo));
        let hiA = Pure.intoArray(erase(hi));
        // Nothing lost and nothing gained.
        assert (loA.size() + hiA.size() == all.size());
        // Strictly below on the left, so an equal element goes right.
        var j = 0;
        while (j < loA.size()) { assert (loA[j].1 < pivot); j += 1 };
        var k = 0;
        while (k < hiA.size()) { assert (not (hiA[k].1 < pivot)); k += 1 };
        // Each half is the tree its own contents call for.
        assert (Pure.equal(erase(lo), erase(fromArray(loA))));
        assert (Pure.equal(erase(hi), erase(fromArray(hiA))));
        i += 1
      };
      size += 1
    };
  };

  /// The same tree with the pointers taken out.
  ///
  ///    For comparing one tree against another for what it is rather than for
  /// which cells hold it. Pointer equality cannot do that: a tree built by
  /// `append` lives in `append(...)` cells and the same sequence built by
  /// `fromArray` lives in `sym-`binary` cells, so the two are equal as
  /// sequences and as shapes while sharing no cell at all. That is the cost of
  /// pointer naming, and `docs/cache-naming.md` is about it.
  ///
  ///    Reads cells and allocates none.
  public func erase<X>(t : ?LevelTree_<X>) : Pure.LevelTree<X> {
    switch t {
      case null (#empty);
      case (?p) eraseAt(p);
    }
  };

  func eraseAt<X>(p : LevelTree_<X>) : Pure.LevelTree<X> {
    switch (@ p) {
      case (#empty) (#empty);
      case (#element(e)) (#element { symbol = e.symbol; element = e.element });
      case (#binary(b)) {
        #binary {
          symbol = b.symbol; level = b.level;
          left = eraseAt(b.left); right = eraseAt(b.right)
        }
      };
    }
  };

  /// The other direction: put a pure tree into cells.
  ///
  ///    Under the names `fromList` would have used -- `sym-`element` for a
  /// leaf and `sym-`binary` for a gap -- so embedding is the canonical
  /// placement rather than a fresh one. Which makes it the way to ask what a
  /// tree would cost if it had been built canonically, whatever route it
  /// actually arrived by.
  public func embed<X>(t : Pure.LevelTree<X>) : ?LevelTree_<X> {
    switch t {
      case (#empty) null;
      case (#element(e)) {
        ?(e.symbol-`element := #element { symbol = e.symbol; element = e.element })
      };
      case (#binary(b)) {
        do ? {
          let l = embed(b.left)!;
          let r = embed(b.right)!;
          b.symbol-`binary := #binary {
            symbol = b.symbol; level = b.level; left = l; right = r
          }
        }
      };
    }
  };

  /// Appending two representations represents the appended sequences, and
  /// builds the very tree `fromArray` would have built for the concatenation.
  ///
  ///    The second is the stronger claim and the one that checks the break
  /// selection: contents alone would pass for any tree holding the right
  /// elements in the right order, however badly shaped. Canonicity is the
  /// property the whole representation exists for -- a sequence's shape is a
  /// function of its contents, however it was arrived at -- so an append that
  /// broke it would quietly cost every later reuse.
  ///
  ///    Swept over small sizes because the six cases of Figure 5.3 need
  /// different shapes to reach: one element against one, one against many,
  /// many against one, and many against many, with the level comparisons
  /// going each way.
  #[test]
  public func testAppendShape() {
    var l = 1;
    while (l <= 6) {
      var r = 1;
      while (r <= 6) {
        let xs = R.generateRandomInput(10, l);
        let ys = R.generateRandomInput_(10, l, r);
        let out = append_(`a(l)(r), fromArray(xs), fromArray(ys));
        let whole = fromArray(xs # ys);
        assert (debug_show (intoArray(out)) == debug_show (intoArray(whole)));
        assert (Pure.equal(erase(out), erase(whole)));
        r += 1
      };
      l += 1
    };
  };

  /// Erasing loses the cells and nothing else, and embedding puts a tree
  /// back under the names it would have had if built canonically.
  #[test]
  public func testEraseEmbed() {
    let xs = R.generateRandomInput(10, 8);
    let t = fromArray(xs);
    assert (debug_show (Pure.intoArray(erase(t))) == debug_show (intoArray(t)));
    assert (Pure.size(erase(t)) == 8);
    // Round trip. The cells differ -- `embed` places them canonically, which
    // is where `fromArray` put them, so here they coincide -- but the point
    // is that the tree does not.
    assert (Pure.equal(erase(embed(erase(t))), erase(t)));
  };

  #[test]
  public func testAppend() {
    let (lSize, rSize) = (3, 3);
    let left = fromArray(R.generateRandomInput(10, lSize));
    let right = fromArray(R.generateRandomInput_(10, lSize, rSize));

    let out = append_(`x, left, right);
    // The whole correctness criterion: appending the representations
    // represents the appended sequences. Compared through `debug_show` so
    // this is a text equality rather than a structural one.
    assert (debug_show (intoArray(out))
            == debug_show (intoArray(left) # intoArray(right)));
  };

  /// Which naming the merge network uses, if a program has asked for one.
  ///
  ///    Peeked rather than got, and nothing is bound from it. A `get` would
  /// make every merge cell depend on the choice, and binding the answer would
  /// put it in the environment of every thunk built below -- either way the
  /// two strategies would differ everywhere, for a reason that has nothing to
  /// do with naming, and the comparison they exist for would be buried under
  /// the mechanism used to make it.
  ///
  ///    Absent means inductive, so a program that never writes the cell sorts
  /// exactly as it always did.
  func mergeStrategy() : {#inductive; #cartesian; #pathwise} {
    switch (A.peek(`lazyMergeSort(`strategy))) {
      case (?#cartesian) #cartesian;
      case (?#pathwise) #pathwise;
      case _ #inductive;
    }
  };

  /// `reduce_`, carrying an address of where it is rather than reading one off
  /// the tree.
  ///
  ///    A path is built as the recursion descends -- `0 at the root, then
  /// `0(L) and `0(R) and so on -- so it says where a node sits and nothing
  /// about what the node holds. That is the whole difference from `reduce_`,
  /// which names its cells for the tree node's own symbol and so renames them
  /// whenever the input moves.
  ///
  ///    Written out rather than added as a parameter to `reduce_`, because a
  /// parameter would sit in the environment of every thunk the other two
  /// strategies build, and then all three would differ everywhere for a reason
  /// that has nothing to do with naming.
  func reducePathwise<X,Y>(
        t : LevelTree_<X>,
        path : Symbol,
        empty : Y,
        element : (Symbol, X) -> Y,
        binary : (Symbol, Y, Y) -> Y) : Y
  {
    switch (@ t) {
      case (#empty) empty;
      case (#element(e)) element(e.symbol, e.element);
      case (#binary(b)) {
        let recLeft = force(`recLeft(path) := thunk {
          reducePathwise(b.left, path(`L), empty, element, binary)
        });
        let recRight = force(`recRight(path) := thunk {
          reducePathwise(b.right, path(`R), empty, element, binary)
        });
        binary(path, recLeft, recRight)
      };
    }
  };

  /// `reduceUp` with the same substitution, for the eager traversal.
  func reduceUpPathwise<X,Y>(
        t : LevelTree<X>,
        path : Symbol,
        empty : Y,
        element : (Symbol, X) -> Y,
        binary : (Symbol, Y, Y) -> Y) : Y
  {
    switch t {
      case (#empty) empty;
      case (#element(e)) element(e.symbol, e.element);
      case (#binary(b)) {
        force (path := thunk {
          binary(path,
            reduceUpPathwise(@(b.left),  path(`L), empty, element, binary),
            reduceUpPathwise(@(b.right), path(`R), empty, element, binary))
        })
      };
    }
  };

  #[listing(62)]
  public func lazyMergeSort<X>(t : ?SeqTree_<X>) : LazyList_<X> {
    let nilList = `(nilList) := thunk { null };
    if (t == null) { return nilList };
    let leaf = func(symbol:Symbol, element:X) : LazyList<X> {
      ?{ symbol; element; next = nilList }
    };
    switch (mergeStrategy()) {
      case (#cartesian)
        `result := thunk {
          reduceUp(
            @(t!),
            null,
            leaf,
            func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
              LazyList.mergeCartesian(xs, ys)
            }
          )
        };
      case (#pathwise)
        `result := thunk {
          reduceUpPathwise(
            @(t!),
            `0,
            null,
            leaf,
            func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
              do within space (`merge-symbol) {
                LazyList.mergeInductive(xs, ys)
              }
            }
          )
        };
      case (#inductive)
        `result := thunk {
          reduceUp(
            @(t!),
            null,
            leaf,
            func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
              do within space (`merge-symbol) {
                LazyList.mergeInductive(xs, ys)
              }
            }
          )
        };
    }
  };

  #[listing(62)]
  public func lazyMergeSort_<X>(t : ?SeqTree_<X>) : LazyList_<X> {
    let nilList = `(nilList) := thunk { null };
    if (t == null) { return nilList };
    let leaf = func(symbol:Symbol, element:X) : LazyList<X> {
      ?{ symbol; element; next = nilList }
    };
    // One program written three times rather than one program parameterised,
    // so that no thunk closes over the choice.
    //
    //    `pathwise` differs from `inductive` only in what the space is keyed
    // by: the merge cells are named the same way, for the element that won.
    switch (mergeStrategy()) {
      case (#cartesian)
        `result := thunk {
          reduce_(
            t!,
            null,
            leaf,
            func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
              LazyList.mergeCartesian(xs, ys)
            }
          )
        };
      case (#pathwise)
        `result := thunk {
          reducePathwise(
            t!,
            `0,
            null,
            leaf,
            func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
              do within space (`merge-symbol) {
                LazyList.mergeInductive(xs, ys)
              }
            }
          )
        };
      case (#inductive)
        `result := thunk {
          reduce_(
            t!,
            null,
            leaf,
            func(symbol:Symbol, xs:LazyList<X>, ys:LazyList<X>) : LazyList<X> {
              do within space (`merge-symbol) {
                LazyList.mergeInductive(xs, ys)
              }
            }
          )
        };
    }
  };

  public func intoArray<X>(tree : ?SeqTree_<X>) : [(Symbol, X)] {
    if (tree == null) { return [] };
    reduceUp(@(tree!), [], func(s,x){[(s,x)]}, func(_,l,r){l # r})
  };

  public func fromArray<X>(array : [(Symbol, X)]) : ?SeqTree_<X> {
    fromPureList(pureList.fromIter(array.vals()))
  };

  #[listing]
  public func fromPureList<X>(list : PureList<X>) : ?SeqTree_<X> {
    do ? {
      let {symbol; element; next} = list!;
      let level = Prim.symbolLevel symbol;
      let (tree, nil) = fromPureListRec(next, symbol-`element := #element {symbol; element}, null);
      assert (nil == null);
      tree
    }
  };

  #[listing]
  func fromPureListRec<X>(list : PureList<X>, left : SeqTree_<X>, parentLevel : ?Nat) : (SeqTree_<X>, PureList<X>) {
    switch list {
      case null (left, null);
      case (?{symbol; element; next}) {
        let level = Prim.symbolLevel symbol;
        if (levelLte(level, parentLevel)) {
          let rightLeft = symbol-`element := #element {symbol; element};
          let (right, next) = fromPureListRec(next, rightLeft, ?level);
          let left = symbol-`binary := #binary {symbol; level; left; right};
          fromPureListRec(next, left, parentLevel)
        } else {
          (left, list)
        }
      };
    }
  };


  #[listing]
  public func fromList<X>(list : List<X>) : ?SeqTree_<X> {
    do ? {
      let {symbol; element; next} = list!;
      let level = Prim.symbolLevel symbol;
      let nilList = `(nilList) := null;
      let (tree, nilList_) = fromListRec(next, symbol-`element := #element {symbol; element}, null, nilList);
      assert (nilList == nilList_);
      tree
    }
  };

  #[listing]
  func fromListRec<X>(list : List_<X>, left : SeqTree_<X>, parentLevel : ?Nat, nil : List_) : (SeqTree_<X>, List_<X>) {
    switch (@ list) {
      case null (left, nil);
      case (?{symbol; element; next}) {
        let level = Prim.symbolLevel symbol;
        if (levelLte(level, parentLevel)) {
          let rightLeft = symbol-`element := #element {symbol; element};
          let (right, next) = force (symbol-`rec1 := thunk { fromListRec(next, rightLeft, ?level, nil) });
          let left = symbol-`binary := #binary {symbol; level; left; right};
          force ( symbol-`rec2 := thunk { fromListRec(next, left, parentLevel, nil) } );
        } else {
          (left, list)
        }
      };
    }
  };

  #[test]
  public func testFromList() {
    let array = R.generateRandomInput(10, 10);
    fromList(List.fromIter(array.vals()))
  };

  #[listing]
  func levelLte(level : Nat, parentLevel : ?Nat) : bool {
    switch parentLevel {
      case null true;
      case (?p) level <= p;
    }
  };

  func max(a, b) {
    if (a > b) { a } else { b }
  };

  func indentText(n : Nat) : Text {
    if (n == 0) { "" } else {
      "  " # (indentText(n - 1))
    }
  };

  public func tikzText<X>(tree : SeqTree_<X>, n : Nat) : Text {
    switch (@ tree) {
      case (#empty) { "emptyNode\n" };
      case (#element(e)) {
        indentText(n) # "[{\\SeqTreeElement" #
        "{" # (debug_show e.symbol) # "}" #
        "{" # (debug_show e.element) # "}}]\n"
      };
      case (#binary(b)) {
        indentText(n) # "[\n" #
        indentText(n + 1) # "{\\SeqTreeBinaryNode" #
        "{" # (debug_show b.symbol) # "}" #
        "{" # (debug_show b.level) # "}" #
        "}\n" #
        tikzText(b.left, n + 1) #
        tikzText(b.right, n + 1) #
        indentText(n) # "]\n"
      };
    }
  };

  public func writeTikzText<X>(path : Symbol, tree : ?Pointer<SeqTree<X>>) {
    let ?() = do ? {
      let firstPart = "\\begin{forest}\n";
      let lastPart = "\\end{forest}\n";
      Files.write (path, firstPart # tikzText(tree!, 0) # lastPart)
    };
  };

  func abs(x : Int) : Nat {
    if (x < 0) -x else x
  };

  #[listing]
  public func metrics<X>(tree : Pointer<SeqTree<X>>) {
    switch (@ tree) {
      case (#empty) { { depth=1; size=0; hasEmpty=true} };
      case (#element(e)) { { depth=1; size=1; hasEmpty=false } };
      case (#binary(b)) {
        let ml = metrics(b.left);
        let mr = metrics(b.right);
        { 
          depth = max(ml.depth, mr.depth) + 1; 
          size = ml.size + mr.size;
          hasEmpty = ml.hasEmpty or mr.hasEmpty;
        }
      };
    }
  };

  public module Index {
    //
    // The number of leaf nodes.
    // used by the index-based edit operations in Edit module.
    //
    #[listing]
    public func size<X>(tree : ?LevelTree_<X>) : Nat {
      do goto space (`levelTree(`Index)(`size)) {
        reduceUp(@(tree!), 0, func(_,_) { 1 }, func(_,l,r){l + r})
      }
    };
  };

  public module Edit {

  };

  public module Scene {

  public type Geom2D = {
    height : Nat;
    width : Nat;
    widthLeft : Nat;
    widthRight : Nat;
  };

  public func writeSceneFile(file : Symbol, seed : Nat, size : Nat) {
    let a = R.generateRandomInput(seed, size);
    let t = fromArray(a);
    // let evs = A.peekEvents();
    // let nodeIdsByLabel = A.nodeIdsByLabelFromEvents(evs);
    let objs = sceneObjects(t!, A.Scene.zero);
    let text = A.IntoJSON.fromObjects(objs);
    Files.write (file, text)
  };

  #[test]
  public func testWriteSceneFile() {
    writeSceneFile(`testWriteSceneFile, 10, 10)
  };

  func objectFromEdge(source, port, edge) : A.Scene.SceneObject {
    // prim "print" (debug_show edge.edgeId);
    #action{ from = source # ":" # port; 
             to = debug_show edge.actionTarget;
             action = edge.action;
             edgeId = edge.edgeId;
    } 
  };

  /// Objects for an outline of any shape.
  ///
  ///    `sceneObjectsFromList` and `sceneObjectsLazyMergeSort_` each know the
  /// force tree they were written for: they switch on how many edges a node
  /// has and read particular indices out of it. This one knows nothing about
  /// its input -- one orb per node, one action per edge, and a layout from the
  /// walk itself. Plainer than either, and it works on a force tree nobody has
  /// drawn before, which is what a new algorithm needs.
  ///
  ///    Depth down, visit order across. `step.y` is how far each level drops
  /// and `step.x` how far each node advances, and the x cursor is carried
  /// rather than computed from an index because a Nat is not a Float and
  /// nothing here converts one.
  ///
  ///    The reason to draw a force tree at all is that a diff between two runs
  /// counts cells, and a scene that draws only the data structure leaves most
  /// of what differs off screen: the eager sort's pair reports that 56% of its
  /// nodes differ while showing two trees that differ in eight objects,
  /// because the rest are `split` and `append` cells nobody drew.
  public func sceneObjectsOfOutline(outline, origin, step) : A.Scene.SceneObjects {
    var cursor = 0.0;
    func ports(n) : [Text] {
      var ps = [];
      var i = 0;
      while (i < n.edges.size()) { ps #= [ "e" # (debug_show i) ]; i += 1 };
      ps
    };
    func go(o, drop : Float) : A.Scene.SceneObjects {
      let position = { x = origin.x + cursor; y = origin.y - drop; z = origin.z };
      cursor += step.x;
      switch o {
        case (#leaf(n)) {
          let label_ = (debug_show ((n.nodeId.0).0));
          [#orb { label_; position; textFields = ""; pointerFields = [] }]
        };
        case (#internal(n)) {
          let label_ = (debug_show ((n.__nodeId.0).0));
          var objs = [#orb { label_; position; textFields = ""; pointerFields = ports(n) }];
          var i = 0;
          while (i < n.edges.size()) {
            let e = n.edges[i];
            objs #= [ objectFromEdge(label_, "e" # (debug_show i), e) ];
            switch (e.outline) {
              case null { };
              case (?sub) { objs #= go(sub, drop + step.y) };
            };
            i += 1
          };
          objs
        };
      }
    };
    go(outline, 0.0)
  };

  public func sceneObjectsFromList(outline, position, offsets) : A.Scene.SceneObjects {
    func sceneObjectsFromList_(outline, position) : A.Scene.SceneObjects {
      switch (outline) {
        case (#leaf(n)) { assert false };
        case (#internal(n)) {
          let label_ = (debug_show ((n.__nodeId.0).0));
          switch (n.edges.size()) {
            case 1 { 
              //
              // various base cases land here.
              // use position for the orb object.
              //
              [#orb { label_; position; textFields = ""; pointerFields = ["get"]}] #
              [objectFromEdge(label_, "get", n.edges[0])]
            };
            case 5 { 
              let position = @ ((`position)(n.edges[3].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.binary);
              let positionL = A.Scene.vec3Add(position, offsets.leafL);
              let positionR = A.Scene.vec3Add(position, offsets.leafR);
      
              // most common (binary) recursive case lands here.
              // use position of the target of n.edges[3] for orb object.
              // re-set position for each sub-case using logic like in original binary tree layout.
              [#orb { label_; position; textFields = ""; pointerFields = [
                "get", "putE", "rec1", "putB", "rec2"
              ]}] #
              [ 
                objectFromEdge(label_, "get", n.edges[0]),
                objectFromEdge(label_, "putE", n.edges[1]),
                objectFromEdge(label_, "rec1", n.edges[2]),
              ] #
              sceneObjectsFromList_(n.edges[2].outline!, positionL)
              # [ 
                objectFromEdge(label_, "putB", n.edges[3]),
                objectFromEdge(label_, "rec2", n.edges[4])
              ] #
              sceneObjectsFromList_(n.edges[4].outline!, positionR)
            };
            case 7 { 
              let position = @ ((`position)(n.edges[1].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.binary);
              let positionL = A.Scene.vec3Add(position, offsets.leafL);
              let positionR = A.Scene.vec3Add(position, offsets.leafR);
              
              // special case for the top of the recursion.
              // similar to case 5 except for extra two initial steps: 
              //  - intialize a local copy of the empty input/output list,
              //  - and put the first list element into an initial leaf-element tree. 
              [#orb { label_; position; textFields = ""; pointerFields = [
                "putN", "putE1", "get", "putE2", "rec1", "putB", "rec2"
              ]}] #
              [ 
                objectFromEdge(label_, "putN", n.edges[0]),
                objectFromEdge(label_, "putE1", n.edges[1]),
                objectFromEdge(label_, "get", n.edges[2]),
                objectFromEdge(label_, "putE2", n.edges[3]),
                objectFromEdge(label_, "rec1", n.edges[4]),
              ] #
              sceneObjectsFromList_(n.edges[4].outline!, positionL)
              # [
                objectFromEdge(label_, "putB", n.edges[5]),
                objectFromEdge(label_, "rec2", n.edges[6])
              ] #
              sceneObjectsFromList_(n.edges[6].outline!, positionR)
            };
            case _ { 
              assert false
            };
          };
        };
      }
    };
    sceneObjectsFromList_(outline, position)
  };
  

  /// A tree built from a list, and both ways of looking at it.
  ///
  /// Derived from `testSceneObjectsFromList`, which already computed exactly
  /// this and then discarded it. Two layouts are concatenated: `sceneObjects`
  /// places the tree, and `sceneObjectsFromList` places the list it was built
  /// from, displaced by real offsets so the two do not sit on top of one
  /// another. The outline is the force tree that built it.
  /// The same as `exampleTreeFromList`, over symbols that carry entropy.
  ///
  /// One call different, for the reason given on
  /// `exampleLevelTreeRandomSymbols`.
  #[example]
  public func exampleTreeFromListRandomSymbols() : W.ExampleOutput {
    let array = R.generateRandomInputSymbols(10, 10);
    let buildList = `buildList := thunk { List.fromIter(array.vals()) };
    let list = force buildList;
    let buildTree = `buildTree := thunk { fromList(list); };
    let tree = force buildTree;
    A.scratch(thunk {
      let outline = A.Outline.outline(buildTree);
      let offsets = {
        binary = { x = 0.0; y = 0.0; z = 5.0};
        leafL  = { x = -0.5; y = -0.25; z = 1.0};
        leafR  = { x =  0.5; y = -0.25; z = 1.0};
      };
      W.scene(
        sceneObjects(tree!, A.Scene.zero) # sceneObjectsFromList(outline, A.Scene.zero, offsets),
        [ outline ]
      )
    })
  };

  #[example]
  public func exampleTreeFromList() : W.ExampleOutput {
    let array = R.generateRandomInput(10, 10);
    let buildList = `buildList := thunk { List.fromIter(array.vals()) };
    let list = force buildList;
    let buildTree = `buildTree := thunk { fromList(list); };
    let tree = force buildTree;
    A.scratch(thunk {
      let outline = A.Outline.outline(buildTree);
      let offsets = {
        binary = { x = 0.0; y = 0.0; z = 5.0};
        leafL  = { x = -0.5; y = -0.25; z = 1.0};
        leafR  = { x =  0.5; y = -0.25; z = 1.0};
      };
      W.scene(
        sceneObjects(tree!, A.Scene.zero) # sceneObjectsFromList(outline, A.Scene.zero, offsets),
        [ outline ]
      )
    })
  };

  #[test]
  public func testSceneObjectsFromList() {
    let array = R.generateRandomInput(10, 10);
    let buildList = `buildList := thunk { List.fromIter(array.vals()) };
    let list = force buildList;
    let buildTree = `buildTree := thunk { fromList(list); };
    let tree = force buildTree;
    let outline = A.Outline.outline(buildTree);
    let sceneObjects1 = sceneObjects(tree!, A.Scene.zero);
    let offsets = {
          binary = { x = 0.0; y = 0.0; z = 5.0};
          leafL = { x = -0.5; y = -0.25; z = 1.0};
          leafR = { x =  0.5; y = -0.25; z = 1.0};
    };
    let sceneObjects2 = sceneObjectsFromList(outline, A.Scene.zero, offsets);
    let sceneObjects = sceneObjects1 # sceneObjects2;
    let _ = A.IntoJSON.fromObjects(sceneObjects);
    { array; sceneObjects }
  };

  #[listing(88)]
  public func sceneObjectsLazyMergeSort_(outline, position, offsets) {
   func rec_(outline, position) : A.Scene.SceneObjects {
      switch (outline) {
        case (#leaf(n)) { assert false };
        case (#internal(n)) {
          let label_ = (debug_show ((n.__nodeId.0).0));        
          switch (n.edges.size()) {
            // the setup for the recursion creates a nil output element,
            // and then recurs according to reduce(tree, nil, singleton, merge)
            case 2 { 
              assert false;
              // TODO -- use this case in our tests.

              let position = @(`position(n.edges[1].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.reduce);
              [#orb { label_; position; textFields = ""; pointerFields = [
                "putNil", "reduceRoot"
                ]}] #
              [ 
                objectFromEdge(label_, "putNil", n.edges[0]),
                objectFromEdge(label_, "reduceRoot", n.edges[1]),
              ] #
              rec_(n.edges[1].outline!, position)
            };
            case 4 {
              let position = @(`position(n.edges[0].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.reduce);
              let positionM = A.Scene.vec3Add(position, offsets.merge);
              [
                #orb { label_; position; textFields = ""; pointerFields = [
                "getBinary", "recL", "recR", "putMerge"
                ]},
                objectFromEdge(label_, "getBinary", n.edges[0]),
                objectFromEdge(label_, "recL", n.edges[1]),
              ] #
              rec_(n.edges[1].outline!, position) #
              [
                objectFromEdge(label_, "recR", n.edges[2])
              ] #
              rec_(n.edges[2].outline!, position) #
              [
                objectFromEdge(label_, "putMerge", n.edges[3])
              ] #
              LazyList.sceneObjectsMergeSortStream(n.edges[3].actionTarget,
                  positionM, offsets.merge)
            }; 
            case 1 {
              let position = @(`position(n.edges[0].actionTarget));
              let position = A.Scene.vec3Add(position, offsets.reduce);
              [
                #orb { label_; position; textFields = ""; pointerFields = [
                "getElement",
                ]},
                objectFromEdge(label_, "getElement", n.edges[0]),
              ]
            };
            case arity {
              Prim.print arity; 
              assert false
            };
          };
        };
      }
    };
    rec_(outline, position)
  };

  #[listing]
  public func sceneObjects<X>(tree : Pointer<SeqTree<X>>, origin : Vec3) : SceneObjects {
    let g = geom2d(tree);
    let label_ : Text = (debug_show tree);
    let position : Vec3 = {y = origin.y + g.height * 1.618; x = origin.x; z = origin.z};
    `position(tree) := position;
    var objs : SceneObjects = [];
    let (textFields : Text, pointerFields : Text) = 
      switch (@ tree) {
        case (#empty) { ("#empty", []) };
        case (#element(e)) { (
          "#element\n\tsymbol="#(debug_show e.symbol)#"\n\telement="#(debug_show e.element), []) 
        };
        case (#binary(b)) { 
          objs #= [
            #pointer ( {from=label_# ":left"; to=(debug_show b.left)}),
            #pointer ( {from=label_# ":right"; to=(debug_show b.right)})
          ];
          assert (g.width == (g.widthLeft + g.widthRight));
          objs #= sceneObjects(b.left, {x=origin.x - (g.widthRight * 0.5); y=origin.y; z=origin.z});
          objs #= sceneObjects(b.right, {x=origin.x + (g.widthLeft * 0.5); y=origin.y; z=origin.z});
          ("#binary\n\tsymbol=" # (debug_show b.symbol) # "\n\tlevel=" # (debug_show b.level),
           ["left", "right"]) 
        };
      };
    [#box({label_; position; textFields; pointerFields })] # objs
  };

  #[test]
  public func testSceneObjects() {
    let a = R.generateRandomInput(10, 10);
    let t = fromArray(a);
    let objs = sceneObjects(t!, A.Scene.zero);
    assert (objs.size() == 37);
    let last = objs[36];
    switch last {
      case (#box(b)) {
        assert b.label_ == "10-element";
        assert (b.position == {x=4.5;y=1.618;z=0.0});
        assert (b.textFields == "#element\n\tsymbol=10\n\telement=545");
      };
      case _ { assert false };
    }
   };

  #[listing]
  public func geom2d<X>(tree : Pointer<SeqTree<X>>) : Geom2D {
    let oneUnit = { height=1; width=1; widthLeft=0.5; widthRight=0.5};
    force(`geom2d(tree) := thunk { switch (@ tree) {
      case (#empty) { oneUnit };
      case (#element(e)) { oneUnit };
      case (#binary(b)) {
        let ml = geom2d(b.left);
        let mr = geom2d(b.right);
        { 
          height = max(ml.height, mr.height) + 1; 
          widthLeft = ml.width;
          widthRight = mr.width;
          width = ml.width + mr.width;
        }
      };
    }})
  };

  /// The same tree, over symbols that carry entropy.
  ///
  ///    A duplicate of `exampleLevelTree` differing in one call:
  /// `generateRandomInputSymbols` rather than `generateRandomInput`. Its
  /// symbols are `sym-1-482710`, `sym-2-1826057930`, ... rather than 1, 2,
  /// ..., so the levels -- and therefore the shape -- depend on the seed.
  /// Change the first argument and the tree changes; with the other
  /// generator it does not, whatever the seed (#72).
  ///
  ///    Kept beside the original rather than replacing it: the existing
  /// examples and tests assert on values built from positional symbols.
  #[example]
  public func exampleLevelTreeRandomSymbols() : W.ExampleOutput {
    let array = R.generateRandomInputSymbols(10, 10);
    let buildTree = `buildTree := thunk { fromArray(array) };
    let tree = force buildTree;
    A.scratch(thunk {
      W.scene(
        Scene.sceneObjects(tree!, A.Scene.zero),
        [ A.Outline.outline(buildTree) ]
      )
    })
  };

  /// A level tree, and the program's own account of how to look at it.
  ///
  /// Two phases, and the difference between them is the point. Building the
  /// tree is the subject: it runs in the session and the graph records it.
  /// Laying it out is the portrayal: it runs in a scratch, so the graph
  /// records none of it, and the history the runtime hands over afterwards is
  /// of the tree rather than of the drawing of the tree.
  #[example]
  public func exampleLevelTree() : W.ExampleOutput {
    let array = R.generateRandomInput(10, 10);
    let buildTree = `buildTree := thunk { fromArray(array) };
    let tree = force buildTree;
    A.scratch(thunk {
      W.scene(
        Scene.sceneObjects(tree!, A.Scene.zero),
        [ A.Outline.outline(buildTree) ]
      )
    })
  };

  /// One run of list-into-tree, as its own scene.
  ///
  /// Reset first, so the history belongs to this run alone --- a pair of
  /// these is only comparable if neither carries the other's events. The
  /// layout runs in a scratch, so what the runtime hands over is the history
  /// of building the tree and not of drawing it.
  ///
  /// `remove` names a cell to drop from the list before the tree is built.
  /// `null` is the unedited run. The head cannot be named: the cursor starts
  /// one cell in, which is issue #77.
  public func treeFromListRun(seed : Nat, size : Nat, remove : ?Symbol) : A.Scene.Scene {
    A.reset();
    let array = R.generateRandomInput(seed, size);
    let list_ = `ListFromArray := thunk {
      do within space `inputList { List.fromIter(array.vals()) }
    };
    let list = force list_;
    do ? {
      let editor = List.Edit.cursor(list!.next);
      let editor = List.Edit.gotoSymbol(editor, remove!)!;
      List.Edit.remove(editor);
    };
    let tree_ = `LevelTreeFromList := thunk {
      do within space `inputTree { fromList(list) }
    };
    let tree = force tree_;
    W.withHistory(A.scratch(thunk {
      W.scene(Scene.sceneObjects(tree!, A.Scene.zero),
              [ A.Outline.outline(tree_) ])
    }))
  };

  /// One run of list-into-tree, keeping only the node map the diff needs.
  ///
  /// No objects and no outline: a scaling study wants histories, and laying
  /// out a thousand elements costs more than building the tree does. Same
  /// reset-run-peek shape as `treeFromListRun` otherwise.
  public func treeNodesRun(seed : Nat, size : Nat, remove : ?Symbol) : A.Diff.NodeVals {
    A.reset();
    let array = R.generateRandomInput(seed, size);
    let list_ = `ListFromArray := thunk {
      do within space `inputList { List.fromIter(array.vals()) }
    };
    let list = force list_;
    do ? {
      let editor = List.Edit.cursor(list!.next);
      let editor = List.Edit.gotoSymbol(editor, remove!)!;
      List.Edit.remove(editor);
    };
    let tree_ = `LevelTreeFromList := thunk {
      do within space `inputTree { fromList(list) }
    };
    let _ = force tree_;
    A.Diff.nodeValsFromNodes(A.peekHistory().nodes)
  };

  /// Random samples: a fresh input seed and a fresh removal position each.
  ///
  ///    Both drawn from the seeded generator rather than swept, so no
  ///    structure of the sampling grid can be mistaken for structure in the
  ///    answer. Each sample builds its own unedited run, since its input
  ///    differs from every other sample's.
  ///
  /// Positions fall in `2 .. size`; the head is not addressable (#77).
  public func treeRepairRandom(sampleSeed : Nat, size : Nat, samples : Nat) : Text {
    let seeds = R.generateRandomInput(sampleSeed, samples);
    let posns = R.generateRandomInput(sampleSeed + 7919, samples);
    var out = "";
    var i = 0;
    while (i < samples) {
      let (_, sd) = seeds[i];
      let (_, pr) = posns[i];
      let pos = 2 + (pr % (size - 1));
      let left = treeNodesRun(sd, size, null);
      let right = treeNodesRun(sd, size, ?pos);
      let d = A.Diff.nodeValsDiff(left, right);
      out #= (debug_show sd) # "," # (debug_show size) # "," # (debug_show pos) # ","
           # (debug_show (d.left.size())) # "," # (debug_show (d.right.size())) # ","
           # (debug_show (d.onlyLeft.size())) # "," # (debug_show (d.onlyRight.size())) # ","
           # (debug_show (d.equal.size())) # "," # (debug_show (d.notEqual.size())) # ";";
      i += 1
    };
    out
  };

  /// Sweep removal positions and report the four numbers for each.
  ///
  ///    The unedited run is built once and compared against each edited run,
  /// because its history is a value: `A.reset()` inside a later run cannot
  /// disturb a node map already taken.
  ///
  /// Positions run from 2 by `step`; the head is not addressable (#77).
  public func treeRepairSweep(seed : Nat, size : Nat, step : Nat) : Text {
    let left = treeNodesRun(seed, size, null);
    var out = "";
    var r = 2;
    while (r <= size) {
      let right = treeNodesRun(seed, size, ?r);
      let d = A.Diff.nodeValsDiff(left, right);
      out #= (debug_show seed) # "," # (debug_show size) # "," # (debug_show r) # ","
           # (debug_show (d.left.size())) # "," # (debug_show (d.right.size())) # ","
           # (debug_show (d.onlyLeft.size())) # "," # (debug_show (d.onlyRight.size())) # ","
           # (debug_show (d.equal.size())) # "," # (debug_show (d.notEqual.size())) # ";";
      r += step
    };
    out
  };

  /// One run of tree-into-list: the merge network, and what it produces.
  ///
  ///    The middle of three. `treeFromListRun` builds a tree and stops, and
  /// mergeSort's own pair does the whole algorithm at once; this does the
  /// half that turns a tree into a sorted list, and portrays that half
  /// alone. Small enough to read, and it is the half that is not stable.
  ///
  /// The list and the tree are still built -- the merge has to have
  /// something to merge -- but only the merge network is drawn.
  public func mergeFromTreeRun(seed : Nat, size : Nat, remove : ?Symbol) : A.Scene.Scene {
    mergeFromTreeRunWith(seed, size, remove, #inductive)
  };

  /// The same run, with the merge network's naming named.
  ///
  ///    The strategy has to be written here rather than by the caller: every
  /// run opens with `A.reset()`, which takes the cell with it, so a flag set
  /// outside would be gone by the time the merge asks for it.
  public func mergeFromTreeRunWith(seed : Nat, size : Nat, remove : ?Symbol,
                                   strategy : {#inductive; #cartesian; #pathwise})
    : A.Scene.Scene {
    A.reset();
    let _ = `lazyMergeSort(`strategy) := strategy;
    let array = R.generateRandomInput(seed, size);
    let list_ = `ListFromArray := thunk {
      do within space `inputList { List.fromIter(array.vals()) }
    };
    let list = force list_;
    do ? {
      let editor = List.Edit.cursor(list!.next);
      let editor = List.Edit.gotoSymbol(editor, remove!)!;
      List.Edit.remove(editor);
    };
    let tree_ = `LevelTreeFromList := thunk {
      do within space `inputTree { fromList(list) }
    };
    let tree = force tree_;
    let sorted_ = do within space `mergeSort { lazyMergeSort_(tree) };
    // Demanded, or the network is a promise rather than a graph.
    let _ = LazyList.takeN_(sorted_, size);
    W.withHistory(A.scratch(thunk {
      // The tree is laid out first, and not only because it belongs in the
      // picture: the merge network is placed relative to the tree nodes its
      // streams come from, and reads the `position` cells that laying the
      // tree out writes. Without it the network has nowhere to stand and
      // asks for a pointer that was never made.
      let treeObjects = Scene.sceneObjects(tree!, A.Scene.zero);
      let geom = Scene.geom2d(tree!);
      let levelGap = 2.0;
      let mergeObjects = Scene.sceneObjectsLazyMergeSort_(
        A.Outline.outline(sorted_),
        { x = 0.0; y = 1.618 * geom.height; z = -levelGap / 2.0 },
        { reduce = { x = 0.0; y = 1.0; z = -levelGap / 2.0 };
          merge = { x = 0.0; y = 0.0; z = -1.0 } });
      W.scene(treeObjects # mergeObjects, [ A.Outline.outline(sorted_) ])
    }))
  };

  /// The merge network, before and after one cell is removed.
  ///
  ///    The middle rung of the three, and the one that carries the argument.
  /// A tree glides almost intact under an edit; the whole of mergeSort is
  /// too much to take in at once; this is the part that misbehaves, on its
  /// own and at a size that can be looked at.
  ///
  ///    A merge thunk is named for the input-tree node whose stream it is
  /// built from, so a symbol's reach is however many streams descend from
  /// its node -- unbounded, and largest at the root. Remove the cell whose
  /// symbol happens to root the tree and the network is rebuilt around it.
  /// Naming each merge by the pair of cells it compared should bound that to
  /// O(log n), which is the change this example exists to be measured
  /// against.
  #[examplePair]
  public func examplePairMergeFromTree() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 3;
    W.pair(mergeFromTreeRun(seed, size, null),
           mergeFromTreeRun(seed, size, ?removed))
  };

  /// Where an edit lands, for the removal pairs below.
  ///
  ///    A treap puts a symbol at a height drawn from its own hash, so which
  /// element you remove decides how much of the tree is rebuilt -- far more
  /// than the naming strategy decides. Removing the highest node in the input
  /// disturbs the shape everywhere; removing the lowest disturbs almost
  /// nothing. Comparing strategies without holding that fixed compares the
  /// draw, not the strategy.
  ///
  ///    For seed 10 and size 16 these are the extremes of `Prim.symbolLevel`
  /// over the addressable positions: cell 3 is the highest at 1581569 and
  /// cell 10 the lowest at 4. Every pair of a kind writes the same one, so
  /// the only difference between a pair and its twin is the naming.
  ///
  ///    Written out in each one rather than shared between them. A body opened
  /// from the library is lifted out of this module and stands alone, so a name
  /// defined out here is not in scope there -- and the whole point of opening
  /// a body is to edit the numbers in it.

  /// The same merge network named two ways, on the same unedited input.
  ///
  ///    The vertical comparison, and the one to read first. Nothing about the
  /// computation differs -- the same comparisons happen in the same order and
  /// the graph is isomorphic -- so the objects sit one on top of the other in
  /// space and every node that disagrees disagrees only because it was named
  /// differently. The list and the tree are outside what the strategy reaches
  /// and come out equal, which is what draws the boundary.
  #[examplePair]
  public func examplePairInductiveVsCartesian() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    W.pair(mergeFromTreeRunWith(seed, size, null, #inductive),
           mergeFromTreeRunWith(seed, size, null, #cartesian))
  };

  /// The same network, named inductively and named by path.
  ///
  ///    The second of the three vertical comparisons. Both of these name a
  /// merge cell for the element that won, so what differs is only what the
  /// space is keyed by -- a tree node's symbol against an address. Expect the
  /// same one-for-one symmetry, and expect it to be larger than the
  /// inductive-against-cartesian one: `reducePathwise` keys the reduction
  /// spine by path as well, so `recLeft` and `recRight` are renamed here
  /// where they were shared there.
  #[examplePair]
  public func examplePairInductiveVsPathwise() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    W.pair(mergeFromTreeRunWith(seed, size, null, #inductive),
           mergeFromTreeRunWith(seed, size, null, #pathwise))
  };

  /// The same network, named by pair compared and named by path.
  ///
  ///    The third, and the one where the two namings have least in common:
  /// one is derived entirely from the data being merged and the other not at
  /// all. The computation is still the same, and the objects still sit one on
  /// top of the other, which is the point of drawing it.
  #[examplePair]
  public func examplePairCartesianVsPathwise() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    W.pair(mergeFromTreeRunWith(seed, size, null, #cartesian),
           mergeFromTreeRunWith(seed, size, null, #pathwise))
  };

  /// One removal at the highest node, named inductively.
  #[examplePair]
  public func examplePairInductiveRootRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 3;
    W.pair(mergeFromTreeRunWith(seed, size, null, #inductive),
           mergeFromTreeRunWith(seed, size, ?removed, #inductive))
  };

  /// The same removal at the highest node, named by the pair compared.
  ///
  ///    Read beside `examplePairInductiveRootRemoval`. What moves is the kind
  /// of disagreement, not only the amount of it: cells leave `onlyLeft` and
  /// `onlyRight` and arrive in `notEqual`. Fewer cells with no counterpart in
  /// the other run, more cells that have one and hold something else.
  ///
  ///    That is the distinction repair cares about. A cell in `notEqual` is
  /// known to both runs, so it can be dirtied and recomputed where it stands.
  /// A cell in `onlyLeft` has nothing to correspond to, so there is nothing to
  /// repair: it and everything built on it begin again.
  #[examplePair]
  public func examplePairCartesianRootRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 3;
    W.pair(mergeFromTreeRunWith(seed, size, null, #cartesian),
           mergeFromTreeRunWith(seed, size, ?removed, #cartesian))
  };

  /// One removal at the lowest node, named inductively.
  ///
  ///    The control for the two above. A leaf removal is cheap under either
  /// naming, and the two strategies have almost nothing to distinguish them
  /// here -- which is the point of drawing it: the strategy only matters
  /// where the tree moves.
  #[examplePair]
  public func examplePairInductiveLeafRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 10;
    W.pair(mergeFromTreeRunWith(seed, size, null, #inductive),
           mergeFromTreeRunWith(seed, size, ?removed, #inductive))
  };

  /// The same removal at the lowest node, named by the pair compared.
  #[examplePair]
  public func examplePairCartesianLeafRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 10;
    W.pair(mergeFromTreeRunWith(seed, size, null, #cartesian),
           mergeFromTreeRunWith(seed, size, ?removed, #cartesian))
  };

  /// One removal at the highest node, named by where the merge sits.
  ///
  ///    The third naming, and the only one whose names say nothing about the
  /// data. A merge cell is `mergeSort(merge-`0(R))(4)`: the space is the path
  /// taken to reach this node of the reduction, and the cell within it is
  /// still the element that won, exactly as under `#inductive`. So this is
  /// `#inductive` with the one substitution that matters -- an address where
  /// the tree node's own symbol used to be.
  ///
  ///    This is the pair that shows what that costs, and it is the opposite
  /// of what the idea promises at first hearing. An address is stable only
  /// while the shape it addresses is stable, and removing the highest node in
  /// the input reshapes the tree from there down -- so nearly every path
  /// below it changes and nearly every cell is renamed. Measured at 77 and 62
  /// cells with no counterpart, against inductive's 20 and 5. Where
  /// `#cartesian` caps inductive's worst case, this multiplies it.
  ///
  ///    Read it with the leaf pair, which comes out identical to the other
  /// two to the number. Pathwise is exactly as stable as the tree's shape and
  /// no more, which is what makes it a useful instrument even though it is a
  /// poor way to name a graph you mean to repair: it holds the data fixed and
  /// varies only the shape's influence.
  #[examplePair]
  public func examplePairPathwiseRootRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 3;
    W.pair(mergeFromTreeRunWith(seed, size, null, #pathwise),
           mergeFromTreeRunWith(seed, size, ?removed, #pathwise))
  };

  /// The same removal at the lowest node, named by where the merge sits.
  ///
  ///    The third row of the control. Read across all three leaf pairs: if a
  /// naming makes a difference here, where the tree barely moves, it is
  /// making it for a reason other than the edit.
  #[examplePair]
  public func examplePairPathwiseLeafRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 10;
    W.pair(mergeFromTreeRunWith(seed, size, null, #pathwise),
           mergeFromTreeRunWith(seed, size, ?removed, #pathwise))
  };

  /// One run of the eager sort: the tree it was given, and the tree it made.
  ///
  ///    The counterpart of `mergeFromTreeRun`, and the reason to have it is
  /// the comparison. That one draws a network of merge streams, which is a
  /// promise of a sorted sequence; this draws two level trees, the input and
  /// the sorted output, because the eager sort answers in the representation
  /// it was given. So the same edit can be priced against two ways of
  /// spending it.
  ///
  ///    Both trees are drawn, the sorted one above the input, so the picture
  /// shows what the sort did and not only what it produced.
  public func eagerMergeRun(seed : Nat, size : Nat, remove : ?Symbol) : A.Scene.Scene {
    A.reset();
    let array = R.generateRandomInput(seed, size);
    let list_ = `ListFromArray := thunk {
      do within space `inputList { List.fromIter(array.vals()) }
    };
    let list = force list_;
    do ? {
      let editor = List.Edit.cursor(list!.next);
      let editor = List.Edit.gotoSymbol(editor, remove!)!;
      List.Edit.remove(editor);
    };
    let tree_ = `LevelTreeFromList := thunk {
      do within space `inputTree { fromList(list) }
    };
    let tree = force tree_;
    let sorted_ = `EagerSorted := thunk {
      do within space `eagerMergeSort { eagerMergeSort(tree) }
    };
    let sorted = force sorted_;
    W.withHistory(A.scratch(thunk {
      let outline = A.Outline.outline(sorted_);
      let treeObjects = Scene.sceneObjects(tree!, A.Scene.zero);
      let geom = Scene.geom2d(tree!);
      let above = { x = 0.0; y = 1.618 * geom.height; z = 0.0 };
      let sortedObjects = switch sorted {
        case null [];
        case (?s) Scene.sceneObjects(s, above);
      };
      // The work itself, above the two structures it went between. Without
      // this the pair reports a cost it does not show: the cells that differ
      // between two runs are mostly `split` and `append`, and neither tree
      // contains them.
      let network = Scene.sceneObjectsOfOutline(
        outline,
        { x = 0.0 - geom.width; y = 3.2 * geom.height; z = 0.0 },
        { x = 0.9; y = 1.3; z = 0.0 });
      W.scene(treeObjects # sortedObjects # network, [ outline ])
    }))
  };

  /// One removal at the highest node, sorted eagerly.
  ///
  ///    Read against `examplePairInductiveRootRemoval`, which prices the same
  /// removal through the lazy merge network. Same input, same removal, same
  /// naming discipline -- the reduction node's own symbol -- and a different
  /// way of spending the work, so what differs is the strategy of the sort
  /// rather than anything about the edit.
  #[examplePair]
  public func examplePairEagerRootRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 3;
    W.pair(eagerMergeRun(seed, size, null),
           eagerMergeRun(seed, size, ?removed))
  };

  /// One removal at the lowest node, sorted eagerly.
  ///
  ///    The control, as for the other kinds: an edit that barely moves the
  /// input tree. Whether it barely moves the *sorted* tree is a separate
  /// question, and one this pair exists to answer -- the sorted sequence is a
  /// permutation, so a removal near the input's leaves need not be near the
  /// output's.
  #[examplePair]
  public func examplePairEagerLeafRemoval() : W.ExamplePairOutput {
    let seed = 10;
    let size = 16;
    let removed = 10;
    W.pair(eagerMergeRun(seed, size, null),
           eagerMergeRun(seed, size, ?removed))
  };

  /// The same list built into a tree twice, differing by one removed cell.
  ///
  ///    What a repair would cost, if repair were implemented. Neither run
  /// reuses anything from the other --- there is no repair algorithm yet, and
  /// that is deliberate while the specification is still being written. What
  /// the pair gives instead is the shape of the answer a repair would have to
  /// produce: which named nodes both runs agree on, which they disagree on,
  /// and which exist in only one of them.
  ///
  ///    Cell 7 is removed rather than any other, because this is a picture
  /// before it is a measurement: the edit lands in the middle of the tree,
  /// where what a repair would have to do is legible, rather than at its root
  /// where it swamps the frame.
  ///
  ///    That makes it a typical case and not the worst one, which is a
  /// deliberate change of subject. Cell 3 has the highest level of the first
  /// several hundred symbols, so it roots every tree over positional symbols;
  /// removing it changed 27% of the tree's nodes over twelve seeds at size 16
  /// where a typical position changed 11-16% (#72). Here cell 7 changes 13 of
  /// 80 nodes and cell 3 changed 20 --- the extreme is the paper's subject
  /// ("Removing cell 3 rebuilds 69.5% of the merge network"), and the panel's
  /// job is to show the ordinary shape of a repair clearly.
  ///
  ///    Kept ASCII deliberately. A non-ASCII character anywhere in a module's
  /// source silently hides every attribute after it from the web-play
  /// listing: the lexer reports byte offsets and the page slices with
  /// `substr`, which counts UTF-16 units, so the spans drift apart. A section
  /// sign here was enough to make this very function disappear from the page.
  #[examplePair]
  public func examplePairTreeAfterRemoval() : W.ExamplePairOutput {
    // Bound rather than repeated, so the body can be edited in one place.
    // Opening an example puts this text in the editor, and `size` written
    // twice is a size that gets changed once and then disagrees with itself.
    let seed = 10;
    let size = 16;
    // Cell 7 rather than 3 (#81): the edit lands in the middle of the tree,
    // where it can be watched, instead of at the root where it moves
    // everything at once. The root case is the mergeSort pair's subject.
    let removed = 7;
    W.pair(treeFromListRun(seed, size, null),
           treeFromListRun(seed, size, ?removed))
  };

  #[test]
  public func testGeom2d<X>(tree : Pointer<SeqTree<X>>) : Geom2D {
    let a = R.generateRandomInput(10, 10);
    let t = fromArray(a);
    let g = geom2d(t!);
    // These are a function of `prim "symbolLevel"`, which hashes a symbol.
    // They changed when that hash was made independent of the target's
    // pointer width, and they are now the same on every target -- which is
    // the point: before, this tree was 6/10/8/2 natively and 6/10/4/6 under
    // wasm32, from the same input.
    assert (g == 
      { height = 8;
        width = 10;
        widthLeft = 2;
        widthRight = 8 });
  };

  }; 

  public module Tests {

    #[test]
    func testFromIntoArray() {
      assert intoArray(fromArray([])) == [];
      assert intoArray(fromArray([(0,0)])) == [(0,0)];
      assert intoArray(fromArray([(0,0), (1,1)])) == [(0,0), (1,1)];
      let input = R.generateRandomInput(10, 10);
      let tree = fromArray(input);
      assert intoArray(tree) == input
    };

    #[test]
    func testSize() {
      let input = R.generateRandomInput(10, 10);
      let tree = fromArray(input);
      assert Index.size(tree) == 10;
    };

  }

};
