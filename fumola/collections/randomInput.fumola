module {
   public let defaultSeed = 10;

    //
    // sometimes we need two or more inputs with distinct sets of symbols,
    // and (mostly) distinct elements, in expectation.
    //
    public func generateRandomInput_(seed : Nat, startIndex : Nat, size : Nat) : [(Nat, Nat)] {
        let iter = prim "fastRandIterNew" (?size, seed + startIndex);
        var count = 0;
        var result = [];
        let maxValue = (size + startIndex) * 137; // encourage non-unique elements for large sizes.
        for (x in iter) {
            count += 1;
            result #= [(count + startIndex, x % maxValue)]
        };
        result
    };

    //
    // The same inputs, with symbols that carry entropy.
    //
    //    `generateRandomInput` numbers its symbols by position -- 1, 2, 3 --
    // so a structure keyed on them has one shape whatever the seed is. A
    // level tree over 1..n is the case in point: its levels are a function of
    // its keys, its keys are positions, and so every such tree in this
    // library came out the same, and degenerate (issue #72).
    //
    //    These symbols carry a random part beside the position --
    // `sym-1-482710`, `sym-2-1826057930` -- taken from the same seeded
    // generator as the elements, but from the raw word rather than the
    // reduced one. The position keeps them ordered and tells you where each
    // came from; the random part gives the seed something to affect.
    //
    //    Added rather than substituted: `generateRandomInput` is what the
    // existing tests and their asserted values are built on.
    //

    public func generateRandomInputSymbols_(seed : Nat, startIndex : Nat, size : Nat) : [(Symbol, Nat)] {
        let iter = prim "fastRandIterNew" (?size, seed + startIndex);
        var count = 0;
        var result = [];
        let maxValue = (size + startIndex) * 137;
        for (x in iter) {
            count += 1;
            let index = count + startIndex;
            let element = x % maxValue;
            // The symbol takes the raw word, not `element`. The `* 137`
            // above exists to make elements collide, so `element` is capped at
            // `maxValue` -- and a symbol's level is a function of its
            // rendering, so spending a capped value on the symbol caps the
            // level too. Measured at size 20 over 1500 seeds: reusing
            // `element` reaches exactly 2740 distinct suffixes, which is
            // `20 * 137`, about eleven bits, and each position draws from that
            // one small pool for every seed. The raw word reaches 29999 of
            // 30000, about thirty-one bits.
            result #= [(`sym-index-x, element)]
        };
        result
    };

    public func generateRandomInputSymbols(seed : Nat, size : Nat) : [(Symbol, Nat)] {
        generateRandomInputSymbols_(seed, 0, size)
    };

    //
    // Simple case where there's just one input to consider.
    //
    public func generateRandomInput(seed : Nat, size : Nat) : [(Nat, Nat)] {
        generateRandomInput_(seed, 0, size)
    };

    #[test]
    func testGenInput() {
        let i = generateRandomInput(10, 10);
        assert i == [
            (1, 470), (2, 0), (3, 1192), (4, 55),
            (5, 195), (6, 1191), (7, 777),
            (8, 581), (9, 1306), (10, 545)
        ];
    };

}